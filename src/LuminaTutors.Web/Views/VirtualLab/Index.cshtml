@using LuminaTutors.Application.DTOs.Lab
@model List<LabSessionDto>

@*
    Pre-fetch Three.js + OrbitControls while the user is browsing the lab list.
    By the time they click "Vào phòng" the modules are already in the browser's
    module cache, so Lab.cshtml loads in ~1 s instead of 5–8 s.
*@
@section Styles {
    @* Warm the browser module cache while the user reads the lab list *@
    <link rel="modulepreload" href="/js/three/three.module.js">
    <link rel="modulepreload" href="/js/three/controls/OrbitControls.js">
}
@{
    ViewData["Title"] = "Phòng Lab 3D";
    var isTeacher     = ViewBag.IsTeacher as bool? ?? false;
    var currentUserId = ViewBag.CurrentUserId as int? ?? 0;

    string SubjectLabel(string tag) => tag switch
    {
        "chemistry" => "Hóa học",
        "physics"   => "Vật lý",
        "biology"   => "Sinh học",
        "math"      => "Toán học",
        _           => tag
    };
    string SubjectIcon(string tag) => tag switch
    {
        "chemistry" => "bi-droplet-fill",
        "physics"   => "bi-gear-fill",
        "biology"   => "bi-activity",
        "math"      => "bi-grid-3x3-gap-fill",
        _           => "bi-flask"
    };
    string SubjectColor(string tag) => tag switch
    {
        "chemistry" => "var(--lt-success)",
        "physics"   => "var(--lt-navy)",
        "biology"   => "var(--lt-gold)",
        "math"      => "#8b5cf6",
        _           => "var(--lt-navy)"
    };
    string SceneLabel(string scene) => scene switch
    {
        // Chemistry
        "titration"    => "Chuẩn độ axit-bazơ",
        "electrolysis" => "Điện phân nước",
        "distillation" => "Chưng cất đơn giản",
        // Physics
        "pendulum"     => "Con lắc đơn",
        "spring"       => "Con lắc lò xo",
        "optics"       => "Quang học — khúc xạ ánh sáng",
        // Biology
        "cell"         => "Quan sát tế bào",
        "dna"          => "Cấu trúc DNA",
        "photosynthesis" => "Quang hợp",
        // Math
        "polyhedron"   => "Khám phá đa diện đều",
        "vectors"      => "Vector 3D & tích có hướng",
        _              => scene
    };
}

<div class="lt-page-header">
    <div>
        <h1 class="lt-page-title">
            <i class="bi bi-badge-vr-fill" style="color:var(--lt-gold);margin-right:8px"></i>
            Phòng Lab 3D ảo
        </h1>
        <p class="lt-page-subtitle">Thực hành thí nghiệm khoa học trong môi trường 3D tương tác</p>
    </div>
</div>

@* ── Holographic Nexus — phòng học 3D real-time + streaming ───────────────── *@
@{
    var nexusHref = isTeacher
        ? Url.Action("Create", "LuminaNexus", new { subject = ViewBag.DefaultSubjectTag as string })
        : "#joinNexus";
    var nexusCta = isTeacher ? "Tạo phòng mới" : "Nhập mã tham gia";
}
<a href="@nexusHref" class="nexus-banner" data-testid="nexus-entry">
    <div class="nexus-banner__glow"></div>
    <div class="nexus-banner__main">
        <span class="nexus-banner__badge">MỚI</span>
        <div class="nexus-banner__icon"><i class="bi bi-broadcast"></i></div>
        <div>
            <div class="nexus-banner__title">Holographic Nexus — Phòng học 3D thời gian thực</div>
            <div class="nexus-banner__desc">
                @if (isTeacher)
                {
                    <text>Tạo phòng có <b>mã 6 ký tự</b> để chia sẻ; đồng bộ thí nghiệm tương tác,
                    video &amp; âm thanh không gian real-time. Học sinh tham gia được cả trên điện thoại.</text>
                }
                else
                {
                    <text>Nhập <b>mã phòng</b> giáo viên cung cấp để vào học 3D thời gian thực:
                    xem thí nghiệm tương tác và video đồng bộ, ngay trên trình duyệt hoặc điện thoại.</text>
                }
            </div>
        </div>
    </div>
    <div class="nexus-banner__cta">
        @nexusCta <i class="bi bi-arrow-right"></i>
    </div>
</a>

<style>
.nexus-banner {
    display: flex; align-items: center; justify-content: space-between; gap: 20px;
    position: relative; overflow: hidden;
    margin-bottom: 24px; padding: 22px 26px; border-radius: 16px;
    text-decoration: none; color: #eaf0ff;
    background: linear-gradient(125deg, #0d1626 0%, #131f36 55%, #1a2748 100%);
    border: 1px solid rgba(79,139,255,.28);
    box-shadow: 0 14px 40px rgba(13,22,38,.28);
    transition: transform .25s cubic-bezier(.16,1,.3,1), box-shadow .25s, border-color .25s;
}
.nexus-banner:hover { transform: translateY(-2px); border-color: rgba(79,139,255,.6); box-shadow: 0 20px 52px rgba(23,99,255,.3); color:#fff; text-decoration:none; }
.nexus-banner__glow {
    position: absolute; width: 320px; height: 320px; right: -60px; top: -120px; pointer-events: none;
    background: radial-gradient(circle, rgba(23,99,255,.35), transparent 70%); filter: blur(14px);
}
.nexus-banner__main { display: flex; align-items: center; gap: 18px; position: relative; z-index: 1; }
.nexus-banner__badge {
    position: absolute; top: -10px; left: 0;
    font-size: .58rem; font-weight: 700; letter-spacing: .12em;
    background: linear-gradient(135deg, #06bf86, #2dd6a0); color: #04130d;
    padding: 2px 8px; border-radius: 5px;
}
.nexus-banner__icon {
    width: 54px; height: 54px; flex-shrink: 0; border-radius: 13px; display: grid; place-items: center;
    background: linear-gradient(135deg, #1763ff, #7b3fe4); font-size: 1.5rem; color: #fff;
    box-shadow: 0 6px 18px rgba(23,99,255,.4);
}
.nexus-banner__title { font-size: 1.08rem; font-weight: 600; margin-bottom: 4px; }
.nexus-banner__desc { font-size: .84rem; line-height: 1.55; color: rgba(234,240,255,.6); max-width: 60ch; }
.nexus-banner__cta {
    position: relative; z-index: 1; white-space: nowrap;
    display: inline-flex; align-items: center; gap: 8px;
    font-weight: 600; font-size: .88rem; padding: 11px 20px; border-radius: 10px;
    background: rgba(255,255,255,.1); border: 1px solid rgba(255,255,255,.2);
    transition: background .2s, gap .2s;
}
.nexus-banner:hover .nexus-banner__cta { background: rgba(255,255,255,.18); gap: 12px; }
@@media (max-width: 720px) {
    .nexus-banner { flex-direction: column; align-items: flex-start; }
    .nexus-banner__cta { width: 100%; justify-content: center; }
}
</style>

@* Thông báo Success/Error được render tập trung ở _Layout (tránh trùng 2 lần). *@

<div class="row g-4">

    <!-- ── LEFT: Active sessions ────────────────────────────────────────────── -->
    <div class="col-lg-8">
        <div class="lt-card">
            <div class="lt-card__header">
                <h3 class="lt-card__title">
                    <i class="bi bi-collection-fill" style="color:var(--lt-gold);margin-right:6px"></i>
                    Phòng đang hoạt động
                </h3>
                <span class="lt-badge lt-badge--navy">@Model.Count phòng</span>
            </div>
            <div class="lt-card__body">

                @if (!Model.Any())
                {
                    <div class="lt-empty lt-empty--sm">
                        <i class="bi bi-badge-vr" style="font-size:3rem;color:var(--lt-navy-100)"></i>
                        <div class="lt-empty__title">Chưa có phòng lab nào đang hoạt động</div>
                        <div class="lt-empty__sub">
                            @if (isTeacher) { <span>Tạo phòng mới để bắt đầu thí nghiệm.</span> }
                            else { <span>Nhập mã phòng từ giáo viên để tham gia.</span> }
                        </div>
                    </div>
                }
                else
                {
                    <div class="row g-3">
                        @foreach (var s in Model)
                        {
                            <div class="col-md-6">
                                <div class="lt-card lt-card--hover" style="border:1px solid var(--lt-border);margin:0">
                                    <div class="lt-card__body" style="padding:1rem">
                                        <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px">
                                            <div style="width:40px;height:40px;border-radius:10px;
                                                        background:@SubjectColor(s.SubjectTag)22;
                                                        display:flex;align-items:center;justify-content:center;flex-shrink:0">
                                                <i class="bi @SubjectIcon(s.SubjectTag)"
                                                   style="font-size:1.2rem;color:@SubjectColor(s.SubjectTag)"></i>
                                            </div>
                                            <div style="min-width:0">
                                                <div style="font-weight:600;font-size:.9rem;
                                                            white-space:nowrap;overflow:hidden;text-overflow:ellipsis">
                                                    @s.SessionName
                                                </div>
                                                <div style="font-size:.78rem;color:var(--lt-text-muted)">
                                                    @SubjectLabel(s.SubjectTag) — @SceneLabel(s.SceneType)
                                                </div>
                                            </div>
                                        </div>

                                        <div style="display:flex;align-items:center;justify-content:space-between;
                                                    margin-bottom:10px">
                                            <div style="display:flex;align-items:center;gap:6px">
                                                <span class="lt-pulse-dot lt-pulse-dot--success"></span>
                                                <span style="font-size:.78rem;color:var(--lt-success)">Đang mở</span>
                                            </div>
                                            <code style="background:var(--lt-navy-900);color:var(--lt-gold);
                                                         font-size:.85rem;padding:2px 8px;border-radius:6px;
                                                         letter-spacing:.1em;font-weight:700">
                                                @s.SessionCode
                                            </code>
                                        </div>

                                        <div style="font-size:.78rem;color:var(--lt-text-muted);margin-bottom:12px">
                                            <i class="bi bi-person-fill"></i> @s.TeacherName &nbsp;
                                            <i class="bi bi-clock"></i> @s.CreatedAt.ToString("HH:mm")
                                        </div>

                                        <a asp-action="Lab" asp-route-id="@s.Id"
                                           class="lt-btn lt-btn--primary lt-btn--sm"
                                           style="width:100%;justify-content:center">
                                            <i class="bi bi-play-circle-fill"></i> Vào phòng
                                        </a>

                                        @if (isTeacher && s.TeacherId == currentUserId)
                                        {
                                            <form asp-action="Close" asp-route-id="@s.Id" method="post" style="margin-top:8px">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="lt-btn lt-btn--sm lt-btn--outline"
                                                        style="width:100%;justify-content:center;border-color:var(--lt-danger);color:var(--lt-danger)"
                                                        onclick="return confirm('Đóng phòng lab?')">
                                                    <i class="bi bi-stop-circle"></i> Đóng phòng
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }

            </div>
        </div>
    </div>

    <!-- ── RIGHT: Create / Join ──────────────────────────────────────────────── -->
    <div class="col-lg-4">

        @* ── Lobby phòng học 3D thời gian thực (Holographic Nexus) ───────────── *@
        @if (isTeacher)
        {
            <div class="lt-card lt-mb-4">
                <div class="lt-card__header">
                    <h3 class="lt-card__title">
                        <i class="bi bi-plus-circle-fill" style="color:var(--lt-gold);margin-right:6px"></i>
                        Mở phòng học 3D mới
                    </h3>
                </div>
                <div class="lt-card__body">
                    <p style="font-size:.82rem;color:var(--lt-text-muted);line-height:1.55;margin-bottom:.9rem">
                        Hệ thống tạo <b>mã phòng 6 ký tự</b>; chia sẻ mã (hoặc link) cho học sinh để vào cùng phòng —
                        đồng bộ thí nghiệm &amp; video real-time, tham gia được cả trên điện thoại.
                    </p>
                    <a asp-controller="LuminaNexus" asp-action="Create"
                       asp-route-subject="@(ViewBag.DefaultSubjectTag as string)"
                       class="lt-btn lt-btn--primary" style="width:100%;justify-content:center">
                        <i class="bi bi-broadcast"></i> Tạo phòng &amp; vào dạy
                    </a>
                </div>
            </div>
        }

        <!-- Tham gia bằng mã (mọi vai trò) -->
        <div class="lt-card" id="joinNexus">
            <div class="lt-card__header">
                <h3 class="lt-card__title">
                    <i class="bi bi-door-open-fill" style="color:var(--lt-gold);margin-right:6px"></i>
                    Tham gia bằng mã phòng
                </h3>
            </div>
            <div class="lt-card__body">
                <form asp-controller="LuminaNexus" asp-action="Index" method="get">
                    <div class="lt-form-group lt-mb-3">
                        <label class="lt-label">Mã phòng (6 chữ số)</label>
                        <input name="room" class="lt-input" placeholder="VD: 348201" maxlength="6"
                               type="text" inputmode="numeric" pattern="[0-9]{6}" autocomplete="off"
                               oninput="this.value=this.value.replace(/[^0-9]/g,'')"
                               style="letter-spacing:.3em;font-weight:700;font-size:1.3rem;text-align:center"
                               required/>
                        <p class="lt-form-hint">Nhận mã số từ giáo viên hướng dẫn buổi học</p>
                    </div>
                    <button type="submit" class="lt-btn lt-btn--primary" style="width:100%;justify-content:center">
                        <i class="bi bi-box-arrow-in-right"></i> Vào phòng
                    </button>
                </form>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
    // Register the 3D Service Worker so Three.js is cached after first visit
    if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register('/sw-3d.js').catch(() => {});
    }
    </script>
}
