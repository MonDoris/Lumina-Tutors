@{
    Layout = null; // Full-screen immersive 3D experience
    var roomId       = ViewBag.RoomId as string ?? "nexus-demo";
    var isTeacher    = ViewBag.IsTeacher as bool? ?? false;
    var displayName  = ViewBag.DisplayName as string ?? "Học viên";
    var defaultTag   = ViewBag.DefaultSubjectTag as string ?? "";
    var initialScene = ViewBag.InitialScene as string ?? "";
    var iceServersJson = ViewBag.IceServersJson as string ?? "[{\"urls\":\"stun:stun.l.google.com:19302\"}]";
    var disabled     = isTeacher ? null : "disabled";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0"/>
    <title>Lumina Holographic Nexus — @roomId</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/nexus/OverlayUI.css" asp-append-version="true"/>

    <!-- IMPORTMAP phải đứng TRƯỚC mọi modulepreload (convention dự án) -->
    <script type="importmap">
    {
      "imports": {
        "three":         "/js/three/three.module.js",
        "three/addons/": "/js/three/"
      }
    }
    </script>
    <link rel="modulepreload" href="/js/three/three.module.js">
    <link rel="modulepreload" href="/js/three/controls/OrbitControls.js">
</head>
<body>
<div class="nexus-stage">

    <!-- 3D canvas (Holographic projection) -->
    <canvas id="nexusCanvas"></canvas>

    <!-- Hologram scanlines + flicker overlay -->
    <div class="nexus-fx" aria-hidden="true"></div>

    <!-- Boot scan -->
    <div class="nexus-boot" id="nexusBoot">
        <div class="nexus-boot-scan"></div>
        <div class="nexus-boot-text">
            <b>LUMINA <span>·</span> HOLOGRAPHIC NEXUS</b>
            <div class="nexus-boot-lines" id="nexusBootLines"></div>
        </div>
    </div>

    <!-- HUD telemetry -->
    <div class="hud-readout">
        <div>FPS <span class="v" id="hudFps">--</span></div>
        <div>EXPLODE <span class="v" id="hudExplode">0%</span></div>
    </div>

    <!-- Room code — giáo viên chia sẻ cho học sinh để tham gia -->
    <button class="roomcode" id="roomCode" type="button" data-room="@roomId"
            aria-label="Mã phòng @roomId — bấm để sao chép link mời">
        <span class="roomcode__k">MÃ PHÒNG</span>
        <span class="roomcode__v">@roomId</span>
        <i class="roomcode__ic" aria-hidden="true">⧉</i>
        <span class="roomcode__toast" id="roomToast"></span>
    </button>

    <!-- DANH SÁCH NGƯỜI TRONG PHÒNG — bấm nút để mở/đóng -->
    <button class="roster-toggle" id="rosterToggle" type="button"
            aria-label="Xem danh sách người trong phòng">
        <span class="roster-toggle__ic" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none"
                 stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 19v-1a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v1"/>
                <circle cx="9" cy="7" r="3.2"/>
                <path d="M22 19v-1a4 4 0 0 0-3-3.87"/>
                <path d="M16 4.13a4 4 0 0 1 0 6.74"/>
            </svg>
        </span>
        <span class="roster-toggle__count" id="rosterCount">0</span>
        <span class="roster-toggle__lbl">Trong phòng</span>
    </button>
    <aside class="roster-panel" id="rosterPanel" aria-label="Danh sách người trong phòng">
        <div class="roster-panel__head">
            <span>NGƯỜI TRONG PHÒNG</span>
            <span class="roster-panel__n"><b id="rosterHeadCount">0</b> người</span>
        </div>
        <ul class="roster-list" id="rosterList"></ul>
    </aside>

    <!-- Thông báo khi có người vào phòng -->
    <div class="roster-toast" id="rosterToast" aria-live="polite"></div>

    <!-- TABLET control panel (Clinical Luxury) -->
    <section class="tablet" role="toolbar" aria-label="Bảng điều khiển giảng dạy">
        <div class="tablet__bezel">
            <header class="tablet__head">
                <span class="tablet__brand">LUMINA<span>·</span>NEXUS</span>
                <span class="tablet__status">
                    <i class="dot" id="statusDot"></i><span id="statusTxt">CONNECTING…</span>
                </span>
                <button class="tablet__collapse" id="tabletCollapse" type="button"
                        aria-label="Thu gọn / mở bảng điều khiển">▾</button>
            </header>

            @if (isTeacher)
            {
                <div class="holo-pick" role="group" aria-label="Chọn môn học và thí nghiệm">
                    <label class="holo-pick__row">
                        <span class="holo-pick__lbl">Môn học</span>
                        <select id="subjectSel" class="holo-sel" aria-label="Môn học"></select>
                    </label>
                    <label class="holo-pick__row">
                        <span class="holo-pick__lbl">Thí nghiệm</span>
                        <select id="sceneSel" class="holo-sel" aria-label="Thí nghiệm"></select>
                    </label>
                </div>
            }

            <div class="tablet__tools">
                <button class="tool" id="btnHighlight" data-tool="highlight" title="Bật chế độ tô sáng, bấm vào bộ phận" @disabled>
                    <span class="tool__ic">◆</span>Highlight
                </button>
                <button class="tool" id="btnLabels" data-tool="label" title="Hiện/ẩn nhãn bộ phận" @disabled>
                    <span class="tool__ic">⌖</span>Nhãn
                </button>
                <button class="tool" id="btnReset" data-tool="reset" title="Đặt lại mô hình" @disabled>
                    <span class="tool__ic">⟲</span>Reset
                </button>
            </div>

            <label class="slider">
                <span>Bóc tách <b id="explodeVal">0%</b></span>
                <input id="explode" type="range" min="0" max="100" value="0" @disabled/>
            </label>

            <div class="tablet__specimen">
                <span class="specimen__k">HOLOGRAM</span>
                <span class="specimen__v" id="specimenLabel">Đang nạp hình chiếu…</span>
            </div>
        </div>
    </section>

    <!-- KỆ HÓA CHẤT (bàn phản ứng, chỉ giáo viên thao tác) -->
    @if (isTeacher)
    {
        <aside class="chemtray" id="chemTray" aria-label="Kệ hóa chất">
            <div class="chemtray__title">KỆ HÓA CHẤT — BẤM ĐỂ CHO VÀO CỐC</div>
            <div class="chemtray__grid" id="chemGrid"></div>
        </aside>
    }

    <!-- BẢNG PHƯƠNG TRÌNH PHẢN ỨNG (cả lớp đều thấy) -->
    <section class="chempanel" id="chemPanel" aria-live="polite">
        <div class="chempanel__k">PHẢN ỨNG HÓA HỌC</div>
        <div class="chempanel__contents" id="chemContents">Cốc rỗng</div>
        <div class="chempanel__eq" id="chemEq">—</div>
        <div class="chempanel__desc" id="chemDesc">Chọn hóa chất trên kệ để bắt đầu thí nghiệm.</div>
    </section>

    <!-- THANH TRƯỢT THAM SỐ (thí nghiệm Lý/Sinh/Toán, chỉ giáo viên) -->
    @if (isTeacher)
    {
        <aside class="simctrl" id="simControls" aria-label="Tham số thí nghiệm">
            <div class="simctrl__title">THAM SỐ THÍ NGHIỆM — KÉO ĐỂ ĐIỀU CHỈNH</div>
            <div class="simctrl__body" id="simCtrlBody"></div>
        </aside>
    }

    <!-- BẢNG KẾT QUẢ THÍ NGHIỆM (cả lớp đều thấy) -->
    <section class="simpanel" id="simPanel" aria-live="polite">
        <div class="simpanel__title" id="simTitle">—</div>
        <div class="simpanel__lines" id="simLines"></div>
    </section>

    <!-- DUAL-COMM video widget -->
    <aside class="commwidget">
        <video id="teacherFeed" autoplay muted playsinline style="display:none"></video>
        <div class="commwidget__placeholder" id="camPlaceholder">@(isTeacher ? "KHỞI ĐỘNG CAMERA…" : "CHỜ GIÁO VIÊN")</div>
        <div class="commwidget__bar">
            <span class="commwidget__name" id="commName">@displayName</span>
            <span class="commwidget__live"><i></i>LIVE</span>
        </div>
        <div class="commwidget__glow" aria-hidden="true"></div>
    </aside>

    <!-- THANH ĐIỀU KHIỂN PHÒNG (mic / camera / giơ tay / ghi hình / rời phòng) -->
    <div class="nexus-controls" role="toolbar" aria-label="Điều khiển phòng học">
        @if (isTeacher)
        {
            <button class="nx-ctl" id="nxMic" type="button" title="Tắt/bật micro" aria-label="Micro">
                <span class="nx-ic" id="nxMicIc">🎙️</span>
            </button>
            <button class="nx-ctl" id="nxCam" type="button" title="Tắt/bật camera" aria-label="Camera">
                <span class="nx-ic" id="nxCamIc">🎥</span>
            </button>
        }
        <button class="nx-ctl" id="nxHand" type="button" title="Giơ tay" aria-label="Giơ tay">
            <span class="nx-ic">✋</span>
        </button>
        <button class="nx-ctl" id="nxRec" type="button" title="Ghi hình buổi học" aria-label="Ghi hình">
            <span class="nx-ic" id="nxRecIc">⏺️</span>
        </button>
        <button class="nx-ctl nx-ctl--end" id="nxLeave" type="button"
                title="@(isTeacher ? "Kết thúc phòng" : "Rời phòng")" aria-label="@(isTeacher ? "Kết thúc phòng" : "Rời phòng")">
            <span class="nx-ic">📞</span>
        </button>
    </div>
    <div class="nexus-rec-badge" id="nxRecBadge"><span class="nx-recdot"></span>REC <span id="nxRecTime">00:00</span></div>

    <!-- Hidden media pool -->
    <div id="nexus-video-pool" style="position:absolute;width:0;height:0;overflow:hidden;opacity:0"></div>
</div>

<!-- SignalR client (global `signalR`) -->
<script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@@8.0.0/dist/browser/signalr.min.js"></script>

<script>
    window.NEXUS_CONFIG = {
        roomId: '@Html.Raw(roomId)',
        isTeacher: @(isTeacher ? "true" : "false"),
        displayName: '@Html.Raw(displayName.Replace("'", "\\'"))',
        subject: '@Html.Raw(defaultTag)',
        initialScene: '@Html.Raw(initialScene)',
        iceServers: @Html.Raw(iceServersJson)
    };

    // ── Mã phòng: bấm để sao chép LINK MỜI (hoặc mã) cho học sinh ──────────
    (function () {
        var btn = document.getElementById('roomCode'); if (!btn) return;
        var toast = document.getElementById('roomToast');
        var room = btn.getAttribute('data-room');
        var link = location.origin + '/LuminaNexus?room=' + encodeURIComponent(room);
        var t;
        function flash(msg) {
            if (!toast) return;
            toast.textContent = msg; btn.classList.add('copied');
            clearTimeout(t); t = setTimeout(function () { btn.classList.remove('copied'); }, 2200);
        }
        btn.addEventListener('click', function () {
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(link).then(function () { flash('Đã sao chép link mời ✓'); },
                    function () { fallback(); });
            } else { fallback(); }
        });
        function fallback() {
            var ta = document.createElement('textarea');
            ta.value = link; ta.style.position = 'fixed'; ta.style.opacity = '0';
            document.body.appendChild(ta); ta.select();
            try { document.execCommand('copy'); flash('Đã sao chép link mời ✓'); }
            catch (e) { flash('Mã phòng: ' + room); }
            document.body.removeChild(ta);
        }
    })();
</script>
<script type="module" src="~/js/nexus/nexus-init.js" asp-append-version="true"></script>
</body>
</html>
