@using LuminaTutors.Application.DTOs.Support
@model SupportThreadDto
@{
    ViewData["Title"] = "Hỗ trợ";
}

@section Styles {
    <style>
        .sc-wrap { max-width:820px }
        .sc-chat { background:#fff;border:1px solid #e9ecf2;border-radius:20px;overflow:hidden;display:flex;flex-direction:column;
                   height:72vh;box-shadow:0 1px 3px rgba(16,24,40,.05) }

        .sc-head { display:flex;align-items:center;gap:13px;padding:16px 20px;border-bottom:1px solid #eef0f4;background:#fff }
        .sc-ava { position:relative;width:44px;height:44px;border-radius:50%;background:linear-gradient(135deg,#0f2440,#24507f);
                  color:#fff;display:grid;place-items:center;font-weight:800;font-size:.82rem;flex:none }
        .sc-ava .dot { position:absolute;right:-1px;bottom:-1px;width:12px;height:12px;border-radius:50%;background:#22c55e;border:2.5px solid #fff }
        .sc-name { font-weight:800;color:var(--lt-navy);font-size:1rem }
        .sc-sub { font-size:.78rem;color:#94a3b8;display:flex;align-items:center;gap:5px;margin-top:1px }
        .sc-secure { margin-left:auto;font-size:.72rem;color:#16a34a;display:inline-flex;align-items:center;gap:5px;
                     background:#f0fdf4;border:1px solid #dcfce7;border-radius:99px;padding:4px 10px }

        .sc-body { flex:1;overflow-y:auto;padding:22px;display:flex;flex-direction:column;gap:10px;
                   background:radial-gradient(circle at 50% 0,#f3f6fb,#f8fafc 60%) }
        .sc-row { display:flex }
        .sc-row.me { justify-content:flex-end }
        .sc-bubble { max-width:74%;padding:10px 14px;border-radius:16px;font-size:.92rem;line-height:1.5;white-space:pre-wrap;word-break:break-word }
        .sc-row.me .sc-bubble { background:var(--lt-navy);color:#fff;border-bottom-right-radius:5px }
        .sc-row.them .sc-bubble { background:#fff;color:#1f2937;border:1px solid #e7eaf0;border-bottom-left-radius:5px }
        .sc-meta { font-size:.68rem;opacity:.65;margin-top:5px }

        /* Empty state */
        .sc-empty { margin:auto;text-align:center;max-width:440px;padding:10px }
        .sc-empty__ic { width:72px;height:72px;border-radius:50%;display:grid;place-items:center;margin:0 auto 16px;
                        background:#eef2ff;color:#4338ca;font-size:1.9rem }
        .sc-empty__t { font-weight:800;color:var(--lt-navy);font-size:1.12rem }
        .sc-empty__s { color:#64748b;font-size:.9rem;line-height:1.55;margin:6px 0 18px }
        .sc-chips { display:flex;flex-wrap:wrap;gap:8px;justify-content:center }
        .sc-chip { background:#fff;border:1px solid #dbe2ec;color:#334155;border-radius:99px;padding:8px 14px;font-size:.83rem;
                   cursor:pointer;transition:.14s }
        .sc-chip:hover { border-color:var(--lt-navy);color:var(--lt-navy);background:#f5f8fc }

        /* Composer */
        .sc-send { display:flex;gap:10px;padding:14px 16px;border-top:1px solid #eef0f4;background:#fff;align-items:center }
        .sc-input { flex:1;border:1px solid #d8dee8;border-radius:99px;padding:12px 18px;font-size:.93rem;outline:none;transition:.14s }
        .sc-input:focus { border-color:var(--lt-navy);box-shadow:0 0 0 3px rgba(15,36,64,.08) }
        .sc-btn { border:none;cursor:pointer;background:var(--lt-navy);color:#fff;border-radius:99px;padding:12px 20px;
                  font-weight:700;font-size:.9rem;display:inline-flex;align-items:center;gap:8px;transition:.14s }
        .sc-btn:hover { background:#1a3a63 }
    </style>
}

<div class="lt-page-header">
    <div>
        <h1 class="lt-page-title">Hỗ trợ &amp; Liên hệ</h1>
        <p class="lt-page-subtitle">Nhắn tin trực tiếp với Quản trị hệ thống Lumina Tutors</p>
    </div>
</div>

<div class="sc-wrap">
    <div class="sc-chat">
        <div class="sc-head">
            <div class="sc-ava">LT<span class="dot"></span></div>
            <div>
                <div class="sc-name">Quản trị hệ thống Lumina</div>
                <div class="sc-sub"><i class="bi bi-clock"></i> Thường phản hồi trong vài giờ</div>
            </div>
            <span class="sc-secure"><i class="bi bi-shield-lock-fill"></i> Bảo mật</span>
        </div>

        <div class="sc-body" id="scBody">
            @if (Model.Messages.Count == 0)
            {
                <div class="sc-empty">
                    <div class="sc-empty__ic"><i class="bi bi-chat-heart"></i></div>
                    <div class="sc-empty__t">Chúng tôi có thể giúp gì cho trường?</div>
                    <div class="sc-empty__s">Gửi câu hỏi hoặc yêu cầu hỗ trợ — Quản trị hệ thống sẽ phản hồi sớm nhất. Chọn nhanh một chủ đề:</div>
                    <div class="sc-chips">
                        <button type="button" class="sc-chip" onclick="fillMsg(this)">Hỗ trợ thanh toán / gia hạn gói</button>
                        <button type="button" class="sc-chip" onclick="fillMsg(this)">Sự cố đăng nhập tài khoản</button>
                        <button type="button" class="sc-chip" onclick="fillMsg(this)">Tư vấn nâng cấp gói dịch vụ</button>
                        <button type="button" class="sc-chip" onclick="fillMsg(this)">Hướng dẫn sử dụng hệ thống</button>
                    </div>
                </div>
            }
            @foreach (var m in Model.Messages)
            {
                var mine = !m.FromSysAdmin;
                <div class="sc-row @(mine ? "me" : "them")">
                    <div class="sc-bubble">@m.Text<div class="sc-meta">@m.SenderName · @m.SentAt.ToString("HH:mm dd/MM")</div></div>
                </div>
            }
        </div>

        <form class="sc-send" asp-action="Send" method="post">
            @Html.AntiForgeryToken()
            <input name="text" id="scInput" class="sc-input" placeholder="Nhập tin nhắn cho Quản trị hệ thống..." autocomplete="off" required maxlength="2000" />
            <button type="submit" class="sc-btn"><i class="bi bi-send-fill"></i> Gửi</button>
        </form>
    </div>
</div>

<script>
    var _b = document.getElementById('scBody'); if (_b) _b.scrollTop = _b.scrollHeight;
    function fillMsg(btn) { var i = document.getElementById('scInput'); i.value = btn.textContent.trim(); i.focus(); }
</script>
