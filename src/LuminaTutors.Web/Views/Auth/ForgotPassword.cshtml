                    <div class="phone-wrap">
                        <span class="phone-flag">🇻🇳</span>
                        <input type="tel" id="phone" name="phone"
                               class="form-input pl @(phoneError != null ? "is-invalid" : "")"
                               placeholder="0912 345 678"
                               inputmode="numeric"
                               autocomplete="tel"
                               autofocus
                               data-testid="input-phone"/>
                    </div>
                    @if (phoneError is not null)
                    {
                        <div class="form-error">
                            <i class="bi bi-exclamation-circle"></i> @phoneError
                        </div>
                    }
                    <div class="form-hint">
                        <i class="bi bi-info-circle"></i>
                        Nhập số điện thoại đã đăng ký khi tạo tài khoản.
                    </div>
                </div>

                <button type="submit" class="btn-submit" id="submitBtn" data-testid="btn-send-otp">
                    <i class="bi bi-send-fill" id="btnIcon" style="position:relative;z-index:1"></i>
                    <span id="btnText" style="position:relative;z-index:1">Gửi mã OTP</span>
                </button>
            </form>

            <div class="card-foot">
                Đã nhớ mật khẩu?&nbsp;
                <a asp-controller="Auth" asp-action="Login" asp-route-role="@role">
                    <i class="bi bi-arrow-left"></i> Quay lại đăng nhập
                </a>
            </div>

        </div>
    </div>
</div>

<script>
// ── Star canvas ───────────────────────────────────────────────────────────────
(function () {
    var cv = document.getElementById('starCanvas');
    var cx = cv.getContext('2d');
    var W, H, stars = [];

    function resize() { W = cv.width = window.innerWidth; H = cv.height = window.innerHeight; }

    function mkStars() {
        stars = [];
        var n = Math.floor(W * H / 5200);
        for (var i = 0; i < n; i++) {
            var big = Math.random() < .04;
            stars.push({
                x: Math.random()*W, y: Math.random()*H,
                r: big ? 1.6+Math.random()*1.4 : .4+Math.random()*1.1,
                phase: Math.random()*Math.PI*2,
                speed: .4+Math.random()*.8,
                big: big, colored: Math.random()<.12, hue: Math.random()*360
            });
        }
    }

    function draw(t) {
        cx.clearRect(0,0,W,H);
        for (var i=0; i<stars.length; i++) {
            var s = stars[i];
            var alpha = .35 + .65*(.5+.5*Math.sin(s.phase+t*s.speed*.001));
            cx.fillStyle = s.colored ? 'hsla('+s.hue+',80%,75%,'+alpha+')' : 'rgba(255,255,255,'+alpha+')';
            cx.beginPath(); cx.arc(s.x,s.y,s.r,0,6.2832); cx.fill();
            if (s.big) {
                cx.globalAlpha = alpha*.35; cx.strokeStyle='#fff'; cx.lineWidth=.6;
                cx.beginPath();
                cx.moveTo(s.x-s.r*2.8,s.y); cx.lineTo(s.x+s.r*2.8,s.y);
                cx.moveTo(s.x,s.y-s.r*2.8); cx.lineTo(s.x,s.y+s.r*2.8);
                cx.stroke(); cx.globalAlpha=1;
            }
        }
        requestAnimationFrame(draw);
    }

    window.addEventListener('resize', function(){ resize(); mkStars(); });
    resize(); mkStars(); requestAnimationFrame(draw);
})();

// ── Phone input + submit ──────────────────────────────────────────────────────
(function () {
    var inp = document.getElementById('phone');
    var btn = document.getElementById('submitBtn');
    var txt = document.getElementById('btnText');
    var ico = document.getElementById('btnIcon');

    inp.addEventListener('input', function () { this.value = this.value.replace(/\D/g,''); });

    document.getElementById('fpForm').addEventListener('submit', function () {
        btn.disabled = true;
        ico.className = 'bi bi-hourglass-split';
        txt.textContent = 'Đang gửi…';
    });
})();
</script>
</body>
</html>
