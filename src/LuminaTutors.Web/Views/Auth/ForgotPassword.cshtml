@{
    Layout = null;
    string role = (ViewBag.Role as string ?? "student").ToLower();

    // Per-role palette — mirrors Login.cshtml exactly
    var roles = new Dictionary<string, (string Label, string Icon, string Accent, string A1, string A2, string A3)>
    {
        ["student"]    = ("Học Sinh",      "bi-mortarboard-fill", "#3b82f6", "#1d4ed8", "#6366f1", "#0ea5e9"),
        ["teacher"]    = ("Giáo Viên",     "bi-person-video3",    "#10b981", "#059669", "#14b8a6", "#34d399"),
        ["supervisor"] = ("Giám Thị",      "bi-shield-fill",      "#f59e0b", "#d97706", "#ef4444", "#fbbf24"),
        ["parent"]     = ("Phụ Huynh",     "bi-people-fill",      "#8b5cf6", "#7c3aed", "#ec4899", "#a78bfa"),
        ["admin"]      = ("Quản Trị Viên", "bi-shield-lock-fill", "#94a3b8", "#64748b", "#475569", "#cbd5e1"),
    };
    if (!roles.TryGetValue(role, out var rMeta)) rMeta = roles["student"];
    var (rLabel, rIcon, rAccent, rA1, rA2, rA3) = rMeta;

    string? phoneError = ViewData["PhoneError"] as string;
    string? tempError  = TempData["Error"] as string;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Quên Mật Khẩu — Lumina Tutors</title>
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;800&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
    <style>
        *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
        html,body{height:100%;font-family:'Inter',sans-serif;-webkit-font-smoothing:antialiased;overflow:hidden}

        /* ══════════════════════════════════════════════════════════════════
           NIGHT SKY BACKGROUND
        ══════════════════════════════════════════════════════════════════ */
        body {
            background: #060918;
            display: flex; align-items: center; justify-content: center;
            min-height: 100vh; position: relative;
        }

        /* Star canvas */
        #starCanvas { position: fixed; inset: 0; z-index: 0; pointer-events: none; }

        /* Aurora bands */
        .aurora { position: fixed; inset: 0; z-index: 1; pointer-events: none; overflow: hidden; }
        .ab {
            position: absolute; border-radius: 50%;
            filter: blur(38px); opacity: .55;
            animation: auroraDrift var(--dur,22s) ease-in-out var(--del,0s) infinite alternate;
        }
        .ab:nth-child(1){
            width:700px;height:320px;top:-60px;left:-120px;
            background:radial-gradient(ellipse,@rA1 + "cc" 0%,@rA2 + "55" 55%,transparent 100%);
            --dur:24s;--del:0s;
        }
        .ab:nth-child(2){
            width:540px;height:260px;top:5%;right:-80px;
            background:radial-gradient(ellipse,@rA3 + "99" 0%,@rA1 + "44" 50%,transparent 100%);
            --dur:19s;--del:-7s;
        }
        .ab:nth-child(3){
            width:480px;height:200px;bottom:8%;left:10%;
            background:radial-gradient(ellipse,@rA2 + "88" 0%,@rA3 + "33" 55%,transparent 100%);
            --dur:28s;--del:-13s;
        }
        @@keyframes auroraDrift {
            0%   { transform: translate(0,0) scale(1); }
            33%  { transform: translate(40px,-20px) scale(1.08); }
            66%  { transform: translate(-30px,15px) scale(.94); }
            100% { transform: translate(20px,-10px) scale(1.04); }
        }

        /* Moon */
        .moon {
            position: fixed; top: 48px; right: 88px; z-index: 2;
            width: 64px; height: 64px; border-radius: 50%;
            background: radial-gradient(circle at 38% 38%, #fffde7, #fde68a 55%, #f59e0b 100%);
            box-shadow: 0 0 0 10px rgba(253,230,138,.08), 0 0 0 22px rgba(253,230,138,.04), 0 0 60px 12px rgba(251,191,36,.22);
            animation: moonPulse 6s ease-in-out infinite alternate;
        }
        @@keyframes moonPulse {
            from { box-shadow: 0 0 0 10px rgba(253,230,138,.08), 0 0 0 22px rgba(253,230,138,.04), 0 0 60px 12px rgba(251,191,36,.22); }
            to   { box-shadow: 0 0 0 14px rgba(253,230,138,.11), 0 0 0 30px rgba(253,230,138,.05), 0 0 80px 18px rgba(251,191,36,.30); }
        }

        /* Fireflies */
        .ff {
            position: fixed; z-index: 2; border-radius: 50%; pointer-events: none;
            width: 4px; height: 4px;
            background: @rAccent;
            box-shadow: 0 0 6px 2px @rAccent + "99";
            animation: ffFloat var(--fd,9s) ease-in-out var(--dl,0s) infinite alternate;
            opacity: .7;
        }
        @@keyframes ffFloat {
            0%   { transform: translate(0,0) scale(1); opacity:.5 }
            40%  { opacity: .9; }
            100% { transform: translate(var(--tx,30px),var(--ty,-25px)) scale(1.5); opacity:.3 }
        }

        /* Tree silhouette */
        .trees { position: fixed; bottom: 0; left: 0; right: 0; z-index: 2; pointer-events: none; }

        /* ══════════════════════════════════════════════════════════════════
           LAYOUT WRAPPER
        ══════════════════════════════════════════════════════════════════ */
        .page-wrap {
            position: relative; z-index: 10;
            display: flex; flex-direction: column; align-items: center;
            padding: 24px 16px 40px; width: 100%;
        }

        /* Back-to-login floating link */
        .back-link {
            position: fixed; top: 28px; left: 36px; z-index: 20;
            display: inline-flex; align-items: center; gap: 7px;
            font-size: .8rem; font-weight: 600; color: rgba(255,255,255,.45);
            text-decoration: none; transition: color .2s, background .2s;
            background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.09);
            border-radius: 99px; padding: 6px 14px 6px 10px;
            backdrop-filter: blur(8px);
        }
        .back-link:hover { color: rgba(255,255,255,.85); background: rgba(255,255,255,.1); }

        /* ══════════════════════════════════════════════════════════════════
           STEP TRAIL
        ══════════════════════════════════════════════════════════════════ */
        .step-trail {
            display: flex; align-items: center; gap: 0; margin-bottom: 20px;
        }
        .st-dot-wrap { position: relative; display: flex; flex-direction: column; align-items: center; }
        .st-dot {
            width: 34px; height: 34px; border-radius: 50%; border: 2px solid rgba(255,255,255,.15);
            display: flex; align-items: center; justify-content: center;
            font-size: .72rem; font-weight: 700; color: rgba(255,255,255,.3);
            background: rgba(255,255,255,.04);
        }
        .st-dot.active {
            border-color: #fbbf24; color: #1a0f00; background: #fbbf24;
            box-shadow: 0 0 18px rgba(251,191,36,.55);
        }
        .st-dot.done {
            border-color: rgba(255,255,255,.3); color: rgba(255,255,255,.6);
            background: rgba(255,255,255,.10);
        }
        .st-line { width: 48px; height: 2px; background: rgba(255,255,255,.1); flex-shrink: 0; }
        .st-label {
            font-size: .6rem; font-weight: 600; color: rgba(255,255,255,.25);
            white-space: nowrap; margin-top: 5px; text-align: center;
        }
        .st-dot-wrap.active .st-label { color: #fbbf24; }

        /* ══════════════════════════════════════════════════════════════════
           OWL CHARACTER (gentle idle float)
        ══════════════════════════════════════════════════════════════════ */
        .owl-stage {
            width: 160px; height: 175px; margin: 0 auto 10px;
            animation: owlFloat 4.2s ease-in-out infinite;
            filter: drop-shadow(0 12px 28px @rAccent + "55");
        }
        @@keyframes owlFloat {
            0%,100% { transform: translateY(0) rotate(0deg); }
            28%     { transform: translateY(-10px) rotate(-2deg); }
            55%     { transform: translateY(-6px) rotate(2deg); }
            80%     { transform: translateY(-2px) rotate(0deg); }
        }
        @@keyframes keySwing {
            0%,100% { transform: rotate(-8deg); }
            50%     { transform: rotate(12deg); }
        }
        #keyGrp { animation: keySwing 2.8s ease-in-out infinite; transform-box: fill-box; transform-origin: center top; }
        @@keyframes qFloat {
            0%,100% { transform: translateY(0) scale(1); opacity:.85; }
            50%     { transform: translateY(-7px) scale(1.1); opacity:1; }
        }
        #qMark { animation: qFloat 2.2s ease-in-out infinite; }

        /* ══════════════════════════════════════════════════════════════════
           GLASS CARD
        ══════════════════════════════════════════════════════════════════ */
        .glass-card {
            width: 100%; max-width: 408px;
            background: rgba(8, 12, 32, 0.78);
            backdrop-filter: blur(32px) saturate(1.6);
            -webkit-backdrop-filter: blur(32px) saturate(1.6);
            border: 1px solid rgba(255,255,255,.10);
            border-radius: 26px;
            box-shadow: 0 0 0 1px rgba(255,255,255,.04) inset,
                        0 32px 64px rgba(0,0,0,.55),
                        0 0 80px @rAccent + "22";
            overflow: hidden; position: relative;
        }
        /* Top accent stripe */
        .glass-card::before {
            content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
            background: linear-gradient(90deg, transparent 0%, @rAccent 35%, #fbbf24 65%, transparent 100%);
        }
        .card-inner { padding: 36px 36px 32px; }

        /* Role pill */
        .role-pill {
            display: inline-flex; align-items: center; gap: 8px;
            background: rgba(255,255,255,.07); border: 1px solid rgba(255,255,255,.12);
            border-radius: 99px; padding: 5px 14px 5px 8px; margin-bottom: 18px;
        }
        .role-pill-dot {
            width: 24px; height: 24px; border-radius: 50%;
            background: linear-gradient(135deg, @rAccent, @rA2);
            display: flex; align-items: center; justify-content: center;
            font-size: .68rem; color: #fff;
        }
        .role-pill-name { font-size: .78rem; font-weight: 600; color: rgba(255,255,255,.7); }

        /* Heading */
        .card-title {
            font-family: 'Playfair Display', serif;
            font-size: 1.55rem; font-weight: 800;
            color: #fff; letter-spacing: -.4px; margin-bottom: 4px;
        }
        .card-sub {
            font-size: .845rem; color: rgba(255,255,255,.38); line-height: 1.6; margin-bottom: 26px;
        }
        .card-sub strong { color: @rAccent; }

        /* Alert */
        .alert-err {
            background: rgba(239,68,68,.12); border: 1px solid rgba(239,68,68,.25);
            border-radius: 10px; padding: 11px 14px; font-size: .845rem;
            color: #fca5a5; display: flex; align-items: center; gap: 8px;
            margin-bottom: 18px;
        }

        /* Form */
        .form-label {
            display: block; font-size: .78rem; font-weight: 600;
            color: rgba(255,255,255,.5); margin-bottom: 7px; letter-spacing: .2px;
        }
        .phone-wrap { position: relative; margin-bottom: 8px; }
        .phone-flag {
            position: absolute; left: 0; top: 0; bottom: 0; width: 52px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.1rem; pointer-events: none;
            border-right: 1px solid rgba(255,255,255,.09);
        }
        .form-input {
            width: 100%; height: 50px; border-radius: 12px;
            border: 1.5px solid rgba(255,255,255,.1);
            background: rgba(255,255,255,.06);
            color: #fff; font-size: .9375rem; font-family: inherit;
            padding: 0 16px; outline: none;
            transition: border-color .2s, box-shadow .2s, background .2s;
        }
        .form-input.pl { padding-left: 58px; }
        .form-input::placeholder { color: rgba(255,255,255,.22); }
        .form-input:focus {
            border-color: @rAccent;
            box-shadow: 0 0 0 3px @rAccent + "28";
            background: rgba(255,255,255,.09);
        }
        .form-input.is-invalid { border-color: #ef4444; box-shadow: 0 0 0 3px rgba(239,68,68,.18); }
        .form-error { font-size: .75rem; color: #fca5a5; margin-top: 5px; display: flex; align-items: center; gap: 4px; }
        .form-hint  { font-size: .74rem; color: rgba(255,255,255,.22); margin-top: 5px; display: flex; align-items: center; gap: 4px; }

        /* Submit button — vivid amber/gold (same as Login button) */
        .btn-submit {
            width: 100%; height: 50px; border: none; border-radius: 12px;
            font-size: .9375rem; font-weight: 800; color: #1a0f00;
            background: linear-gradient(135deg, #fde68a 0%, #fbbf24 40%, #f59e0b 100%);
            box-shadow: 0 4px 28px rgba(251,191,36,.55), 0 1px 0 rgba(255,255,255,.25) inset;
            cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 9px;
            transition: filter .2s, transform .15s, box-shadow .2s;
            font-family: inherit; position: relative; overflow: hidden;
            margin-top: 22px; letter-spacing: .3px;
        }
        .btn-submit::before {
            content: ''; position: absolute; inset: 0;
            background: linear-gradient(to bottom, rgba(255,255,255,.28), transparent 55%);
            border-radius: inherit;
        }
        .btn-submit:hover  { filter: brightness(1.08); transform: translateY(-2px); box-shadow: 0 10px 40px rgba(251,191,36,.75), 0 1px 0 rgba(255,255,255,.25) inset; }
        .btn-submit:active { transform: translateY(0); filter: brightness(.97); }
        .btn-submit:disabled { opacity: .55; cursor: not-allowed; transform: none; filter: none; }

        /* Card footer */
        .card-foot {
            font-size: .76rem; color: rgba(255,255,255,.22); text-align: center; margin-top: 22px; line-height: 1.65;
        }
        .card-foot a {
            color: @rAccent; font-weight: 600; text-decoration: none; transition: opacity .15s;
        }
        .card-foot a:hover { opacity: .72; text-decoration: underline; }

        @@media(max-width:480px){
            .card-inner { padding: 28px 22px 24px; }
            .glass-card { border-radius: 20px; }
            .back-link  { top: 16px; left: 16px; }
            .moon       { display: none; }
        }
    </style>
</head>
<body>
<canvas id="starCanvas"></canvas>
<div class="aurora"><div class="ab"></div><div class="ab"></div><div class="ab"></div></div>
<div class="moon"></div>

<!-- Fireflies (13) -->
<div class="ff" style="top:12%;left:8%;--fd:8s;--dl:0s;--tx:28px;--ty:-18px"></div>
<div class="ff" style="top:18%;left:22%;--fd:11s;--dl:-2s;--tx:-22px;--ty:-30px"></div>
<div class="ff" style="top:6%;left:55%;--fd:9s;--dl:-4s;--tx:18px;--ty:22px"></div>
<div class="ff" style="top:30%;left:75%;--fd:13s;--dl:-1s;--tx:-35px;--ty:-15px"></div>
<div class="ff" style="top:55%;left:88%;--fd:7s;--dl:-5s;--tx:20px;--ty:-28px"></div>
<div class="ff" style="top:72%;left:5%;--fd:10s;--dl:-3s;--tx:32px;--ty:-20px"></div>
<div class="ff" style="top:80%;left:40%;--fd:12s;--dl:-6s;--tx:-18px;--ty:-35px"></div>
<div class="ff" style="top:42%;left:3%;--fd:8.5s;--dl:-1.5s;--tx:25px;--ty:-12px"></div>
<div class="ff" style="top:65%;left:92%;--fd:9.5s;--dl:-3.5s;--tx:-20px;--ty:-22px"></div>
<div class="ff" style="top:24%;left:38%;--fd:14s;--dl:-7s;--tx:14px;--ty:-26px"></div>
<div class="ff" style="top:88%;left:68%;--fd:6.5s;--dl:-2.5s;--tx:30px;--ty:-14px"></div>
<div class="ff" style="top:48%;left:60%;--fd:11.5s;--dl:-4.5s;--tx:-26px;--ty:-18px"></div>
<div class="ff" style="top:35%;left:15%;--fd:10.5s;--dl:-0.5s;--tx:20px;--ty:-32px"></div>

<!-- Tree silhouette -->
<svg class="trees" viewBox="0 0 1440 180" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMax meet">
  <path fill="#060918" d="M0,180 L0,120 Q10,115 18,105 L26,90 L34,105 Q40,115 46,118 L50,100 L60,75 L70,100 L76,118 Q82,115 90,120 L90,180 Z"/>
  <path fill="#070a1a" d="M100,180 L100,110 Q115,100 125,82 L140,55 L155,82 Q165,100 180,110 L180,180 Z"/>
  <path fill="#060918" d="M200,180 L200,125 Q212,118 220,108 L228,92 L236,108 Q244,118 256,125 L256,180 Z"/>
  <path fill="#080b1c" d="M300,180 L300,108 Q320,96 334,72 L354,38 L374,72 Q388,96 408,108 L408,180 Z"/>
  <path fill="#060918" d="M430,180 L430,130 Q440,122 447,114 L454,100 L461,114 Q468,122 478,130 L478,180 Z"/>
  <path fill="#060a1b" d="M520,180 L520,112 Q538,100 550,80 L566,50 L582,80 Q594,100 612,112 L612,180 Z"/>
  <path fill="#060918" d="M650,180 L650,128 Q660,120 667,110 L675,96 L683,110 Q690,120 700,128 L700,180 Z"/>
  <path fill="#080c1e" d="M760,180 L760,105 Q782,90 798,64 L820,28 L842,64 Q858,90 880,105 L880,180 Z"/>
  <path fill="#060918" d="M920,180 L920,118 Q932,110 940,100 L948,85 L956,100 Q964,110 976,118 L976,180 Z"/>
  <path fill="#070a1a" d="M1020,180 L1020,108 Q1038,96 1052,74 L1070,44 L1088,74 Q1102,96 1120,108 L1120,180 Z"/>
  <path fill="#060918" d="M1160,180 L1160,124 Q1170,116 1177,106 L1184,92 L1191,106 Q1198,116 1208,124 L1208,180 Z"/>
  <path fill="#080b1c" d="M1250,180 L1250,110 Q1268,98 1282,76 L1300,46 L1318,76 Q1332,98 1350,110 L1350,180 Z"/>
  <path fill="#060918" d="M1380,180 L1380,120 Q1390,112 1397,102 L1404,88 L1411,102 Q1418,112 1430,120 L1440,120 L1440,180 Z"/>
  <rect x="0" y="150" width="1440" height="30" fill="#060918"/>
</svg>

<!-- ════════════════════════════════════════════════════════
     BACK LINK
════════════════════════════════════════════════════════ -->
<a asp-controller="Auth" asp-action="Login" asp-route-role="@role" class="back-link">
    <i class="bi bi-arrow-left-short" style="font-size:1rem"></i> Đăng nhập
</a>

<!-- ════════════════════════════════════════════════════════
     MAIN CONTENT
════════════════════════════════════════════════════════ -->
<div class="page-wrap">

    <!-- Step trail -->
    <div class="step-trail">
        <div class="st-dot-wrap active">
            <div class="st-dot active">1</div>
            <div class="st-label">Số điện thoại</div>
        </div>
        <div class="st-line"></div>
        <div class="st-dot-wrap">
            <div class="st-dot">2</div>
            <div class="st-label">Mã OTP</div>
        </div>
        <div class="st-line"></div>
        <div class="st-dot-wrap">
            <div class="st-dot">3</div>
            <div class="st-label">Mật khẩu mới</div>
        </div>
    </div>

    <!-- Role-specific character (floating idle, holding a key, question mark above) -->
    <div class="owl-stage" aria-hidden="true">

@if (role == "student") {
        <!-- Student: Ginger cat holding a key -->
        <svg viewBox="0 0 220 210" xmlns="http://www.w3.org/2000/svg" width="200" height="210" overflow="visible">
            <rect x="36" y="162" width="148" height="10" rx="5" fill="#5c3d2a"/>
            <rect x="36" y="162" width="148" height="4"  rx="2" fill="#7a5038"/>
            <g stroke-linecap="round" stroke="#c87820" stroke-width="2.5" fill="none">
                <line x1="84" y1="168" x2="78" y2="176"/><line x1="88" y1="168" x2="88" y2="178"/><line x1="92" y1="168" x2="98" y2="176"/>
                <line x1="128" y1="168" x2="122" y2="176"/><line x1="132" y1="168" x2="132" y2="178"/><line x1="136" y1="168" x2="142" y2="176"/>
            </g>
            <!-- Body (ginger) -->
            <ellipse cx="110" cy="132" rx="48" ry="44" fill="#d97830"/>
            <ellipse cx="110" cy="138" rx="30" ry="34" fill="#f5ddb8"/>
            <!-- Tail -->
            <path d="M155,148 Q185,155 188,136 Q190,122 176,118" stroke="#d97830" stroke-width="11" fill="none" stroke-linecap="round"/>
            <!-- Left arm (resting) -->
            <path d="M68,118 Q60,128 64,144" stroke="#c4682c" stroke-width="10" stroke-linecap="round" fill="none"/>
            <ellipse cx="66" cy="148" rx="11" ry="9" fill="#c4682c"/>
            <circle cx="60" cy="152" r="4" fill="#c4682c"/><circle cx="66" cy="155" r="4" fill="#c4682c"/><circle cx="72" cy="152" r="4" fill="#c4682c"/>
            <!-- Right arm (raised, key) -->
            <path d="M152,118 Q162,108 158,96 Q154,86 146,82" stroke="#c4682c" stroke-width="10" stroke-linecap="round" fill="none"/>
            <ellipse cx="143" cy="78" rx="12" ry="9" fill="#c4682c"/>
            <g id="keyGrp">
                <circle cx="150" cy="64" r="11" stroke="#fbbf24" stroke-width="3.5" fill="none"/>
                <circle cx="150" cy="64" r="5.5" fill="#fbbf24" opacity=".3"/>
                <rect x="157" y="61.5" width="22" height="5" rx="2.5" fill="#fbbf24"/>
                <rect x="170" y="66.5" width="4" height="7" rx="1.5" fill="#fbbf24"/>
                <rect x="175" y="66.5" width="4" height="5" rx="1.5" fill="#fbbf24"/>
            </g>
            <!-- Cat ears — drawn BEFORE head so head covers their bases naturally -->
            <path d="M86,53 L76,26 L100,50 Z" fill="#d97830"/>
            <path d="M134,53 L144,26 L120,50 Z" fill="#d97830"/>
            <!-- Head (same ginger as body → seamless) -->
            <circle cx="110" cy="88" r="44" fill="#d97830"/>
            <!-- Pink inner ears (drawn after head, overlaying inner portion) -->
            <path d="M88,52 L80,32 L98,50 Z" fill="#f4a090" opacity=".65"/>
            <path d="M132,52 L140,32 L122,50 Z" fill="#f4a090" opacity=".65"/>
            <!-- Whiskers only (muzzle plate removed) -->
            <line x1="64" y1="97" x2="94" y2="95"  stroke="#4a2e08" stroke-width="1.1" opacity=".28"/>
