@{
    Layout = null;
    string role  = (ViewBag.Role as string ?? "student").ToLower();
    string token = ViewBag.Token as string ?? "";
    string? pwError   = ViewData["PwError"] as string;
    string? tempError = TempData["Error"] as string;

    var roles = new Dictionary<string, (string Label, string Icon, string Grad)>
    {
        ["student"]    = ("Học Sinh",      "bi-mortarboard-fill",  "linear-gradient(145deg,#0f1f4a 0%,#1a3a8f 50%,#2563eb 100%)"),
        ["teacher"]    = ("Giáo Viên",     "bi-person-video3",     "linear-gradient(145deg,#052e1c 0%,#065f3e 50%,#059669 100%)"),
        ["supervisor"] = ("Giám Thị",      "bi-shield-fill",       "linear-gradient(145deg,#431407 0%,#92400e 50%,#d97706 100%)"),
        ["parent"]     = ("Phụ Huynh",     "bi-people-fill",       "linear-gradient(145deg,#2e1065 0%,#5b21b6 50%,#7c3aed 100%)"),
        ["admin"]      = ("Quản Trị Viên", "bi-shield-lock-fill",  "linear-gradient(145deg,#030712 0%,#111827 50%,#1f2937 100%)"),
    };
    if (!roles.TryGetValue(role, out var rMeta)) rMeta = roles["student"];
    var (rLabel, rIcon, rGrad) = rMeta;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Đặt Mật Khẩu Mới — Lumina Tutors</title>
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;800&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
    <style>
        *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
        html,body{height:100%;font-family:'Inter',sans-serif;-webkit-font-smoothing:antialiased}
        .wrap{display:grid;grid-template-columns:1fr 1fr;min-height:100vh}

        /* ── Left panel ── */
        .l-panel{
            position:relative;overflow:hidden;
            background:@rGrad;background-size:200% 200%;
            animation:bgFlow 14s ease infinite;
            display:flex;flex-direction:column;justify-content:space-between;padding:48px;
        }
        @@keyframes bgFlow{0%,100%{background-position:0% 50%}50%{background-position:100% 50%}}
        .l-panel::before{
            content:'';position:absolute;inset:0;
            background-image:
                linear-gradient(rgba(255,255,255,.04) 1px,transparent 1px),
                linear-gradient(90deg,rgba(255,255,255,.04) 1px,transparent 1px);
            background-size:48px 48px;
        }
        .l-panel::after{
            content:'';position:absolute;width:380px;height:380px;border-radius:50%;
            background:radial-gradient(circle,rgba(255,255,255,.08) 0%,transparent 70%);
            bottom:-80px;right:-60px;
        }
        .l-top{position:relative;z-index:1}
        .l-logo{
            font-family:'Playfair Display',serif;font-size:1.3rem;font-weight:800;
            color:rgba(255,255,255,.9);text-decoration:none;
            display:flex;align-items:center;gap:8px;margin-bottom:56px;
        }
        .l-logo-dot{width:7px;height:7px;border-radius:50%;background:rgba(255,255,255,.6)}
        .l-badge{
            display:inline-flex;align-items:center;gap:8px;
            background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.2);
            border-radius:99px;padding:6px 14px;
            font-size:.78rem;font-weight:600;color:rgba(255,255,255,.8);
            text-transform:uppercase;letter-spacing:.6px;margin-bottom:24px;
        }
        .l-title{
            font-family:'Playfair Display',serif;
            font-size:clamp(1.7rem,2.8vw,2.4rem);font-weight:800;
            color:#fff;line-height:1.2;margin-bottom:14px;
        }
        .l-sub{font-size:.9rem;color:rgba(255,255,255,.55);line-height:1.65;max-width:320px}
        .l-illus{position:relative;z-index:1;display:flex;justify-content:center;padding:28px 0}
        .illus-ring{
            width:140px;height:140px;border-radius:50%;
            border:2px solid rgba(255,255,255,.12);
            display:flex;align-items:center;justify-content:center;
            background:rgba(255,255,255,.06);position:relative;
        }
        .illus-ring::before{
            content:'';position:absolute;inset:-12px;border-radius:50%;
            border:1px solid rgba(255,255,255,.07);
        }
        .illus-icon{font-size:3.2rem;filter:drop-shadow(0 8px 24px rgba(0,0,0,.3))}

        /* Steps */
        .l-steps{position:relative;z-index:1;display:flex;flex-direction:column;gap:0}
        .l-step{display:flex;align-items:flex-start;gap:14px;padding-bottom:22px;position:relative}
        .l-step:last-child{padding-bottom:0}
        .l-step-line{position:absolute;left:14px;top:30px;width:2px;bottom:0;background:rgba(255,255,255,.15)}
        .l-step:last-child .l-step-line{display:none}
        .l-step-num{
            width:28px;height:28px;border-radius:50%;flex-shrink:0;
            display:flex;align-items:center;justify-content:center;
            font-size:.75rem;font-weight:700;
            border:2px solid rgba(255,255,255,.18);color:rgba(255,255,255,.35);
        }
        .l-step.done .l-step-num{background:rgba(255,255,255,.18);color:rgba(255,255,255,.8);border-color:rgba(255,255,255,.3)}
        .l-step.active .l-step-num{background:rgba(255,255,255,.92);color:#1e293b;border-color:transparent}
        .l-step-name{font-size:.82rem;font-weight:700;color:rgba(255,255,255,.9);padding-top:4px}
        .l-step:not(.active):not(.done) .l-step-name{color:rgba(255,255,255,.3)}
        .l-step-desc{font-size:.74rem;color:rgba(255,255,255,.4);margin-top:2px}
        .l-back{
            position:relative;z-index:1;display:inline-flex;align-items:center;gap:6px;
            font-size:.8rem;font-weight:500;color:rgba(255,255,255,.4);
            text-decoration:none;transition:color .2s;
        }
        .l-back:hover{color:rgba(255,255,255,.75)}

        /* ── Right panel ── */
        .r-panel{
            background:#fff;display:flex;flex-direction:column;
            align-items:center;justify-content:center;
            padding:48px 56px;position:relative;
        }
        .r-inner{width:100%;max-width:380px}

        .r-role-pill{
            display:inline-flex;align-items:center;gap:8px;
            background:#f8fafc;border:1px solid #e2e8f0;
            border-radius:99px;padding:6px 14px 6px 8px;margin-bottom:28px;
        }
        .r-role-icon{
            width:28px;height:28px;border-radius:50%;
            display:flex;align-items:center;justify-content:center;
            font-size:.8rem;color:#fff;background:var(--btn-color,#2563eb);
        }
        .r-role-name{font-size:.8rem;font-weight:600;color:#334155}

        .r-heading{font-size:1.55rem;font-weight:800;color:#0f172a;letter-spacing:-.4px;margin-bottom:6px}
        .r-sub{font-size:.875rem;color:#94a3b8;margin-bottom:30px;line-height:1.65}

        .form-field{margin-bottom:20px}
        .form-label{display:block;font-size:.8rem;font-weight:600;color:#374151;margin-bottom:6px}
        .pw-wrap{position:relative}
        .form-input{
            width:100%;height:48px;border-radius:10px;
            border:1.5px solid #e2e8f0;padding:0 44px 0 14px;
            font-size:.9375rem;font-family:inherit;color:#0f172a;
            background:#f8fafc;outline:none;
            transition:border-color .2s,box-shadow .2s,background .2s;
        }
        .form-input:focus{
            border-color:var(--focus-color,#3b82f6);
            box-shadow:0 0 0 3px var(--focus-shadow,rgba(59,130,246,.12));
            background:#fff;
        }
        .form-input.is-invalid{border-color:#ef4444;box-shadow:0 0 0 3px rgba(239,68,68,.1)}
        .pw-toggle{
            position:absolute;right:12px;top:50%;transform:translateY(-50%);
            background:none;border:none;cursor:pointer;
            color:#94a3b8;font-size:1rem;padding:4px;transition:color .15s;
        }
        .pw-toggle:hover{color:#475569}
        .form-error{font-size:.78rem;color:#ef4444;margin-top:5px;display:flex;align-items:center;gap:4px}

        /* Password strength */
        .strength-wrap{margin-top:8px}
        .strength-bars{display:flex;gap:4px;margin-bottom:5px}
        .strength-bar{
            flex:1;height:4px;border-radius:2px;background:#f1f5f9;
            transition:background .25s;
        }
        .strength-bar.s1{background:#ef4444}
        .strength-bar.s2{background:#f97316}
        .strength-bar.s3{background:#eab308}
        .strength-bar.s4{background:#22c55e}
        .strength-label{font-size:.72rem;font-weight:600;color:#94a3b8}
        .strength-label.s1{color:#ef4444}
        .strength-label.s2{color:#f97316}
        .strength-label.s3{color:#eab308}
        .strength-label.s4{color:#22c55e}

        /* Requirements */
        .pw-reqs{display:flex;flex-direction:column;gap:4px;margin-top:10px}
        .pw-req{
            display:flex;align-items:center;gap:6px;
            font-size:.75rem;color:#94a3b8;transition:color .2s;
        }
        .pw-req.ok{color:#16a34a}
        .pw-req .req-dot{
            width:6px;height:6px;border-radius:50%;
            background:#e2e8f0;flex-shrink:0;transition:background .2s;
        }
        .pw-req.ok .req-dot{background:#22c55e}

        .btn-submit{
            width:100%;height:50px;border:none;border-radius:10px;
            font-size:.9375rem;font-weight:700;color:#fff;
            background:var(--btn-color,#2563eb);
            box-shadow:0 4px 18px var(--btn-shadow,rgba(37,99,235,.35));
            cursor:pointer;display:flex;align-items:center;justify-content:center;gap:8px;
            transition:filter .2s,transform .15s;font-family:inherit;
            margin-top:24px;
        }
        .btn-submit:hover:not(:disabled){filter:brightness(1.08);transform:translateY(-1px)}
        .btn-submit:active:not(:disabled){transform:translateY(0)}
        .btn-submit:disabled{opacity:.55;cursor:not-allowed;transform:none;filter:none}

        .alert-error{
            background:#fef2f2;border:1px solid #fecaca;border-radius:10px;
            padding:12px 14px;font-size:.875rem;color:#dc2626;
            display:flex;align-items:center;gap:8px;margin-bottom:18px;
        }

        .back-to-login{margin-top:22px;font-size:.82rem;color:#94a3b8;text-align:center}
        .back-to-login a{color:var(--btn-color,#2563eb);font-weight:600;text-decoration:none;transition:opacity .15s}
        .back-to-login a:hover{opacity:.72;text-decoration:underline}

        /* Role colors */
        .role-student   {--btn-color:#2563eb;--btn-shadow:rgba(37,99,235,.35);--focus-color:#3b82f6;--focus-shadow:rgba(59,130,246,.12)}
        .role-teacher   {--btn-color:#059669;--btn-shadow:rgba(5,150,105,.35);--focus-color:#10b981;--focus-shadow:rgba(16,185,129,.12)}
        .role-supervisor{--btn-color:#d97706;--btn-shadow:rgba(217,119,6,.35);--focus-color:#f59e0b;--focus-shadow:rgba(245,158,11,.12)}
        .role-parent    {--btn-color:#7c3aed;--btn-shadow:rgba(124,58,237,.35);--focus-color:#8b5cf6;--focus-shadow:rgba(139,92,246,.12)}
        .role-admin     {--btn-color:#1f2937;--btn-shadow:rgba(31,41,55,.35);--focus-color:#374151;--focus-shadow:rgba(55,65,81,.12)}

        @@media(max-width:768px){
            .wrap{grid-template-columns:1fr}
            .l-panel{display:none}
            .r-panel{padding:40px 24px}
        }
    </style>
</head>
<body class="role-@role">
<div class="wrap">

    <!-- ═══════════ LEFT PANEL ═══════════ -->
    <div class="l-panel">
        <div class="l-top">
            <a href="/" class="l-logo">Lumina<span class="l-logo-dot"></span></a>
            <div class="l-badge"><i class="bi @rIcon"></i> @rLabel</div>
            <h1 class="l-title">Mật khẩu<br/>mới</h1>
            <p class="l-sub">Tạo mật khẩu mạnh để bảo vệ tài khoản của bạn. Đừng chia sẻ mật khẩu với bất kỳ ai.</p>
        </div>

        <div class="l-illus">
            <div class="illus-ring">
                <span class="illus-icon">✅</span>
            </div>
        </div>

        <div class="l-steps">
            <div class="l-step done">
                <div class="l-step-num"><i class="bi bi-check" style="font-size:.65rem"></i></div>
                <div class="l-step-line"></div>
                <div>
                    <div class="l-step-name">Nhập số điện thoại</div>
                    <div class="l-step-desc">Đã xác minh</div>
                </div>
            </div>
            <div class="l-step done">
                <div class="l-step-num"><i class="bi bi-check" style="font-size:.65rem"></i></div>
                <div class="l-step-line"></div>
                <div>
                    <div class="l-step-name">Xác thực mã OTP</div>
                    <div class="l-step-desc">Đã xác thực</div>
                </div>
            </div>
            <div class="l-step active">
                <div class="l-step-num">3</div>
                <div>
                    <div class="l-step-name">Đặt mật khẩu mới</div>
                    <div class="l-step-desc">Bước cuối cùng</div>
                </div>
            </div>
        </div>

        <a asp-controller="Auth" asp-action="Login" asp-route-role="@role" class="l-back">
            <i class="bi bi-arrow-left"></i> Quay lại đăng nhập
        </a>
    </div>

    <!-- ═══════════ RIGHT PANEL ═══════════ -->
    <div class="r-panel">
        <div class="r-inner">

            <div class="r-role-pill">
                <div class="r-role-icon"><i class="bi @rIcon" style="font-size:.75rem"></i></div>
                <span class="r-role-name">@rLabel</span>
            </div>

            <h2 class="r-heading">Đặt mật khẩu mới</h2>
            <p class="r-sub">Tạo mật khẩu mạnh — ít nhất 8 ký tự, bao gồm chữ hoa, số và ký tự đặc biệt.</p>

            @if (tempError is not null)
            {
                <div class="alert-error">
                    <i class="bi bi-exclamation-circle-fill"></i> @tempError
                </div>
            }
            @if (pwError is not null)
            {
                <div class="alert-error">
                    <i class="bi bi-exclamation-circle-fill"></i> @pwError
                </div>
            }

            <form method="post"
                  asp-controller="Auth" asp-action="ResetPassword"
                  asp-route-role="@role"
                  id="resetForm" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" name="token" value="@token"/>

                <div class="form-field">
                    <label for="newPassword" class="form-label">Mật khẩu mới</label>
                    <div class="pw-wrap">
                        <input type="password" id="newPassword" name="newPassword"
                               class="form-input"
                               placeholder="Tối thiểu 8 ký tự"
                               autocomplete="new-password"
                               autofocus
                               data-testid="input-new-password"/>
                        <button type="button" class="pw-toggle" onclick="togglePw('newPassword','eye1')" aria-label="Hiện/ẩn">
                            <i class="bi bi-eye" id="eye1"></i>
                        </button>
                    </div>
                    <!-- Strength meter -->
                    <div class="strength-wrap" id="strengthWrap" style="display:none">
                        <div class="strength-bars">
                            <div class="strength-bar" id="sb1"></div>
                            <div class="strength-bar" id="sb2"></div>
                            <div class="strength-bar" id="sb3"></div>
                            <div class="strength-bar" id="sb4"></div>
                        </div>
                        <div class="strength-label" id="strengthLabel"></div>
                    </div>
                    <!-- Requirements checklist -->
                    <div class="pw-reqs" id="pwReqs">
                        <div class="pw-req" id="req-len"><span class="req-dot"></span>Ít nhất 8 ký tự</div>
                        <div class="pw-req" id="req-upper"><span class="req-dot"></span>Có chữ in hoa (A–Z)</div>
                        <div class="pw-req" id="req-digit"><span class="req-dot"></span>Có chữ số (0–9)</div>
                        <div class="pw-req" id="req-special"><span class="req-dot"></span>Có ký tự đặc biệt (!@@#$…)</div>
                    </div>
                </div>

                <div class="form-field">
                    <label for="confirmPassword" class="form-label">Xác nhận mật khẩu</label>
                    <div class="pw-wrap">
                        <input type="password" id="confirmPassword" name="confirmPassword"
                               class="form-input"
                               placeholder="Nhập lại mật khẩu"
                               autocomplete="new-password"
                               data-testid="input-confirm-password"/>
                        <button type="button" class="pw-toggle" onclick="togglePw('confirmPassword','eye2')" aria-label="Hiện/ẩn">
                            <i class="bi bi-eye" id="eye2"></i>
                        </button>
                    </div>
                    <div class="form-error" id="matchErr" style="display:none">
                        <i class="bi bi-exclamation-circle"></i> Mật khẩu không khớp.
                    </div>
                </div>

                <button type="submit" class="btn-submit" id="btnReset" data-testid="btn-reset">
                    <i class="bi bi-check-circle-fill" id="resetIcon"></i>
                    <span id="resetText">Đặt mật khẩu mới</span>
                </button>
            </form>

            <div class="back-to-login">
                <a asp-controller="Auth" asp-action="Login" asp-route-role="@role">
                    <i class="bi bi-arrow-left"></i> Quay lại đăng nhập
                </a>
            </div>
        </div>
    </div>

</div>
<script>
function togglePw(id, eyeId) {
    var inp  = document.getElementById(id);
    var eye  = document.getElementById(eyeId);
    inp.type = inp.type === 'password' ? 'text' : 'password';
    eye.className = inp.type === 'password' ? 'bi bi-eye' : 'bi bi-eye-slash';
}

(function () {
    var pw      = document.getElementById('newPassword');
    var conf    = document.getElementById('confirmPassword');
    var matchEl = document.getElementById('matchErr');
    var btn     = document.getElementById('btnReset');
    var ico     = document.getElementById('resetIcon');
    var txt     = document.getElementById('resetText');
    var sw      = document.getElementById('strengthWrap');
    var sl      = document.getElementById('strengthLabel');
    var bars    = [1,2,3,4].map(function(i){ return document.getElementById('sb'+i) });

    var reqs = {
        len:     document.getElementById('req-len'),
        upper:   document.getElementById('req-upper'),
        digit:   document.getElementById('req-digit'),
        special: document.getElementById('req-special'),
    };

    var strengthNames = ['','Yếu','Trung bình','Khá mạnh','Mạnh'];
    var strengthClasses = ['','s1','s2','s3','s4'];

    function calcStrength(v) {
        var s = 0;
        if (v.length >= 8)           s++;
        if (/[A-Z]/.test(v))         s++;
        if (/[0-9]/.test(v))         s++;
        if (/[^A-Za-z0-9]/.test(v))  s++;
        return s;
    }

    pw.addEventListener('input', function () {
        var v = this.value;

        // Show/hide strength
        sw.style.display = v ? 'block' : 'none';

        // Update reqs
        reqs.len.classList.toggle('ok',     v.length >= 8);
        reqs.upper.classList.toggle('ok',   /[A-Z]/.test(v));
        reqs.digit.classList.toggle('ok',   /[0-9]/.test(v));
        reqs.special.classList.toggle('ok', /[^A-Za-z0-9]/.test(v));

        // Update bars
        var score = calcStrength(v);
        bars.forEach(function(b, i) {
            b.className = 'strength-bar';
            if (i < score) b.classList.add(strengthClasses[score]);
        });
        sl.className = 'strength-label' + (score ? ' ' + strengthClasses[score] : '');
        sl.textContent = v ? strengthNames[score] : '';

        checkMatch();
    });

    conf.addEventListener('input', checkMatch);

    function checkMatch() {
        var mismatch = conf.value && pw.value !== conf.value;
        matchEl.style.display = mismatch ? 'flex' : 'none';
        conf.classList.toggle('is-invalid', !!mismatch);
    }

    document.getElementById('resetForm').addEventListener('submit', function (e) {
        if (pw.value !== conf.value) {
            e.preventDefault();
            matchEl.style.display = 'flex';
            conf.classList.add('is-invalid');
            return;
        }
        btn.disabled = true;
        ico.className = 'bi bi-hourglass-split';
        txt.textContent = 'Đang cập nhật…';
    });
})();
</script>
</body>
</html>
