@model LuminaTutors.Application.DTOs.Auth.LoginRequest
@{
    Layout = null;
    string role = (ViewBag.Role as string ?? "student").ToLower();

    // Role → (display name, icon, accent hex, aurora color 1, aurora color 2, aurora color 3)
    var rm = new Dictionary<string, (string Label, string Icon, string Accent, string A1, string A2, string A3)>
    {
        ["student"]    = ("Học Sinh",      "bi-mortarboard-fill",  "#3b82f6", "#1e3a8a", "#4f46e5", "#60a5fa"),
        ["teacher"]    = ("Giáo Viên",     "bi-person-video3",     "#10b981", "#064e3b", "#065f46", "#34d399"),
        ["supervisor"] = ("Giám Thị",      "bi-shield-fill",       "#f59e0b", "#78350f", "#92400e", "#fcd34d"),
        ["parent"]     = ("Phụ Huynh",     "bi-people-fill",       "#8b5cf6", "#4c1d95", "#5b21b6", "#a78bfa"),
        ["admin"]      = ("Quản Trị Viên", "bi-shield-lock-fill",  "#94a3b8", "#0f172a", "#1e293b", "#cbd5e1"),
    };
    if (!rm.ContainsKey(role)) role = "student";
    var (rLabel, rIcon, rAccent, rA1, rA2, rA3) = rm[role];

    bool hasError  = !ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Count > 0);
    string? successMsg = TempData["Success"] as string;
    ViewData["Title"] = $"Đăng nhập — {rLabel}";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] — Lumina Tutors</title>
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;800&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
    <style>
/* ══════════════════════════════════════════════════════════════════
   RESET + BASE
══════════════════════════════════════════════════════════════════ */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { height: 100%; }
body {
    min-height: 100%; font-family: 'Inter', sans-serif;
    -webkit-font-smoothing: antialiased;
    background: radial-gradient(ellipse 130% 90% at 25% 15%,
        #0d1840 0%, #060c20 45%, #020408 100%);
    overflow-x: hidden;
}

/* ══════════════════════════════════════════════════════════════════
   STAR CANVAS
══════════════════════════════════════════════════════════════════ */
#starCanvas {
    position: fixed; inset: 0; width: 100%; height: 100%;
    pointer-events: none; z-index: 0;
}

/* ══════════════════════════════════════════════════════════════════
   AURORA
══════════════════════════════════════════════════════════════════ */
.aurora {
    position: fixed; top: 0; left: 0; right: 0; height: 60vh;
    pointer-events: none; z-index: 1;
}
.ab {
    position: absolute; inset: 0; filter: blur(38px);
    animation: auroraWave var(--dur,10s) ease-in-out infinite alternate var(--del,0s);
}
.ab1 {
    background:
        radial-gradient(ellipse 85% 55% at 15% -10%, @rA1 + "cc" 0%, transparent 65%),
        radial-gradient(ellipse 60% 40% at 88% 5%,  @rA2 + "88" 0%, transparent 65%);
    --dur: 9s; --del: 0s;
}
.ab2 {
    background:
        radial-gradient(ellipse 55% 38% at 55% -8%, @rA3 + "55" 0%, transparent 68%),
        radial-gradient(ellipse 40% 28% at 28% 15%, rgba(79,172,254,0.20) 0%, transparent 68%);
    --dur: 14s; --del: -4.5s;
}
.ab3 {
    background:
        radial-gradient(ellipse 42% 28% at 72% 5%, rgba(168,85,247,0.14) 0%, transparent 72%),
        radial-gradient(ellipse 30% 22% at 10% 8%,  rgba(34,211,238,0.12) 0%, transparent 70%);
    --dur: 19s; --del: -8s;
}
@@keyframes auroraWave {
    0%   { transform: translateX(-5%) scaleY(0.95) rotate(-1.2deg); opacity: 0.65; }
    100% { transform: translateX( 5%) scaleY(1.22) rotate( 1.2deg); opacity: 1.00; }
}

/* ══════════════════════════════════════════════════════════════════
   MOON
══════════════════════════════════════════════════════════════════ */
.moon {
    position: fixed; top: 44px; right: 72px;
    width: 74px; height: 74px; border-radius: 50%;
    background: radial-gradient(circle at 36% 34%, #fff9e6 0%, #ffe97e 55%, #f0c030 100%);
    box-shadow:
        0 0 0  10px rgba(255,240,120,.10),
        0 0 0  24px rgba(255,240,100,.06),
        0 0 60px 14px rgba(255,230,80,.22);
    z-index: 2; pointer-events: none;
    animation: moonPulse 5s ease-in-out infinite alternate;
}
.moon::after {
    content: ''; position: absolute;
    width: 20px; height: 20px; border-radius: 50%;
    background: rgba(250,230,120,.2);
    top: 14px; right: 16px;
}
@@keyframes moonPulse {
    0%   { box-shadow: 0 0 0 10px rgba(255,240,120,.10), 0 0 0 24px rgba(255,240,100,.06), 0 0 60px 14px rgba(255,230,80,.22); }
    100% { box-shadow: 0 0 0 14px rgba(255,240,120,.14), 0 0 0 32px rgba(255,240,100,.08), 0 0 80px 20px rgba(255,230,80,.28); }
}

/* ══════════════════════════════════════════════════════════════════
   FIREFLIES
══════════════════════════════════════════════════════════════════ */
.ff {
    position: fixed; width: 4px; height: 4px; border-radius: 50%;
    background: rgba(255,255,170,.9);
    box-shadow: 0 0 6px 3px rgba(255,255,100,.55), 0 0 14px 5px rgba(255,255,60,.18);
    pointer-events: none; z-index: 2;
    animation: ffDrift var(--d,5s) ease-in-out infinite var(--del,0s) alternate;
}
@@keyframes ffDrift {
    0%   { transform: translate(0,0) scale(1);     opacity: .18; }
    35%  { opacity: .95; }
    65%  { opacity: .90; }
    100% { transform: translate(var(--dx,20px),var(--dy,-24px)) scale(0.7); opacity: .15; }
}

/* ══════════════════════════════════════════════════════════════════
   TREE SILHOUETTE
══════════════════════════════════════════════════════════════════ */
.trees {
    position: fixed; bottom: 0; left: 0;
    width: 100%; height: 160px;
    pointer-events: none; z-index: 3;
}

/* ══════════════════════════════════════════════════════════════════
   SCENE LAYOUT
══════════════════════════════════════════════════════════════════ */
.scene {
    position: relative; z-index: 10;
    min-height: 100vh;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    padding: 24px 16px 140px;
}

/* Brand */
.brand {
    font-family: 'Playfair Display', serif;
    font-size: 1.22rem; font-weight: 800; letter-spacing: .4px;
    color: rgba(255,255,255,.8); text-decoration: none;
    display: flex; align-items: center; gap: 4px;
    margin-bottom: 14px;
    animation: fadeDown .6s ease both;
}
.brand-sep { color: @rAccent; font-size: 1.5rem; line-height: .8; }
@@keyframes fadeDown {
    from { opacity: 0; transform: translateY(-12px); }
    to   { opacity: 1; transform: translateY(0); }
}

/* ══════════════════════════════════════════════════════════════════
   OWL CHARACTER
══════════════════════════════════════════════════════════════════ */
.owl-stage {
    width: 190px; height: 190px;
    display: flex; align-items: flex-end; justify-content: center;
    margin-bottom: -16px;
    position: relative; z-index: 12;
    animation: owlIdle 3.4s ease-in-out infinite;
    transform-origin: bottom center;
    will-change: transform;
}
@@keyframes owlIdle {
    0%,100% { transform: translateY(0px)   rotate( 0.0deg); }
    25%      { transform: translateY(-8px)  rotate( 0.9deg); }
    75%      { transform: translateY(-5px)  rotate(-0.6deg); }
}
@@keyframes owlBounceKey {
    0%   { transform: translateY(0) scale(1);    }
    35%  { transform: translateY(-7px) scale(1.05); }
    75%  { transform: translateY(1px) scale(0.97); }
    100% { transform: translateY(0) scale(1);    }
}
@@keyframes owlShake {
    0%,100% { transform: translateX(0) rotate(0);     }
    18%     { transform: translateX(-10px) rotate(-5deg); }
    36%     { transform: translateX( 10px) rotate( 5deg); }
    54%     { transform: translateX(-7px)  rotate(-3deg); }
    72%     { transform: translateX( 7px)  rotate( 3deg); }
}
@@keyframes owlSuccess {
    0%   { transform: translateY(0)    rotate(0)   scale(1);    }
    28%  { transform: translateY(-32px) rotate(-9deg) scale(1.12); }
    55%  { transform: translateY(-20px) rotate( 9deg) scale(1.09); }
    80%  { transform: translateY(-5px)  rotate(-2deg) scale(1.02); }
    100% { transform: translateY(0)    rotate(0)   scale(1);    }
}
.owl-stage.bounce  { animation: owlBounceKey .22s ease !important; }
.owl-stage.shake   { animation: owlShake  .52s ease !important; }
.owl-stage.success { animation: owlSuccess .65s cubic-bezier(.34,1.56,.64,1) !important; }

/* SVG internal transitions */
#pawLGrp, #pawRGrp {
    transition: transform .5s cubic-bezier(.34,1.56,.64,1);
}
#irisLGrp, #irisRGrp {
    transition: transform .28s cubic-bezier(.34,1.56,.64,1);
}
#blushL, #blushR {
    transition: fill-opacity .4s ease, fill .3s ease;
}
#browL, #browR {
    transition: transform .3s ease;
    transform-box: fill-box; transform-origin: center;
}

/* ══════════════════════════════════════════════════════════════════
   GLASS CARD
══════════════════════════════════════════════════════════════════ */
.glass-card {
    width: 100%; max-width: 408px;
    background: rgba(8, 12, 32, 0.78);
    backdrop-filter: blur(32px) saturate(1.6);
    -webkit-backdrop-filter: blur(32px) saturate(1.6);
    border: 1px solid rgba(255,255,255,.10);
    border-radius: 26px;
    padding: 32px 38px 30px;
    position: relative;
    box-shadow:
        0 0 0 1px rgba(255,255,255,.04) inset,
        0 8px 80px rgba(0,0,0,.55),
        0 0 48px @rAccent + "1a";
    animation: cardUp .65s cubic-bezier(.34,1.56,.64,1) both .1s;
}
/* Top accent line */
.glass-card::before {
    content: ''; position: absolute;
    top: 0; left: 8%; right: 8%; height: 2px;
    border-radius: 0 0 2px 2px;
    background: linear-gradient(90deg, transparent, @rAccent, transparent);
    opacity: .85;
}
/* Subtle inner glow */
.glass-card::after {
    content: ''; position: absolute; inset: 0;
    border-radius: inherit;
    background: radial-gradient(ellipse 70% 40% at 50% 0%, @rAccent + "0e", transparent 70%);
    pointer-events: none;
}
@@keyframes cardUp {
    from { opacity: 0; transform: translateY(28px) scale(.95); }
    to   { opacity: 1; transform: translateY(0)    scale(1);   }
}

/* Role pill */
.role-pill {
    display: inline-flex; align-items: center; gap: 8px;
    background: rgba(255,255,255,.07); border: 1px solid rgba(255,255,255,.13);
    border-radius: 99px; padding: 5px 13px 5px 7px;
    margin-bottom: 20px;
}
.rp-icon {
    width: 24px; height: 24px; border-radius: 50%;
    background: @rAccent;
    display: flex; align-items: center; justify-content: center;
    font-size: .65rem; color: #fff;
    box-shadow: 0 2px 8px @rAccent + "55";
}
.rp-name  { font-size: .78rem; font-weight: 600; color: rgba(255,255,255,.85); }
.rp-change {
    font-size: .72rem; color: rgba(255,255,255,.30); text-decoration: none;
    margin-left: 2px; transition: color .15s;
}
.rp-change:hover { color: @rAccent; }

.card-title { font-size: 1.55rem; font-weight: 800; color: #fff; letter-spacing: -.5px; margin-bottom: 4px; }
.card-sub   { font-size: .82rem; color: rgba(255,255,255,.38); margin-bottom: 26px; }

/* Alerts */
.alert {
    border-radius: 10px; padding: 11px 14px; font-size: .83rem;
    display: flex; align-items: flex-start; gap: 8px; margin-bottom: 18px; line-height: 1.5;
}
.alert i { margin-top: 1px; flex-shrink: 0; }
.alert-error   { background: rgba(239,68,68,.12); border: 1px solid rgba(239,68,68,.28); color: #fca5a5; }
.alert-success { background: rgba(34,197,94,.10);  border: 1px solid rgba(34,197,94,.28); color: #86efac; }

/* Form */
.field { margin-bottom: 16px; }
.flabel {
    display: block; font-size: .73rem; font-weight: 700; letter-spacing: .8px;
    color: rgba(255,255,255,.38); margin-bottom: 7px; text-transform: uppercase;
}
.finput {
    width: 100%; height: 48px; border-radius: 11px;
    border: 1.5px solid rgba(255,255,255,.09);
    padding: 0 14px;
    font-size: .9375rem; font-family: inherit; color: #fff;
    background: rgba(255,255,255,.055);
    outline: none;
    transition: border-color .2s, box-shadow .2s, background .2s;
    caret-color: @rAccent;
}
.finput::placeholder { color: rgba(255,255,255,.2); }
.finput:focus {
    border-color: @rAccent;
    box-shadow: 0 0 0 3px @rAccent + "2a";
    background: rgba(255,255,255,.085);
}
.finput.invalid { border-color: rgba(239,68,68,.65); }
.pw-wrap { position: relative; }
.pw-toggle {
    position: absolute; right: 12px; top: 50%; transform: translateY(-50%);
    background: none; border: none; cursor: pointer;
    color: rgba(255,255,255,.28); font-size: .95rem; padding: 4px;
    transition: color .15s;
}
.pw-toggle:hover { color: rgba(255,255,255,.75); }
.ferr { font-size: .74rem; color: #fca5a5; margin-top: 4px; display: flex; align-items: center; gap: 4px; }

/* Row: remember + forgot */
.form-row {
    display: flex; justify-content: space-between; align-items: center;
    margin-bottom: 22px;
}
.remember {
    display: flex; align-items: center; gap: 7px;
    font-size: .79rem; color: rgba(255,255,255,.38); cursor: pointer;
}
.remember input { width: 14px; height: 14px; accent-color: @rAccent; cursor: pointer; }
.forgot-link {
    font-size: .79rem; font-weight: 600; color: @rAccent;
    text-decoration: none; transition: opacity .15s;
}
.forgot-link:hover { opacity: .7; text-decoration: underline; }

/* Submit button — vivid amber/gold so it pops on every dark glass card */
.btn-login {
    width: 100%; height: 50px; border: none; border-radius: 12px;
    font-size: .9375rem; font-weight: 800; color: #1a0f00;
    background: linear-gradient(135deg, #fde68a 0%, #fbbf24 40%, #f59e0b 100%);
    box-shadow: 0 4px 28px rgba(251,191,36,.55), 0 1px 0 rgba(255,255,255,.25) inset;
    cursor: pointer;
    display: flex; align-items: center; justify-content: center; gap: 9px;
    transition: filter .2s, transform .15s, box-shadow .2s;
    font-family: inherit; position: relative; overflow: hidden;
    letter-spacing: .3px;
}
.btn-login::before {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(to bottom, rgba(255,255,255,.28), transparent 55%);
    border-radius: inherit;
}
.btn-login:hover  { filter: brightness(1.08); transform: translateY(-2px); box-shadow: 0 10px 40px rgba(251,191,36,.75), 0 1px 0 rgba(255,255,255,.25) inset; }
.btn-login:active { transform: translateY(0); filter: brightness(.97); }
.btn-login:disabled { opacity: .55; cursor: not-allowed; transform: none; }

/* Card footer */
.card-foot {
    font-size: .76rem; color: rgba(255,255,255,.22); text-align: center; margin-top: 22px; line-height: 1.65;
}

/* Change role */
.change-role-link {
    margin-top: 18px; font-size: .8rem;
    color: rgba(255,255,255,.28); text-decoration: none;
    display: flex; align-items: center; gap: 6px;
    transition: color .2s;
    animation: fadeDown .6s ease both .3s;
}
.change-role-link:hover { color: rgba(255,255,255,.65); }

/* ══════════════════════════════════════════════════════════════════
   SPARKLES (success)
══════════════════════════════════════════════════════════════════ */
.sparkle {
    position: absolute; width: 6px; height: 6px; border-radius: 50%;
    background: @rAccent; pointer-events: none;
    opacity: 0;
}
@@keyframes sparkleAnim {
    0%   { transform: translate(0,0) scale(1);   opacity: 1; }
    100% { transform: translate(var(--sx),var(--sy)) scale(0); opacity: 0; }
}

/* ══════════════════════════════════════════════════════════════════
   RESPONSIVE
══════════════════════════════════════════════════════════════════ */
@@media (max-width: 480px) {
    .glass-card { padding: 28px 22px 26px; border-radius: 22px; }
    .owl-stage  { width: 158px; height: 158px; }
    .card-title { font-size: 1.35rem; }
    .moon { width: 54px; height: 54px; top: 20px; right: 20px; }
}
@@media (max-height: 680px) {
    .owl-stage  { width: 124px; height: 124px; margin-bottom: -10px; }
    .brand { margin-bottom: 8px; font-size: 1rem; }
}
    </style>
</head>
<body>

<!-- ══════════ BACKGROUND LAYERS ══════════════════════════════════ -->
<canvas id="starCanvas"></canvas>
<div class="aurora">
    <div class="ab ab1"></div>
    <div class="ab ab2"></div>
    <div class="ab ab3"></div>
</div>
<div class="moon"></div>

<!-- Fireflies -->
<div class="ff" style="left:7%;top:22%;--d:4.4s;--del:-1.2s;--dx:24px;--dy:-20px"></div>
<div class="ff" style="left:14%;top:54%;--d:5.9s;--del:-2.8s;--dx:-16px;--dy:-27px"></div>
<div class="ff" style="left:21%;top:33%;--d:6.8s;--del: 0.2s;--dx:14px;--dy:-18px"></div>
<div class="ff" style="left:79%;top:26%;--d:4.9s;--del:-3.1s;--dx:-22px;--dy:-14px"></div>
<div class="ff" style="left:86%;top:49%;--d:7.4s;--del:-1.5s;--dx:10px;--dy:-30px"></div>
<div class="ff" style="left:93%;top:37%;--d:5.2s;--del:-4.2s;--dx:-20px;--dy:-10px"></div>
<div class="ff" style="left:5%;top:67%;--d:6.6s;--del:-0.6s;--dx:26px;--dy:-22px"></div>
<div class="ff" style="left:36%;top:18%;--d:4.6s;--del:-2.2s;--dx:-12px;--dy:-20px"></div>
<div class="ff" style="left:64%;top:17%;--d:5.7s;--del:-3.6s;--dx:16px;--dy:-17px"></div>
<div class="ff" style="left:49%;top:61%;--d:8.1s;--del:-1.9s;--dx:-24px;--dy:-13px"></div>
<div class="ff" style="left:73%;top:64%;--d:5.0s;--del:-0.9s;--dx:20px;--dy:-26px"></div>
<div class="ff" style="left:27%;top:71%;--d:6.3s;--del:-3.4s;--dx:-13px;--dy:-19px"></div>
<div class="ff" style="left:55%;top:42%;--d:4.2s;--del:-5.0s;--dx:18px;--dy:-15px"></div>

<!-- ══════════ MAIN SCENE ══════════════════════════════════════════ -->
<main class="scene">

    <!-- Brand logo -->
    <a href="/" class="brand">Lumina<span class="brand-sep">·</span>Tutors</a>

    <!-- ══ ROLE CHARACTER ════════════════════════════════════════ -->
    <!-- ALL 5 characters use identical structural frame as the original owl:
         Head: circle cx=100,cy=90,r=56  |  Body: ellipse cx=100,cy=168,rx=56,ry=56
         Paw palms: L=(42,120) R=(158,120) |  Eye whites: L=(78,87) R=(122,87)
         Animal-specific ears drawn BEFORE head → head naturally covers ear bases.
         Face markings kept low-opacity/same-color-family so face + body read as one creature. -->
    <div class="owl-stage" id="owlStage">

@if (role == "student") {
        <!-- ── STUDENT: Ginger cat — curious, book-loving ──────── -->
        <!-- Fix: ears drawn BEFORE head so head naturally covers bases;
                  head r=56 and body rx=56,ry=56 match the standard owl frame.
                  Muzzle area removed — face is solid ginger so head+body are one unified color. -->
        <svg id="owlSvg" viewBox="0 0 200 230" width="185" height="213"
             xmlns="http://www.w3.org/2000/svg" overflow="visible">
            <!-- Branch -->
            <path d="M5,216 Q60,208 100,210 Q140,208 195,216" stroke="#3d2008" stroke-width="13" fill="none" stroke-linecap="round"/>
            <path d="M5,216 Q60,208 100,210 Q140,208 195,216" stroke="#5a3215" stroke-width="7"  fill="none" stroke-linecap="round"/>
            <!-- Feet -->
            <g stroke-linecap="round" fill="none" stroke="#c87820" stroke-width="3.5">
                <path d="M74,212 L67,222 M74,212 L74,223 M74,212 L81,222"/>
                <path d="M126,212 L119,222 M126,212 L126,223 M126,212 L133,222"/>
            </g>
            <!-- Body (ginger — same color as head for visual unity) -->
            <ellipse cx="100" cy="168" rx="56" ry="56" fill="#d97830"/>
            <ellipse cx="100" cy="178" rx="32" ry="40" fill="#f0c88a" opacity=".55"/>
            <!-- Tail -->
            <path d="M150,183 Q186,188 190,164 Q192,148 174,144" stroke="#d97830" stroke-width="13" fill="none" stroke-linecap="round"/>
            <path d="M174,144 Q168,140 164,145" fill="none" stroke="#e8c090" stroke-width="3" stroke-linecap="round"/>
            <!-- Backpack straps (student-blue accent) -->
            <path d="M88,124 Q86,150 84,172" stroke="#3b82f6" stroke-width="3.5" fill="none" stroke-linecap="round" opacity=".7"/>
            <path d="M112,124 Q114,150 116,172" stroke="#3b82f6" stroke-width="3.5" fill="none" stroke-linecap="round" opacity=".7"/>
            <rect x="85" y="150" width="30" height="4" rx="2" fill="#3b82f6" opacity=".5"/>
            <!-- Left paw (holding open book) -->
            <g id="pawLGrp">
                <path d="M52,130 Q46,142 44,158" stroke="#c4682c" stroke-width="15" fill="none" stroke-linecap="round"/>
                <ellipse cx="42" cy="120" rx="16" ry="12" fill="#c4682c"/>
                <circle cx="29" cy="128" r="8.5" fill="#c4682c"/>
                <circle cx="42" cy="132" r="8.5" fill="#c4682c"/>
                <circle cx="55" cy="128" r="8.5" fill="#c4682c"/>
