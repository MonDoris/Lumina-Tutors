            <path id="browL" d="M64,65 Q78,59 93,64"   stroke="#c4a098" stroke-width="3"   fill="none" stroke-linecap="round"/>
            <path id="browR" d="M107,64 Q122,59 136,65" stroke="#c4a098" stroke-width="3"   fill="none" stroke-linecap="round"/>
            <!-- Small pink nose -->
            <ellipse cx="100" cy="104" rx="6" ry="4" fill="#f4b8c0"/>
            <!-- Gentle smile -->
            <path d="M94,109 Q100,115 106,109" stroke="#d4baa8" stroke-width="2" fill="none" stroke-linecap="round"/>
            <!-- Blush -->
            <circle id="blushL" cx="56" cy="97" r="14" fill="#ff6b80" fill-opacity="0"/>
            <circle id="blushR" cx="144" cy="97" r="14" fill="#ff6b80" fill-opacity="0"/>
        </svg>

} else {
        <!-- ── ADMIN: Smart raccoon with gear ────────────────────── -->
        <!-- Fix: ears drawn BEFORE head; body standardized to rx=56,ry=56.
                  The heavy near-black mask patches (opacity=.82) replaced with a single
                  subtle connected band (opacity=.4, slightly darker gray) — raccoon markings
                  now read as natural fur shading rather than a pasted-on face. -->
        <svg id="owlSvg" viewBox="0 0 200 230" width="185" height="213"
             xmlns="http://www.w3.org/2000/svg" overflow="visible">
            <!-- Branch -->
            <path d="M5,216 Q60,208 100,210 Q140,208 195,216" stroke="#3d2008" stroke-width="13" fill="none" stroke-linecap="round"/>
            <path d="M5,216 Q60,208 100,210 Q140,208 195,216" stroke="#5a3215" stroke-width="7"  fill="none" stroke-linecap="round"/>
            <!-- Feet -->
            <g stroke-linecap="round" fill="none" stroke="#c87820" stroke-width="3.5">
                <path d="M74,212 L67,222 M74,212 L74,223 M74,212 L81,222"/>
                <path d="M126,212 L119,222 M126,212 L126,223 M126,212 L133,222"/>
            </g>
            <!-- Body (gray — same color as head for visual unity) -->
            <ellipse cx="100" cy="168" rx="56" ry="56" fill="#64748b"/>
            <ellipse cx="100" cy="178" rx="34" ry="44" fill="#8294a8" opacity=".5"/>
            <!-- Ringed tail -->
            <path d="M150,183 Q186,188 190,162 Q192,144 174,140" stroke="#8294a8" stroke-width="14" fill="none" stroke-linecap="round"/>
            <path d="M150,183 Q186,188 190,162 Q192,144 174,140" stroke="#334155" stroke-width="6"  fill="none" stroke-linecap="round" stroke-dasharray="11,9"/>
            <!-- Left paw -->
            <g id="pawLGrp">
                <path d="M50,128 Q44,140 42,158" stroke="#475569" stroke-width="15" fill="none" stroke-linecap="round"/>
                <ellipse cx="42" cy="120" rx="16" ry="12" fill="#475569"/>
                <circle cx="28" cy="128" r="8.5" fill="#475569"/>
                <circle cx="42" cy="132" r="8.5" fill="#475569"/>
                <circle cx="56" cy="128" r="8.5" fill="#475569"/>
            </g>
            <!-- Right paw (holding gear) -->
            <g id="pawRGrp">
                <path d="M150,128 Q156,140 158,158" stroke="#475569" stroke-width="15" fill="none" stroke-linecap="round"/>
                <ellipse cx="158" cy="120" rx="16" ry="12" fill="#475569"/>
                <circle cx="144" cy="128" r="8.5" fill="#475569"/>
                <circle cx="158" cy="132" r="8.5" fill="#475569"/>
                <circle cx="172" cy="128" r="8.5" fill="#475569"/>
                <!-- Gear icon -->
                <circle cx="170" cy="105" r="18" fill="none" stroke="#8294a8" stroke-width="5" stroke-dasharray="7,4"/>
                <circle cx="170" cy="105" r="14" fill="#64748b"/>
                <circle cx="170" cy="105" r="8"  fill="#475569"/>
                <circle cx="170" cy="105" r="4.5" fill="#334155"/>
            </g>
            <!-- Raccoon ears — drawn BEFORE head so head covers their bases naturally -->
            <path d="M70,44 L58,16 L88,42 Z" fill="#64748b"/>
            <path d="M130,44 L142,16 L112,42 Z" fill="#64748b"/>
            <!-- Head (r=56 matching owl frame; same gray as body → seamless) -->
            <circle cx="100" cy="90" r="56" fill="#64748b"/>
            <!-- Dark inner ears (drawn after head, overlapping ear triangle bases) -->
            <path d="M71,44 L62,22 L85,43 Z" fill="#334155" opacity=".75"/>
            <path d="M129,44 L138,22 L115,43 Z" fill="#334155" opacity=".75"/>
            <!-- Raccoon mask — ONE connected band, same gray family, low opacity.
                 This reads as natural fur coloring rather than a pasted-on mask. -->
            <path d="M46,80 Q58,66 78,70 Q92,74 100,74 Q108,74 122,70 Q142,66 154,80
                     Q156,96 140,102 Q122,106 100,106 Q78,106 60,102 Q44,96 46,80 Z"
                  fill="#394f65" opacity=".42"/>
            <!-- Muzzle area (barely visible same-tone highlight) -->
            <ellipse cx="100" cy="104" rx="26" ry="18" fill="#7a8898" opacity=".22"/>
            <!-- Eye whites (on top of mask band) -->
            <circle cx="78"  cy="87" r="20" fill="#fff"/>
            <circle cx="122" cy="87" r="20" fill="#fff"/>
            <!-- Irises (silver-gray, sharp) -->
            <g id="irisLGrp">
                <circle cx="78" cy="87" r="12.5" fill="#475569"/>
                <circle cx="78" cy="87" r="7"    fill="#0f172a"/>
                <circle cx="84" cy="81" r="4.5"  fill="#fff"/>
                <circle cx="81" cy="86" r="2"    fill="rgba(255,255,255,.55)"/>
            </g>
            <g id="irisRGrp">
                <circle cx="122" cy="87" r="12.5" fill="#475569"/>
                <circle cx="122" cy="87" r="7"    fill="#0f172a"/>
                <circle cx="128" cy="81" r="4.5"  fill="#fff"/>
                <circle cx="125" cy="86" r="2"    fill="rgba(255,255,255,.55)"/>
            </g>
            <!-- Eyebrows (clever, arched) -->
            <path id="browL" d="M62,64 Q78,57 93,63"   stroke="#334155" stroke-width="4" fill="none" stroke-linecap="round"/>
            <path id="browR" d="M107,63 Q122,57 138,64" stroke="#334155" stroke-width="4" fill="none" stroke-linecap="round"/>
            <!-- Raccoon nose -->
            <ellipse cx="100" cy="106" rx="10" ry="7" fill="#1e293b"/>
            <ellipse cx="97"  cy="104" rx="3"  ry="2" fill="rgba(255,255,255,.18)"/>
            <!-- Mouth -->
            <path d="M94,113 Q100,109 106,113" stroke="#475569" stroke-width="2" fill="none" stroke-linecap="round"/>
            <!-- Blush -->
            <circle id="blushL" cx="54" cy="97" r="15" fill="#ff6b80" fill-opacity="0"/>
            <circle id="blushR" cx="146" cy="97" r="15" fill="#ff6b80" fill-opacity="0"/>
        </svg>
}
    </div>

    <!-- ══ SPARKLE CONTAINER ══════════════════════════════════ -->
    <div id="sparkleContainer" style="position:fixed;inset:0;pointer-events:none;z-index:20;overflow:hidden;"></div>

    <!-- ══ GLASS CARD ══════════════════════════════════════════ -->
    <div class="glass-card" id="loginCard">

        <!-- Role pill -->
        <div class="role-pill">
            <div class="rp-icon"><i class="bi @rIcon" style="font-size:.65rem"></i></div>
            <span class="rp-name">@rLabel</span>
            <a asp-controller="Auth" asp-action="SelectRole" class="rp-change" data-testid="change-role">
                · Đổi vai trò
            </a>
        </div>

        <h1 class="card-title">Chào mừng trở lại!</h1>
        <p class="card-sub">Đăng nhập vào tài khoản @rLabel của bạn</p>

        @if (successMsg is not null)
        {
            <div class="alert alert-success">
                <i class="bi bi-check-circle-fill"></i>
                <span>@successMsg</span>
            </div>
        }
        @if (hasError)
        {
            <div class="alert alert-error" id="errorAlert" role="alert" data-testid="login-error">
                <i class="bi bi-exclamation-circle-fill"></i>
                @Html.ValidationSummary(true, "", new { @class = "m-0 p-0", style = "list-style:none" })
            </div>
        }

        <form asp-controller="Auth" asp-action="Login" method="post"
              asp-route-returnUrl="@ViewData["ReturnUrl"]"
              id="loginForm" data-testid="login-form" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" name="role" value="@role"/>

            <div class="field">
                <label asp-for="Email" class="flabel">Địa chỉ Email</label>
                <input asp-for="Email" id="emailInput"
                       class="finput @(ViewData.ModelState["Email"]?.Errors.Count > 0 ? "invalid" : "")"
                       placeholder="email@truong.edu.vn"
                       autocomplete="email" autofocus
                       data-testid="input-email"/>
                @if (ViewData.ModelState["Email"]?.Errors.Count > 0)
                {
                    <div class="ferr"><i class="bi bi-exclamation-circle"></i><span asp-validation-for="Email"></span></div>
                }
            </div>

            <div class="field">
                <label asp-for="Password" class="flabel">Mật khẩu</label>
                <div class="pw-wrap">
                    <input asp-for="Password" type="password" id="pwInput"
                           class="finput @(ViewData.ModelState["Password"]?.Errors.Count > 0 ? "invalid" : "")"
                           placeholder="••••••••" autocomplete="current-password"
                           style="padding-right:44px"
                           data-testid="input-password"/>
                    <button type="button" class="pw-toggle" id="pwToggleBtn"
                            aria-label="Hiện/ẩn mật khẩu">
                        <i class="bi bi-eye" id="pwEyeIcon"></i>
                    </button>
                </div>
                @if (ViewData.ModelState["Password"]?.Errors.Count > 0)
                {
                    <div class="ferr"><i class="bi bi-exclamation-circle"></i><span asp-validation-for="Password"></span></div>
                }
            </div>

            <div class="form-row">
                <label class="remember">
                    <input asp-for="RememberMe" type="checkbox" data-testid="check-remember"/>
                    Ghi nhớ đăng nhập
                </label>
                <a asp-controller="Auth" asp-action="ForgotPassword"
                   asp-route-role="@role" class="forgot-link" data-testid="forgot-password">
                    Quên mật khẩu?
                </a>
            </div>

            <button type="submit" class="btn-login" id="btnLogin" data-testid="btn-login">
                <i class="bi bi-box-arrow-in-right" id="btnIcon"></i>
                <span id="btnText">Đăng nhập</span>
            </button>
        </form>

        <p class="card-foot">
            Chưa có tài khoản? Vui lòng liên hệ quản trị viên<br/>để nhận liên kết kích hoạt tài khoản.
        </p>
    </div>

    <a asp-controller="Auth" asp-action="SelectRole" class="change-role-link">
        <i class="bi bi-arrow-left"></i> Chọn vai trò khác
    </a>

</main>

<!-- ══════════ TREE SILHOUETTE (SVG) ════════════════════════════ -->
