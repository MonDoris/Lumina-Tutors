    </div><!-- /glass-card -->
  </div><!-- /panel-form -->

</div><!-- /lp -->

<script>
/* ── Particle (golden dust) ─────────────────────────────────────── */
(function(){
  const dc = document.getElementById('dustCanvas');
  const cx = dc.getContext('2d');
  let W, H, pts = [];
  function sz(){ W = dc.width = dc.offsetWidth; H = dc.height = dc.offsetHeight; }
  sz(); window.addEventListener('resize', sz);
  class Dust {
    constructor(scatter){
      this.reset(); if(scatter){ this.y=Math.random()*H; this.l=Math.random()*this.mx; }
    }
    reset(){
      this.x=Math.random()*W; this.y=H+8;
      this.r=Math.random()*1.7+0.4;
      this.vy=-(Math.random()*.45+.12);
      this.vx=(Math.random()-.5)*.22;
      this.base=Math.random()*.5+.1;
      this.l=0; this.mx=Math.random()*380+200;
    }
    tick(){
      this.x+=this.vx; this.y+=this.vy; this.l++;
      if(this.y<-8||this.l>=this.mx) this.reset();
      const t=this.l/this.mx;
      const f=t<.12?t/.12:t>.78?(1-t)/.22:1;
      this.a=this.base*f;
    }
    draw(){
      cx.beginPath(); cx.arc(this.x,this.y,this.r,0,Math.PI*2);
      cx.fillStyle=`rgba(201,162,39,${this.a})`; cx.fill();
    }
  }
  for(let i=0;i<72;i++) pts.push(new Dust(true));
  (function loop(){ cx.clearRect(0,0,W,H); pts.forEach(p=>{p.tick();p.draw();}); requestAnimationFrame(loop); })();
})();

/* ── Subtle parallax on arch SVG ────────────────────────────────── */
(function(){
  const art = document.getElementById('artPanel');
  const svg = document.getElementById('archSvg');
  art.addEventListener('mousemove', e=>{
    const r = art.getBoundingClientRect();
    const mx=(e.clientX-r.left)/r.width-.5, my=(e.clientY-r.top)/r.height-.5;
    svg.style.transform=`translate(${mx*-7}px,${my*-5}px)`;
    svg.style.transition='transform .8s ease-out';
  });
  art.addEventListener('mouseleave',()=>{
    svg.style.transform=''; svg.style.transition='transform 1.4s ease-out';
  });
})();

/* ── Role switcher ───────────────────────────────────────────────── */
(function(){
  const chips  = document.querySelectorAll('.r-chip');
  const rinput = document.getElementById('roleInput');
  const roleLbl= document.getElementById('roleLbl');
  const forgot = document.getElementById('forgotLnk');
  const labels = {
    student:'Học Sinh', teacher:'Giáo Viên',
    supervisor:'Giám Thị', parent:'Phụ Huynh', admin:'Quản Trị Viên'
  };
  chips.forEach(chip=>{
    chip.addEventListener('click',()=>{
      const r = chip.dataset.role;
      chips.forEach(c=>{ c.classList.remove('active'); c.setAttribute('aria-pressed','false'); });
      chip.classList.add('active'); chip.setAttribute('aria-pressed','true');
      rinput.value = r;
      document.documentElement.dataset.role = r;
      if(roleLbl) roleLbl.textContent = labels[r];
      // Update forgot-password role param
      if(forgot){
        const u = new URL(forgot.href, location.origin);
        u.searchParams.set('role', r);
        forgot.href = u.pathname + u.search;
      }
    });
  });
})();

/* ── Password toggle ─────────────────────────────────────────────── */
(function(){
  const pw = document.getElementById('pwInput');
  const btn= document.getElementById('pwTog');
  const on = document.getElementById('eyeOn');
  const pu = document.getElementById('eyePup');
  const off= document.getElementById('eyeOff');
  if(!btn) return;
  btn.addEventListener('click',()=>{
    const vis = pw.type==='text';
    pw.type = vis?'password':'text';
    on.style.display  = vis?'':'none';
    pu.style.display  = vis?'':'none';
    off.style.display = vis?'none':'';
  });
})();

/* ── Submit loading state ─────────────────────────────────────────── */
document.getElementById('loginForm').addEventListener('submit',function(){
  document.getElementById('submitBtn').classList.add('loading');
});
</script>
