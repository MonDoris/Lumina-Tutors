<!-- ══════════ SCRIPTS ═══════════════════════════════════════════ -->
<script>
/* ─────────────────────────────────────────────────────────────────
   1. STAR FIELD (canvas-based, animated twinkling)
───────────────────────────────────────────────────────────────── */
(function () {
    var cvs    = document.getElementById('starCanvas');
    var ctx    = cvs.getContext('2d');
    var stars  = [];

    function spawn() {
        stars = [];
        var density = Math.max(120, Math.floor(cvs.width * cvs.height / 3800));
        for (var i = 0; i < density; i++) {
            var big = Math.random() < .06;
            stars.push({
                x: Math.random() * cvs.width,
                y: Math.random() * cvs.height * .88,
                r: big ? (1.6 + Math.random() * 0.8) : (Math.random() < .22 ? 1.1 : 0.65),
                a: .45 + Math.random() * .55,
                phase: Math.random() * Math.PI * 2,
                spd: .006 + Math.random() * .028,
                hue: Math.random() < .08 ? (Math.random() * 60 + 180) : 0, // occasional colored stars
            });
        }
    }

    function resize() {
        cvs.width  = window.innerWidth;
        cvs.height = window.innerHeight;
        spawn();
    }

    var last = 0;
    function draw(now) {
        var dt = Math.min((now - last) / 1000, .05);
        last = now;
        ctx.clearRect(0, 0, cvs.width, cvs.height);
        for (var i = 0; i < stars.length; i++) {
            var s = stars[i];
            s.phase += s.spd * dt * 60;
            var alpha = s.a * (.55 + .45 * Math.sin(s.phase));
            ctx.beginPath();
            ctx.arc(s.x, s.y, s.r, 0, 6.2832);
            if (s.hue) {
                ctx.fillStyle = 'hsla(' + s.hue + ',70%,85%,' + alpha + ')';
            } else {
                ctx.fillStyle = 'rgba(255,255,255,' + alpha + ')';
            }
            ctx.fill();
            // Big star cross-shape sparkle
            if (s.r > 1.5 && alpha > .7) {
                ctx.strokeStyle = 'rgba(255,255,255,' + (alpha * .35) + ')';
                ctx.lineWidth = .8;
                ctx.beginPath();
                ctx.moveTo(s.x - s.r * 2.4, s.y);
                ctx.lineTo(s.x + s.r * 2.4, s.y);
                ctx.moveTo(s.x, s.y - s.r * 2.4);
                ctx.lineTo(s.x, s.y + s.r * 2.4);
                ctx.stroke();
            }
        }
        requestAnimationFrame(draw);
    }

    window.addEventListener('resize', resize);
    resize();
    requestAnimationFrame(draw);
})();

/* ─────────────────────────────────────────────────────────────────
   2. OWL CONTROLLER
───────────────────────────────────────────────────────────────── */
(function () {
    var stage     = document.getElementById('owlStage');
    var pawL      = document.getElementById('pawLGrp');
    var pawR      = document.getElementById('pawRGrp');
    var irisL     = document.getElementById('irisLGrp');
    var irisR     = document.getElementById('irisRGrp');
    var blushL    = document.getElementById('blushL');
    var blushR    = document.getElementById('blushR');
    var browL     = document.getElementById('browL');
    var browR     = document.getElementById('browR');
    var email     = document.getElementById('emailInput');
    var pw        = document.getElementById('pwInput');

    var currentOwlState = 'idle';
    var blushActive     = false;

    // ── OWL STATE MACHINE ──────────────────────────────────────
    function setOwlState(s) {
        currentOwlState = s;

        // Paw positions
        if (s === 'password' || s === 'peek-cover') {
            pawL.style.transform = 'translate(42px, -32px)';
            pawR.style.transform = 'translate(-42px, -32px)';
        } else if (s === 'peek') {
            // Right paw peeks (pulled back slightly)
            pawL.style.transform = 'translate(42px, -32px)';
            pawR.style.transform = 'translate(-16px, -14px) rotate(-22deg)';
        } else {
            pawL.style.transform = '';
            pawR.style.transform = '';
        }

        // Iris / pupil position
        if (s === 'email') {
            irisL.style.transform = 'translate(1px, 4px)';
            irisR.style.transform = 'translate(1px, 4px)';
        } else if (s === 'password' || s === 'peek-cover') {
            irisL.style.transform = 'translate(0, 0)';
            irisR.style.transform = 'translate(0, 0)';
        } else {
            irisL.style.transform = '';
            irisR.style.transform = '';
        }

        // Eyebrows — worried on error
        if (s === 'error') {
            browL.style.transform = 'translate(-3px, 3px) rotate(12deg)';
            browR.style.transform = 'translate( 3px, 3px) rotate(-12deg)';
        } else if (s === 'email') {
            browL.style.transform = 'translateY(-2.5px)';
            browR.style.transform = 'translateY(-2.5px)';
        } else {
            browL.style.transform = '';
            browR.style.transform = '';
        }
    }

    // ── BLUSH ─────────────────────────────────────────────────
    function setBlush(on, color) {
        blushActive = on;
        var c = color || '#ff6b80';
        blushL.setAttribute('fill', c);
        blushR.setAttribute('fill', c);
        blushL.setAttribute('fill-opacity', on ? '0.42' : '0');
        blushR.setAttribute('fill-opacity', on ? '0.42' : '0');
    }

    // ── BOUNCE (per keystroke) ────────────────────────────────
    function triggerBounce() {
        stage.classList.remove('bounce');
        stage.offsetWidth; // reflow
        stage.classList.add('bounce');
    }

    stage.addEventListener('animationend', function (e) {
        if (e.animationName === 'owlBounceKey') stage.classList.remove('bounce');
        if (e.animationName === 'owlShake')     stage.classList.remove('shake');
        if (e.animationName === 'owlSuccess')   stage.classList.remove('success');
    });

    // ── EMAIL INPUT ───────────────────────────────────────────
    email.addEventListener('focus', function () { setOwlState('email'); });
    email.addEventListener('blur',  function () { setOwlState('idle');  setBlush(false); });
    email.addEventListener('input', function () {
        triggerBounce();
        setBlush(this.value.length > 0);
    });

    // ── PASSWORD INPUT ────────────────────────────────────────
    pw.addEventListener('focus', function () { setOwlState('password'); });
    pw.addEventListener('blur',  function () { setOwlState('idle'); });
    pw.addEventListener('input', function () {
        triggerBounce();
        setBlush(this.value.length > 0, '#c084fc');
    });

    // ── EXPOSE FOR TOGGLE FUNCTION ────────────────────────────
    window.__owl = { setOwlState: setOwlState };

    // ── ERROR ON PAGE LOAD ────────────────────────────────────
    if (document.getElementById('errorAlert')) {
        setTimeout(function () {
            stage.classList.remove('shake');
            stage.offsetWidth;
            stage.classList.add('shake');
            setOwlState('error');
            setBlush(true, '#ef4444');
        }, 350);
    }
})();

/* ─────────────────────────────────────────────────────────────────
   3. PASSWORD TOGGLE
───────────────────────────────────────────────────────────────── */
document.getElementById('pwToggleBtn').addEventListener('click', function () {
    var inp  = document.getElementById('pwInput');
    var eye  = document.getElementById('pwEyeIcon');
    var o    = window.__owl;
    if (inp.type === 'password') {
        inp.type = 'text';
        eye.className = 'bi bi-eye-slash';
        if (o) o.setOwlState('peek');
    } else {
        inp.type = 'password';
        eye.className = 'bi bi-eye';
        if (o) o.setOwlState('password');
    }
});

/* ─────────────────────────────────────────────────────────────────
   4. FORM SUBMIT → SUCCESS ANIMATION + SPARKLES
───────────────────────────────────────────────────────────────── */
(function () {
    var form  = document.getElementById('loginForm');
    var btn   = document.getElementById('btnLogin');
    var ico   = document.getElementById('btnIcon');
    var txt   = document.getElementById('btnText');
    var stage = document.getElementById('owlStage');
    var sc    = document.getElementById('sparkleContainer');

    function launchSparkles() {
        var card  = document.getElementById('loginCard');
        var rect  = card.getBoundingClientRect();
        var cx    = rect.left + rect.width  / 2;
        var cy    = rect.top  + rect.height / 2;
        var count = 18;
        for (var i = 0; i < count; i++) {
            var sp  = document.createElement('div');
            sp.className = 'sparkle';
            var angle = (i / count) * Math.PI * 2;
            var dist  = 60 + Math.random() * 80;
            var sx    = Math.cos(angle) * dist + (Math.random() - .5) * 30;
            var sy    = Math.sin(angle) * dist + (Math.random() - .5) * 30;
            var size  = 4 + Math.random() * 5;
            sp.style.cssText =
                'left:' + cx + 'px; top:' + cy + 'px;' +
                'width:' + size + 'px; height:' + size + 'px;' +
                'border-radius: 50%;' +
                '--sx:' + sx + 'px; --sy:' + sy + 'px;' +
                'animation: sparkleAnim .8s cubic-bezier(.2,.8,.3,1) ' +
                (i * 28) + 'ms forwards;';
            sc.appendChild(sp);
        }
        setTimeout(function () { sc.innerHTML = ''; }, 1400);
    }

    form.addEventListener('submit', function () {
        btn.disabled = true;
        ico.className = 'bi bi-hourglass-split';
        txt.textContent = 'Đang đăng nhập…';
        stage.classList.add('success');
        launchSparkles();
    });
})();
</script>
