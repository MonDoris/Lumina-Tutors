@model LuminaTutors.Application.DTOs.Auth.LoginRequest
@{
    Layout = null;
    string role = (ViewBag.Role as string ?? "student").ToLower();
    if (!new[]{"student","teacher","supervisor","parent","admin"}.Contains(role)) role = "student";

    var roleNames = new Dictionary<string,string>{
        ["student"]="Học Sinh", ["teacher"]="Giáo Viên",
        ["supervisor"]="Giám Thị", ["parent"]="Phụ Huynh", ["admin"]="Quản Trị Viên"
    };
    bool hasError = !ViewData.ModelState.IsValid &&
                    ViewData.ModelState.Values.Any(v => v.Errors.Count > 0);
    string? okMsg = TempData["Success"] as string;
    ViewData["Title"] = "Đăng nhập — Lumina Tutors";
}
<!DOCTYPE html>
<html lang="vi" data-role="@role">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>@ViewData["Title"]</title>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;0,800;1,500&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
<style>
/* ════════════════════════════════════════════════════════════════
   DESIGN TOKENS
════════════════════════════════════════════════════════════════ */
:root{
  /* Navy */
  --n950:#050810; --n900:#080b18; --n800:#0a0e1f;
  /* Gold */
  --g600:#956010; --g500:#c9a227; --g400:#d4af37; --g300:#e8c84a; --g200:#f0d878;
  /* Text */
  --champagne:#f0e6c8; --ivory:#f7f3ea; --stone:#7a6e5a; --stone2:#3e3830;
  /* Role accent (overridden per data-role) */
  --role:#c9a227; --role-glow:rgba(201,162,39,.22);
  /* Glass */
  --glass-bg:rgba(6,9,22,.9); --glass-rim:rgba(201,162,39,.22);
  /* Input */
  --in-bg:rgba(255,255,255,.04); --in-bd:rgba(201,162,39,.2);
  --in-focus:rgba(201,162,39,.75);
  --in-glow:0 0 0 3px rgba(201,162,39,.09),0 0 16px rgba(201,162,39,.07);
  /* Card shadow */
  --card-sh:0 40px 100px rgba(0,0,0,.75),0 0 0 1px rgba(201,162,39,.12);
  /* Fonts */
  --serif:'Playfair Display',Georgia,serif; --sans:'Inter',system-ui,sans-serif;
  /* Easing */
  --expo:cubic-bezier(.16,1,.3,1);
}
html[data-role="student"]    { --role:#3b82f6; --role-glow:rgba(59,130,246,.22)  }
html[data-role="teacher"]    { --role:#10b981; --role-glow:rgba(16,185,129,.22)  }
html[data-role="supervisor"] { --role:#f59e0b; --role-glow:rgba(245,158,11,.22)  }
html[data-role="parent"]     { --role:#8b5cf6; --role-glow:rgba(139,92,246,.22)  }
html[data-role="admin"]      { --role:#94a3b8; --role-glow:rgba(148,163,184,.22) }

/* ════════════════════════════════════════════════════════════════
   RESET
════════════════════════════════════════════════════════════════ */
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%;overflow:hidden}
body{font-family:var(--sans);background:var(--n950);color:var(--champagne);-webkit-font-smoothing:antialiased}
a{color:inherit;text-decoration:none}
button{cursor:pointer;border:none;background:none;font-family:inherit;font-size:inherit}

/* ════════════════════════════════════════════════════════════════
   PAGE SHELL
════════════════════════════════════════════════════════════════ */
.lp{display:flex;height:100vh;width:100%;overflow:hidden}

/* ════════════════════════════════════════════════════════════════
   LEFT PANEL — Academic Atmosphere
════════════════════════════════════════════════════════════════ */
.panel-art{
  position:relative; flex:0 0 60%; overflow:hidden;
  background:
    radial-gradient(ellipse 65% 48% at 50% 36%,rgba(201,162,39,.09) 0%,transparent 65%),
    radial-gradient(ellipse 42% 28% at 50% 7%, rgba(201,162,39,.13) 0%,transparent 52%),
    linear-gradient(168deg,#0d1228 0%,#080a16 48%,#0a0c1e 100%);
  /* Bold diagonal cut on the right edge */
  clip-path:polygon(0 0,87% 0,100% 100%,0 100%);
}

#dustCanvas{
  position:absolute;inset:0;width:100%;height:100%;
  pointer-events:none;z-index:1;
}
.arch-svg{
  position:absolute;inset:0;width:100%;height:100%;z-index:2;
  transition:transform 1.2s ease-out;
}
.panel-content{
  position:absolute;inset:0;z-index:10;
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  padding:2.5rem 5rem 2.5rem 3.5rem;text-align:center;
}

/* Crest */
.pcrest{
  width:108px;height:124px;margin-bottom:1.5rem;
  filter:drop-shadow(0 0 20px rgba(201,162,39,.38));
  animation:crPulse 4.5s ease-in-out infinite;
}
@@keyframes crPulse{
  0%,100%{filter:drop-shadow(0 0 20px rgba(201,162,39,.35))}
  50%{filter:drop-shadow(0 0 42px rgba(201,162,39,.58))}
}

/* School name */
.p-school{
  font-family:var(--serif);
  font-size:clamp(2rem,2.9vw,2.75rem);font-weight:800;
  color:var(--champagne);letter-spacing:.15em;text-transform:uppercase;
  line-height:1.05;margin-bottom:.4rem;
}
.p-school em{color:var(--g300);font-style:normal}
.p-tagline{
  font-family:var(--serif);font-style:italic;
  font-size:.93rem;color:var(--g300);
  letter-spacing:.03em;opacity:.82;margin-bottom:2rem;
}

/* Ornamental divider */
.p-divider{
  display:flex;align-items:center;gap:.65rem;
  margin-bottom:1.85rem;width:220px;
}
.p-divider-line{
  flex:1;height:1px;
  background:linear-gradient(90deg,transparent,rgba(201,162,39,.45),transparent);
}
.p-divider-gem{
  width:8px;height:8px;flex-shrink:0;
  background:var(--g400);transform:rotate(45deg);
  box-shadow:0 0 8px rgba(201,162,39,.5);
}

/* Stats */
.p-stats{display:flex;gap:2.25rem;margin-bottom:1.85rem}
.p-stat-num{
  display:block;font-family:var(--serif);
  font-size:1.45rem;font-weight:700;color:var(--g300);line-height:1;
}
.p-stat-lbl{
  display:block;font-size:.66rem;color:var(--stone);
  text-transform:uppercase;letter-spacing:.1em;margin-top:.25rem;
}

/* Status badge */
.p-badge{
  display:inline-flex;align-items:center;gap:.42rem;
  padding:.36rem .85rem;
  border:1px solid rgba(201,162,39,.2);border-radius:100px;
  background:rgba(201,162,39,.05);
  font-size:.67rem;color:var(--g200);letter-spacing:.07em;text-transform:uppercase;
}
.p-badge-dot{
  width:6px;height:6px;border-radius:50%;background:var(--g400);
  animation:bdot 2.2s ease-in-out infinite;
}
@@keyframes bdot{0%,100%{opacity:1}50%{opacity:.22}}

/* ════════════════════════════════════════════════════════════════
   RIGHT PANEL — Login Form
════════════════════════════════════════════════════════════════ */
.panel-form{
  flex:1;display:flex;align-items:center;justify-content:center;
  padding:2rem 2.5rem;
  background:linear-gradient(to right,rgba(5,8,16,.25) 0%,var(--n900) 14%);
}

/* ════════════════════════════════════════════════════════════════
   GLASS CARD
════════════════════════════════════════════════════════════════ */
.glass-card{
  width:100%;max-width:415px;
  background:var(--glass-bg);
  border:1px solid var(--glass-rim);border-radius:20px;
  padding:2.2rem 2rem;
  box-shadow:var(--card-sh);
  backdrop-filter:blur(40px) saturate(1.4);
  -webkit-backdrop-filter:blur(40px) saturate(1.4);
  animation:cardIn .75s var(--expo) both;
  position:relative;overflow:hidden;
}
@@keyframes cardIn{from{opacity:0;transform:translateY(20px) scale(.98)}to{opacity:1;transform:none}}
/* Top shimmer line */
.glass-card::after{
  content:'';position:absolute;top:0;left:50%;transform:translateX(-50%);
  width:52%;height:1px;
  background:linear-gradient(90deg,transparent,rgba(201,162,39,.65),transparent);
}

/* ── Logo ── */
.card-logo{display:flex;align-items:center;gap:.65rem;margin-bottom:1.5rem}
.logo-hex{width:36px;height:42px;flex-shrink:0}
.logo-wm{
  font-family:var(--serif);font-size:1.08rem;font-weight:700;
  color:var(--champagne);letter-spacing:.03em;line-height:1.2;
}
.logo-wm em{
  display:block;font-family:var(--sans);font-style:normal;
  font-size:.58rem;font-weight:400;color:var(--stone);
  letter-spacing:.12em;text-transform:uppercase;margin-top:.1rem;
}

/* ── Welcome heading ── */
.card-hd{margin-bottom:1.35rem}
.card-hd h1{
  font-family:var(--serif);font-size:1.7rem;font-weight:700;
  color:var(--ivory);line-height:1.2;
}
.card-hd p{font-size:.78rem;color:var(--stone);margin-top:.32rem;line-height:1.55}
.role-lbl{color:var(--role);transition:color .3s;font-weight:600}

/* ── Role chips ── */
.role-row{
  display:flex;gap:.3rem;overflow-x:auto;scrollbar-width:none;
  margin-bottom:1.2rem;padding-bottom:2px;
}
.role-row::-webkit-scrollbar{display:none}
.r-chip{
  flex:1;min-width:56px;
  display:flex;flex-direction:column;align-items:center;gap:.28rem;
  padding:.52rem .25rem;
  border-radius:9px;border:1px solid rgba(255,255,255,.06);
  background:rgba(255,255,255,.02);
  color:var(--stone);
  font-size:.59rem;font-weight:600;letter-spacing:.03em;
  text-align:center;white-space:nowrap;user-select:none;
  transition:all .22s var(--expo);
}
.r-chip svg{
  width:16px;height:16px;stroke:currentColor;fill:none;
  stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;
  transition:stroke .22s;
}
.r-chip:hover{
  border-color:rgba(201,162,39,.28);color:var(--g200);
  background:rgba(201,162,39,.05);transform:translateY(-2px);
}
.r-chip.active{
  border-color:var(--role);
  background:color-mix(in srgb,var(--role) 12%,transparent);
  color:var(--role);
  box-shadow:0 0 14px var(--role-glow),inset 0 0 10px color-mix(in srgb,var(--role) 6%,transparent);
}
.r-chip.active svg{stroke:var(--role)}

/* ── Thin divider ── */
.card-div{
  height:1px;margin:.1rem 0 1.15rem;
  background:linear-gradient(90deg,transparent,rgba(201,162,39,.14),transparent);
}

/* ── Alerts ── */
.alert{
  display:flex;align-items:flex-start;gap:.5rem;
  padding:.68rem .88rem;border-radius:8px;
  font-size:.76rem;margin-bottom:1rem;
}
.alert svg{width:14px;height:14px;flex-shrink:0;stroke:currentColor;fill:none;stroke-width:2;stroke-linecap:round;margin-top:.05rem}
.alert-error{background:rgba(239,68,68,.08);border:1px solid rgba(239,68,68,.28);color:#fca5a5}
.alert-success{background:rgba(16,185,129,.08);border:1px solid rgba(16,185,129,.22);color:#6ee7b7}

/* ── Form fields ── */
.field{position:relative;margin-bottom:.95rem}
.flbl{
  display:block;font-size:.66rem;font-weight:600;color:var(--stone);
  letter-spacing:.07em;text-transform:uppercase;margin-bottom:.38rem;
  transition:color .2s;
}
.field:focus-within .flbl{color:var(--g300)}
.finput{
  width:100%;padding:.7rem 1rem;
  background:var(--in-bg);border:1px solid var(--in-bd);border-radius:8px;
  font-family:var(--sans);font-size:.88rem;color:var(--ivory);
  outline:none;transition:border-color .2s,box-shadow .2s;-webkit-appearance:none;
}
.finput::placeholder{color:rgba(255,255,255,.14)}
.finput:focus{border-color:var(--in-focus);box-shadow:var(--in-glow)}
.finput.invalid{border-color:rgba(239,68,68,.55)!important}

/* Password wrapper */
.pw-wrap{position:relative}
.pw-wrap .finput{padding-right:2.7rem}
.pw-tog{
  position:absolute;right:.8rem;top:50%;transform:translateY(-50%);
  color:var(--stone);display:flex;padding:4px;transition:color .2s;
}
.pw-tog:hover{color:var(--g300)}
.pw-tog svg{width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:1.8;stroke-linecap:round}

/* Validation */
.ferr{
  font-size:.69rem;color:#f87171;margin-top:.28rem;
  display:flex;align-items:center;gap:.3rem;
}
.ferr::before{content:'⚠ ';font-size:.62rem}

/* ── Extras row ── */
.form-ext{
  display:flex;align-items:center;justify-content:space-between;
  margin:.1rem 0 1.25rem;
}
.rem-lbl{
  display:flex;align-items:center;gap:.42rem;
  font-size:.73rem;color:var(--stone);cursor:pointer;
}
.rem-lbl input{accent-color:var(--g500);cursor:pointer;width:13px;height:13px}
.forgot{font-size:.73rem;color:var(--stone);transition:color .2s}
.forgot:hover{color:var(--g300)}

/* ── Submit button ── */
.btn-sub{
  width:100%;padding:.8rem 1.5rem;
  background:linear-gradient(135deg,var(--g400) 0%,var(--g600) 100%);
  border-radius:8px;
  font-family:var(--sans);font-size:.87rem;font-weight:700;
  color:var(--n800);letter-spacing:.07em;text-transform:uppercase;
  display:flex;align-items:center;justify-content:center;gap:.52rem;
  position:relative;overflow:hidden;
  transition:transform .22s var(--expo),box-shadow .22s;
}
.btn-sub:hover{
  transform:translateY(-2px);
  box-shadow:0 10px 36px rgba(201,162,39,.38),0 0 0 1px rgba(201,162,39,.28);
}
.btn-sub:active{transform:none;box-shadow:0 4px 14px rgba(201,162,39,.22)}
.btn-sub.loading{opacity:.6;pointer-events:none}
/* Shimmer sweep */
.btn-sub::before{
  content:'';position:absolute;top:0;left:-100%;width:55%;height:100%;
  background:linear-gradient(90deg,transparent,rgba(255,255,255,.22),transparent);
  transform:skewX(-18deg);transition:left .55s;
}
.btn-sub:hover::before{left:140%}
.btn-arr{
  width:16px;height:16px;stroke:var(--n800);fill:none;
  stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round;
  transition:transform .2s;
}
.btn-sub:hover .btn-arr{transform:translateX(3px)}
.btn-spin{
  width:15px;height:15px;border:2px solid rgba(0,0,0,.22);
  border-top-color:var(--n800);border-radius:50%;
  animation:spin .65s linear infinite;display:none;
}
.btn-sub.loading .btn-spin{display:block}
.btn-sub.loading .btn-txt,.btn-sub.loading .btn-arr{display:none}
@@keyframes spin{to{transform:rotate(360deg)}}

/* ── Card footer ── */
.card-ft{
  margin-top:1.35rem;display:flex;align-items:center;justify-content:center;
}
.back-lnk{
  display:inline-flex;align-items:center;gap:.38rem;
  font-size:.73rem;color:var(--stone);
  padding:.32rem .55rem;border-radius:6px;
  border:1px solid transparent;transition:color .2s,border-color .2s;
}
.back-lnk:hover{color:var(--g300);border-color:rgba(201,162,39,.14)}
.back-lnk svg{
  width:13px;height:13px;stroke:currentColor;fill:none;
  stroke-width:2;transition:transform .2s;
}
.back-lnk:hover svg{transform:translateX(-2px)}

/* ════════════════════════════════════════════════════════════════
   RESPONSIVE
════════════════════════════════════════════════════════════════ */
@@media(max-width:900px){
  html,body{overflow:auto}
  .lp{flex-direction:column;height:auto;min-height:100vh}
  .panel-art{
    flex:none;height:195px;width:100%;
    clip-path:polygon(0 0,100% 0,100% 78%,0 100%);
  }
  .panel-content{padding:1.2rem;justify-content:flex-end}
  .pcrest{width:58px;height:auto;margin-bottom:.55rem}
  .p-school{font-size:1.45rem}
  .p-tagline,.p-stats,.p-badge,.p-divider{display:none}
  .panel-form{padding:1.35rem 1rem;align-items:flex-start;padding-top:1.1rem}
  .glass-card{max-width:100%;border-radius:14px;padding:1.65rem 1.25rem}
}
@@media(max-width:480px){
  .panel-art{height:148px}
  .glass-card{padding:1.4rem 1rem;border-radius:12px}
  .r-chip{font-size:.55rem;padding:.42rem .18rem}
  .card-hd h1{font-size:1.48rem}
}
</style>
</head>
<body>
<div class="lp" id="lp">

  <!-- ╔══════════════════════════════════════════════════
       ║  LEFT PANEL — Grand Academic Atmosphere
       ╚══════════════════════════════════════════════════ -->
  <div class="panel-art" id="artPanel">
    <canvas id="dustCanvas"></canvas>

    <!-- Atmospheric SVG Architecture -->
    <svg class="arch-svg" id="archSvg" viewBox="0 0 600 900"
         preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <linearGradient id="hg" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%"   stop-color="#c9a227" stop-opacity="0"/>
          <stop offset="35%"  stop-color="#c9a227" stop-opacity="0.55"/>
          <stop offset="65%"  stop-color="#c9a227" stop-opacity="0.55"/>
          <stop offset="100%" stop-color="#c9a227" stop-opacity="0"/>
        </linearGradient>
        <linearGradient id="vg" x1="0%" y1="0%" x2="0%" y2="100%"
                        gradientUnits="userSpaceOnUse" y1="0" y2="900">
          <stop offset="0%"   stop-color="#c9a227" stop-opacity="0.72"/>
          <stop offset="100%" stop-color="#c9a227" stop-opacity="0"/>
        </linearGradient>
        <radialGradient id="topglow" cx="50%" cy="0%" r="65%">
          <stop offset="0%"   stop-color="#c9a227" stop-opacity="0.20"/>
          <stop offset="100%" stop-color="#c9a227" stop-opacity="0"/>
        </radialGradient>
        <pattern id="mgrid" width="44" height="44" patternUnits="userSpaceOnUse">
          <path d="M44 0L0 0 0 44" fill="none" stroke="rgba(201,162,39,0.024)" stroke-width="0.5"/>
        </pattern>
      </defs>

      <!-- Micro grid + top glow -->
      <rect width="600" height="900" fill="url(#mgrid)"/>
      <rect width="600" height="900" fill="url(#topglow)"/>

      <!-- Top rule -->
      <rect y="0" width="600" height="1.5" fill="url(#hg)"/>

      <!-- Column shafts -->
      <rect x="44"  y="0" width="20" height="900" fill="rgba(201,162,39,0.03)"/>
      <rect x="536" y="0" width="20" height="900" fill="rgba(201,162,39,0.03)"/>
      <line x1="44"  y1="0" x2="44"  y2="880" stroke="rgba(201,162,39,0.18)" stroke-width="1.5"/>
      <line x1="556" y1="0" x2="556" y2="880" stroke="rgba(201,162,39,0.18)" stroke-width="1.5"/>
      <line x1="64"  y1="0" x2="64"  y2="880" stroke="rgba(201,162,39,0.06)" stroke-width="0.8"/>
      <line x1="536" y1="0" x2="536" y2="880" stroke="rgba(201,162,39,0.06)" stroke-width="0.8"/>

      <!-- OUTER LANCET ARCH (Gothic pointed) -->
      <path d="M44,870 Q44,280 300,48 Q556,280 556,870"
            stroke="rgba(201,162,39,0.2)" stroke-width="2" fill="none"/>
      <!-- MIDDLE ARCH -->
      <path d="M100,870 Q100,340 300,110 Q500,340 500,870"
            stroke="rgba(201,162,39,0.15)" stroke-width="1.4" fill="none"/>
      <!-- INNER ARCH (thin, decorative) -->
      <path d="M145,870 Q145,385 300,165 Q455,385 455,870"
            stroke="rgba(201,162,39,0.08)" stroke-width="1" fill="none"/>

      <!-- LIGHT RAYS from apex (300, 48) -->
      <g opacity="0.09" stroke="#c9a227" stroke-linecap="round">
        <line x1="300" y1="48" x2="0"   y2="820" stroke-width="1.5"/>
        <line x1="300" y1="48" x2="75"  y2="910" stroke-width="1.8"/>
        <line x1="300" y1="48" x2="175" y2="920" stroke-width="2.2"/>
        <line x1="300" y1="48" x2="252" y2="920" stroke-width="2.8"/>
        <line x1="300" y1="48" x2="300" y2="910" stroke-width="3.5"/>
        <line x1="300" y1="48" x2="348" y2="920" stroke-width="2.8"/>
        <line x1="300" y1="48" x2="425" y2="920" stroke-width="2.2"/>
        <line x1="300" y1="48" x2="525" y2="910" stroke-width="1.8"/>
        <line x1="300" y1="48" x2="600" y2="820" stroke-width="1.5"/>
      </g>

      <!-- Apex ornament (diamond + ring) -->
      <circle cx="300" cy="48" r="16" fill="none" stroke="rgba(201,162,39,0.38)" stroke-width="1"/>
      <circle cx="300" cy="48" r="9"  fill="rgba(201,162,39,0.12)"/>
      <path d="M291,48 L300,39 L309,48 L300,57 Z" fill="rgba(201,162,39,0.58)"/>

      <!-- Mid-arch horizontal rule with diamond -->
      <rect x="80" y="510" width="440" height="1" fill="url(#hg)" opacity="0.22"/>
      <path d="M296,507 L300,503 L304,507 L300,511 Z" fill="rgba(201,162,39,0.45)"/>

      <!-- Upper bookshelf (fainter) -->
      <rect x="105" y="590" width="390" height="1.5" fill="rgba(201,162,39,0.1)"/>
      <g fill="rgba(201,162,39,0.04)" stroke="rgba(201,162,39,0.08)" stroke-width="0.5">
        <rect x="120" y="563" width="14" height="27"/> <rect x="135" y="569" width="10" height="21"/>
        <rect x="146" y="559" width="16" height="31"/> <rect x="205" y="561" width="18" height="29"/>
        <rect x="260" y="565" width="14" height="25"/> <rect x="325" y="558" width="18" height="32"/>
