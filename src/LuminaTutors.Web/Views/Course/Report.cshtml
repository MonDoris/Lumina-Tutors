@using LuminaTutors.Application.DTOs.Course
@using LuminaTutors.Domain.Enums
@{
    var report = (CourseProgressReportDto)ViewBag.Report;
    ViewData["Title"] = $"Tiến độ — {report.CourseTitle}";

    string StatusBadge(CourseEnrollmentStatus s) => s switch
    {
        CourseEnrollmentStatus.Completed => "lt-badge lt-badge--success",
        CourseEnrollmentStatus.Dropped   => "lt-badge lt-badge--gray",
        _                                => "lt-badge lt-badge--info"
    };
    string StatusLabel(CourseEnrollmentStatus s) => s switch
    {
        CourseEnrollmentStatus.Completed => "Hoàn thành",
        CourseEnrollmentStatus.Dropped   => "Đã rời",
        _                                => "Đang học"
    };
    string TypeLabel(CourseLessonType t) => t switch
    {
        CourseLessonType.Video => "Video",
        CourseLessonType.Quiz  => "Trắc nghiệm",
        _                      => "Bài đọc"
    };
    string Inv(decimal d) => d.ToString(System.Globalization.CultureInfo.InvariantCulture);
    var stats = report.Stats;
}

<div class="lt-page-header">
    <div>
        <div style="margin-bottom:.35rem">
            @* Nhà trường không vào được course builder → quay về trang Quản lý *@
            <a href="@(User.IsInRole("TEACHER") ? Url.Action("Detail", new { id = report.CourseId }) : Url.Action("Manage"))"
               style="color:var(--lt-text-muted);text-decoration:none;font-size:.85rem">
                <i class="bi bi-arrow-left"></i>
                @(User.IsInRole("TEACHER") ? report.CourseTitle : "Quản lý khóa học")
            </a>
        </div>
        <h1 class="lt-page-title">
            <i class="bi bi-graph-up" style="color:var(--lt-gold);margin-right:8px"></i>
            Tiến độ học sinh
        </h1>
        <p class="lt-page-subtitle">@report.TotalPublishedLessons bài học · @report.EnrolledCount học sinh · @report.CompletedCount đã hoàn thành</p>
    </div>
</div>

@* ── Thống kê tổng quan ─────────────────────────────────────────────────── *@
@if (stats.TotalActiveStudents > 0)
{
    <div class="lt-card" style="margin-bottom:1rem">
        <div class="lt-card__body">
            <div class="row g-3 align-items-center">
                <div class="col-12 col-md-5">
                    <div style="font-size:.8rem;color:var(--lt-text-muted);margin-bottom:.3rem">
                        <i class="bi bi-speedometer2"></i> Hoàn thành trung bình toàn khóa
                    </div>
                    <div style="display:flex;align-items:center;gap:.6rem">
                        <div class="lt-progress" style="flex:1;height:12px">
                            <div class="lt-progress__bar @(stats.AvgProgressPercent >= 100 ? "lt-progress__bar--success" : "")"
                                 style="width:@(Inv(stats.AvgProgressPercent))%"></div>
                        </div>
                        <strong style="font-size:1.15rem;color:var(--lt-navy)">@stats.AvgProgressPercent.ToString("0.#")%</strong>
                    </div>
                </div>
                <div class="col-12 col-md-7">
                    <div class="row g-2 text-center">
                        @foreach (var (label, count, color) in new[] {
                            ("0–25%",   stats.Bucket0To25,   "#dc2626"),
                            ("25–50%",  stats.Bucket25To50,  "#d97706"),
                            ("50–75%",  stats.Bucket50To75,  "#2563eb"),
                            ("75–100%", stats.Bucket75To100, "#16a34a") })
                        {
                            var share = stats.TotalActiveStudents == 0 ? 0 : count * 100 / stats.TotalActiveStudents;
                            <div class="col-3">
                                <div style="font-weight:800;font-size:1.05rem;color:@color">@count</div>
                                <div class="lt-progress" style="height:6px;margin:.2rem 0">
                                    <div style="height:100%;border-radius:99px;background:@color;width:@(share)%"></div>
                                </div>
                                <div style="font-size:.72rem;color:var(--lt-text-muted)">@label</div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@* ── Tỷ lệ hoàn thành theo TỪNG bài học ─────────────────────────────────── *@
@if (report.LessonStats.Any())
{
    <div class="lt-card" style="margin-bottom:1rem">
        <div class="lt-card__header">
            <div class="lt-card__title"><i class="bi bi-list-check"></i> Tỷ lệ hoàn thành theo bài học</div>
        </div>
        <div class="lt-card__body" style="display:flex;flex-direction:column;gap:.35rem">
            @{ string? lastModule = null; }
            @foreach (var ls in report.LessonStats)
            {
                if (ls.ModuleTitle != lastModule)
                {
                    lastModule = ls.ModuleTitle;
                    <div style="font-weight:700;color:var(--lt-navy);margin-top:.5rem">
                        <i class="bi bi-folder-fill" style="color:var(--lt-gold)"></i> @ls.ModuleTitle
                    </div>
                }
                <div style="display:flex;align-items:center;gap:.7rem;padding:.3rem 0 .3rem 1.4rem">
                    <span style="flex:0 0 32%;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:.9rem"
                          title="@ls.LessonTitle">@ls.LessonTitle</span>
                    <span class="lt-badge lt-badge--gray" style="flex:0 0 auto">@TypeLabel(ls.ContentType)</span>
                    <div class="lt-progress" style="flex:1" title="@ls.CompletedCount/@stats.TotalActiveStudents học sinh hoàn thành">
                        <div class="lt-progress__bar @(ls.CompletionRate >= 100 ? "lt-progress__bar--success" : ls.CompletionRate < 30 ? "lt-progress__bar--danger" : "")"
                             style="width:@(Inv(ls.CompletionRate))%"></div>
                    </div>
                    <span style="flex:0 0 52px;text-align:right;font-size:.82rem;font-weight:700">@ls.CompletionRate.ToString("0.#")%</span>
                    <span style="flex:0 0 110px;font-size:.75rem;color:var(--lt-text-muted)">
                        @ls.CompletedCount xong · @ls.InProgressCount đang học
                    </span>
                </div>
            }
        </div>
    </div>
}

<div class="lt-card">
    <div class="lt-card__body" style="overflow-x:auto">
        @if (!report.Students.Any())
        {
            <div class="lt-empty lt-empty--sm">
                <div class="lt-empty__icon"><i class="bi bi-people"></i></div>
                <div class="lt-empty__text">Chưa có học sinh nào ghi danh.</div>
            </div>
        }
        else
        {
            <table class="lt-table" style="width:100%">
                <thead>
                    <tr>
                        <th>Học sinh</th>
                        <th>Lớp</th>
                        <th style="min-width:180px">Tiến độ</th>
                        <th>Bài xong</th>
                        <th>Trạng thái</th>
                        <th>Bắt đầu</th>
                        <th>Truy cập cuối</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var s in report.Students)
                {
                    <tr>
                        <td style="font-weight:600">@s.FullName</td>
                        <td>@(s.ClassName ?? "—")</td>
                        <td>
                            <div style="display:flex;align-items:center;gap:.5rem">
                                <div class="lt-progress" style="flex:1">
                                    <div class="lt-progress__bar @(s.ProgressPercent >= 100 ? "lt-progress__bar--success" : "")"
                                         style="width:@(s.ProgressPercent.ToString(System.Globalization.CultureInfo.InvariantCulture))%"></div>
                                </div>
                                <span style="font-size:.82rem;font-weight:700;min-width:44px;text-align:right">@s.ProgressPercent.ToString("0.#")%</span>
                            </div>
                        </td>
                        <td>@s.CompletedLessons/@report.TotalPublishedLessons</td>
                        <td><span class="@StatusBadge(s.Status)">@StatusLabel(s.Status)</span></td>
                        <td style="font-size:.85rem;color:var(--lt-text-muted)">@(s.StartedAt?.ToLocalTime().ToString("dd/MM/yyyy") ?? "—")</td>
                        <td style="font-size:.85rem;color:var(--lt-text-muted)">@(s.LastAccessedAt?.ToLocalTime().ToString("dd/MM HH:mm") ?? "—")</td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>
</div>
