@using LuminaTutors.Web.Controllers
@model LuminaTutors.Application.DTOs.Attendance.LeaveRequestListDto
@{
    ViewData["Title"] = "Đơn xin nghỉ";
    var children = ViewBag.Children as List<ParentController.ChildItem> ?? [];
}

@section Styles {<style>
.lr-body{background:#e8edf5;min-height:calc(100vh - 56px);padding:28px 32px}
.lr-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:24px}
.lr-title{font-size:1.35rem;font-weight:700;color:#0f172a}
.lr-sub{font-size:.8rem;color:#6b7280;margin-top:2px}
.stat-row{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:24px}
.stat-box{background:#fff;border-radius:16px;padding:18px 20px;box-shadow:0 2px 12px rgba(0,0,0,.06);display:flex;align-items:center;gap:14px}
.stat-icon{width:42px;height:42px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:1.1rem;flex-shrink:0}
.stat-val{font-size:1.4rem;font-weight:700;color:#0f172a}
.stat-lbl{font-size:.72rem;color:#6b7280;font-weight:600;text-transform:uppercase;letter-spacing:.05em}
.lr-card{background:#fff;border-radius:16px;box-shadow:0 2px 12px rgba(0,0,0,.06);overflow:hidden;margin-bottom:20px}
.lr-card-header{display:flex;align-items:center;justify-content:space-between;padding:16px 20px;border-bottom:1px solid #f0f4f8}
.lr-card-title{font-size:.95rem;font-weight:700;color:#0f172a}
.lr-table{width:100%;border-collapse:collapse;font-size:.83rem}
.lr-table th{padding:10px 14px;text-align:left;font-size:.72rem;font-weight:700;color:#6b7280;text-transform:uppercase;letter-spacing:.06em;border-bottom:1px solid #f0f4f8;background:#fafbfc}
.lr-table td{padding:12px 14px;border-bottom:1px solid #f7f8fa;color:#374151;vertical-align:middle}
.lr-table tr:last-child td{border-bottom:none}
.lr-table tr:hover td{background:#fafbfc}
.badge{display:inline-flex;align-items:center;gap:4px;padding:3px 10px;border-radius:20px;font-size:.72rem;font-weight:600;letter-spacing:.03em}
.badge-pending{background:#fef3c7;color:#92400e}
.badge-approved{background:#d1fae5;color:#065f46}
.badge-rejected{background:#fee2e2;color:#991b1b}
.empty-state{text-align:center;padding:48px 20px;color:#9ca3af}
.empty-icon{font-size:2.5rem;margin-bottom:12px;display:block}
.btn-submit{background:linear-gradient(135deg,#7e22ce,#a855f7);color:#fff;border:none;border-radius:10px;padding:9px 18px;font-size:.83rem;font-weight:600;cursor:pointer;display:inline-flex;align-items:center;gap:6px}
.btn-submit:hover{opacity:.9}
</style>}

<div class="lr-body">
    <div class="lr-header">
        <div>
            <div class="lr-title"><i class="bi bi-calendar-x" style="color:#7e22ce;margin-right:6px"></i>Đơn xin nghỉ</div>
            <div class="lr-sub">Quản lý đơn xin nghỉ cho con</div>
        </div>
        <button class="btn-submit" data-bs-toggle="modal" data-bs-target="#submitModal">
            <i class="bi bi-plus-circle"></i> Gửi đơn mới
        </button>
    </div>

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success rounded-3 mb-3" style="background:#d1fae5;border:none;color:#065f46;font-size:.85rem;padding:12px 16px">
            <i class="bi bi-check-circle-fill me-2"></i>@success
        </div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger rounded-3 mb-3" style="background:#fee2e2;border:none;color:#991b1b;font-size:.85rem;padding:12px 16px">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@error
        </div>
    }

    <!-- Stats -->
    <div class="stat-row">
        <div class="stat-box">
            <div class="stat-icon" style="background:#ede9fe;color:#7e22ce"><i class="bi bi-file-earmark-text-fill"></i></div>
            <div>
                <div class="stat-val">@(Model?.TotalCount ?? 0)</div>
                <div class="stat-lbl">Tổng đơn</div>
            </div>
        </div>
        <div class="stat-box">
            <div class="stat-icon" style="background:#fef3c7;color:#92400e"><i class="bi bi-hourglass-split"></i></div>
            <div>
                <div class="stat-val">@(Model?.PendingCount ?? 0)</div>
                <div class="stat-lbl">Chờ duyệt</div>
            </div>
        </div>
        <div class="stat-box">
            <div class="stat-icon" style="background:#d1fae5;color:#065f46"><i class="bi bi-check-circle-fill"></i></div>
            <div>
                <div class="stat-val">@(Model?.Items.Count(i => i.Status == "Approved") ?? 0)</div>
                <div class="stat-lbl">Đã duyệt</div>
            </div>
        </div>
    </div>

    <!-- Table -->
    <div class="lr-card">
        <div class="lr-card-header">
            <div class="lr-card-title">Danh sách đơn xin nghỉ</div>
        </div>
        @if (!Model?.Items.Any() ?? true)
        {
            <div class="empty-state">
                <span class="empty-icon">📋</span>
                <div style="font-weight:600;color:#374151;margin-bottom:4px">Chưa có đơn xin nghỉ nào</div>
                <div style="font-size:.8rem">Nhấn "Gửi đơn mới" để tạo đơn cho con.</div>
            </div>
        }
        else
        {
            <table class="lr-table">
                <thead>
                    <tr>
                        <th>Học sinh</th>
                        <th>Từ ngày</th>
                        <th>Đến ngày</th>
                        <th>Số ngày</th>
                        <th>Lý do</th>
                        <th>Trạng thái</th>
                        <th>Ghi chú GT</th>
                        <th>Ngày gửi</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model!.Items)
                    {
                        <tr>
                            <td>
                                <div style="font-weight:600;color:#0f172a">@item.StudentName</div>
                                <div style="font-size:.72rem;color:#9ca3af">@item.ClassName</div>
                            </td>
                            <td>@item.FromDate.ToString("dd/MM/yyyy")</td>
                            <td>@item.ToDate.ToString("dd/MM/yyyy")</td>
                            <td style="text-align:center">@item.DayCount</td>
                            <td style="max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="@item.Reason">@item.Reason</td>
                            <td>
                                @{
                                    var badgeCls = item.Status switch {
                                        "Approved" => "badge-approved",
                                        "Rejected" => "badge-rejected",
                                        _          => "badge-pending"
                                    };
                                    var statusLabel = item.Status switch {
                                        "Approved" => "Đã duyệt",
                                        "Rejected" => "Từ chối",
                                        _          => "Chờ duyệt"
                                    };
                                }
                                <span class="badge @badgeCls">@statusLabel</span>
                            </td>
                            <td style="font-size:.78rem;color:#6b7280;max-width:150px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">
                                @(item.ReviewNote ?? "—")
                            </td>
                            <td style="color:#6b7280;font-size:.78rem">@item.CreatedAt.ToString("dd/MM HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<!-- Submit Leave Request Modal -->
<div class="modal fade" id="submitModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius:16px;border:none">
            <div class="modal-header" style="padding:20px 24px;border-bottom:1px solid #f0f0f0">
                <h5 class="modal-title" style="font-weight:700;color:#0f172a">
                    <i class="bi bi-calendar-x" style="color:#7e22ce;margin-right:6px"></i>Gửi đơn xin nghỉ
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="Parent" asp-action="SubmitLeaveRequest" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body" style="padding:24px;display:flex;flex-direction:column;gap:14px">
                    @{
                        var childList = children.ToList();
                    }
                    @if (childList.Count > 1)
                    {
                        <div>
                            <label class="lt-label">Học sinh <span style="color:#ef4444">*</span></label>
                            <select name="StudentId" class="lt-select" required>
                                <option value="">— Chọn học sinh —</option>
                                @foreach (var child in childList)
                                {
                                    <option value="@child.Id">@child.FullName</option>
                                }
                            </select>
                        </div>
                    }
                    else if (childList.Count == 1)
                    {
                        <input type="hidden" name="StudentId" value="@childList[0].Id" />
                        <div style="background:#f8fafc;border-radius:10px;padding:10px 14px;font-size:.85rem;color:#374151;border:1px solid #e5e7eb">
                            <span style="font-size:.72rem;color:#6b7280;font-weight:600;display:block;margin-bottom:2px">HỌC SINH</span>
                            <strong>@childList[0].FullName</strong>
                        </div>
                    }
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
                        <div>
                            <label class="lt-label">Từ ngày <span style="color:#ef4444">*</span></label>
                            <input type="date" name="FromDate" class="lt-input" required
                                   min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        </div>
                        <div>
                            <label class="lt-label">Đến ngày <span style="color:#ef4444">*</span></label>
                            <input type="date" name="ToDate" class="lt-input" required
                                   min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        </div>
                    </div>
                    <div>
                        <label class="lt-label">Lý do xin nghỉ <span style="color:#ef4444">*</span></label>
                        <textarea name="Reason" class="lt-textarea" rows="4" required maxlength="1000"
                                  placeholder="VD: Con bị sốt, cần nghỉ để điều trị..."></textarea>
                    </div>
                </div>
                <div class="modal-footer" style="padding:14px 24px;border-top:1px solid #f0f0f0;gap:8px">
                    <button type="button" class="lt-btn lt-btn--outline" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn-submit">
                        <i class="bi bi-send"></i> Gửi đơn
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
