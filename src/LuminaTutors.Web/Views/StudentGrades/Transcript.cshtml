@using System.Security.Claims
@{
    Layout = null;
    ViewData["Title"] = "Bảng điểm — Lumina Tutors";

    var studentName  = User.FindFirstValue(ClaimTypes.Name) ?? "Nguyễn Minh Khôi";
    var studentId    = ViewBag.StudentId    as string ?? "2021001234";
    var program      = ViewBag.Program      as string ?? "Triết học Hiện đại";
    var faculty      = ViewBag.Faculty      as string ?? "Khoa KHXH & Nhân văn";
    var academicYear = ViewBag.AcademicYear as string ?? "Khoá 2021";
    var cumGpa       = (decimal)(ViewBag.CumulativeGpa ?? 3.52m);
    var cumCredits   = (int)(ViewBag.CumulativeCredits ?? 54);
    var totalCredits = (int)(ViewBag.TotalCredits ?? 56);
    var gpaClass     = cumGpa >= 3.6m ? "Xuất sắc" : cumGpa >= 3.2m ? "Giỏi" : cumGpa >= 2.5m ? "Khá" : cumGpa >= 2.0m ? "Trung bình" : "Yếu";
    var now          = DateTime.Now;
    var userRole     = User.FindFirstValue(ClaimTypes.Role) ?? "";
    var canExport    = userRole is "TEACHER" or "ADMIN";

    // GPA ring math: r=72, viewBox 0 0 200 200, 270° arc
    // Total arc length = 339.29, full circumference = 452.39, gap = 113.1
    double arcTotal  = 339.29;
    double arcCirc   = 452.39;
    double fillRatio = (double)cumGpa / 4.0;
    double fillArc   = fillRatio * arcTotal;
    double gapArc    = arcCirc - fillArc;
    // Glow dot position at current GPA angle: 135° + fillRatio*270°
    double tipAngleDeg = 135.0 + fillRatio * 270.0;
    double tipRad    = tipAngleDeg * Math.PI / 180.0;
    double tipX      = 100.0 + 72.0 * Math.Cos(tipRad);
    double tipY      = 100.0 + 72.0 * Math.Sin(tipRad);
    // Distinction threshold at GPA 3.2 = 80%
    double thrAngleDeg = 135.0 + 0.8 * 270.0;
    double thrRad    = thrAngleDeg * Math.PI / 180.0;
    double thrX      = 100.0 + 72.0 * Math.Cos(thrRad);
    double thrY      = 100.0 + 72.0 * Math.Sin(thrRad);
}
<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>@ViewData["Title"]</title>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@@0,400;0,600;0,700;1,400&family=Inter:wght@@300;400;500;600;700&display=swap" rel="stylesheet"/>
<style>
/* ── TOKENS ─────────────────────────────────────────────────── */
:root{
  --navy:#0a0e1f; --navy2:#0f1530; --burg:#5c1a2e;
  --gold:#c9a227; --gold-l:#d4af37; --gold-ll:#e8c84a; --gold-dim:rgba(201,162,39,.15);
  --champagne:#f0e6c8; --ivory:#f8f3ec;
  --page:#f2ede6; --card:#ffffff;
  --text:#0e1225; --text2:#4a4036; --stone:#8a7d6e;
  --ok:#16a34a; --ok-bg:#f0fdf4; --ok-bd:#bbf7d0;
  --fail:#dc2626; --fail-bg:#fef2f2; --fail-bd:#fecaca;
  --warn:#c2410c; --warn-bg:#fff7ed; --warn-bd:#fed7aa;
  --bd:rgba(0,0,0,.07); --bd2:rgba(0,0,0,.12);
  --serif:'Playfair Display',Georgia,serif;
  --sans:'Inter',system-ui,sans-serif;
  --expo:cubic-bezier(.16,1,.3,1);
  --sh:0 1px 4px rgba(0,0,0,.07),0 4px 16px rgba(0,0,0,.05);
  --sh-h:0 4px 24px rgba(0,0,0,.12),0 1px 4px rgba(0,0,0,.08);
  --r:12px;
}

/* ── RESET ───────────────────────────────────────────────────── */
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{font-family:var(--sans);background:var(--page);color:var(--text);-webkit-font-smoothing:antialiased}
body{min-height:100vh}
a{color:inherit;text-decoration:none}
button{border:none;background:none;cursor:pointer;font:inherit}
ul{list-style:none}
table{border-collapse:collapse;width:100%}
svg{display:block}

/* ── SCREEN NAV ──────────────────────────────────────────────── */
.screen-nav{
  background:var(--navy);
  display:flex;align-items:center;gap:.75rem;
  padding:.85rem 1.25rem;
}
.nav-back{
  display:flex;align-items:center;justify-content:center;
  width:34px;height:34px;border-radius:8px;
  background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.1);
  color:rgba(240,230,200,.8);
  transition:background .2s,color .2s;flex-shrink:0;
}
.nav-back:hover{background:rgba(255,255,255,.14);color:var(--champagne)}
.nav-back svg{width:16px;height:16px;stroke:currentColor}
.nav-center{flex:1}
.nav-title{
  font-family:var(--serif);font-size:.95rem;font-weight:600;
  color:var(--champagne);letter-spacing:.02em;
}
.nav-sub{font-size:.7rem;color:rgba(240,230,200,.45);margin-top:1px}
.nav-action{
  width:34px;height:34px;border-radius:8px;
  background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.1);
  display:flex;align-items:center;justify-content:center;
  color:rgba(240,230,200,.7);
  transition:background .2s;flex-shrink:0;
}
.nav-action:hover{background:rgba(255,255,255,.14)}
.nav-action svg{width:16px;height:16px;stroke:currentColor}

/* ── HERO SECTION ────────────────────────────────────────────── */
.hero{
  background:linear-gradient(170deg,var(--navy2) 0%,var(--navy) 50%,var(--burg) 120%);
  padding:2rem 1.25rem 2.5rem;
  position:relative;overflow:hidden;
}
.hero::after{
  content:'';position:absolute;inset:0;
  background:radial-gradient(ellipse 70% 60% at 80% 110%,rgba(201,162,39,.12) 0%,transparent 60%);
  pointer-events:none;
}
.hero-portal{
  font-size:.68rem;letter-spacing:.14em;text-transform:uppercase;font-weight:500;
  color:rgba(201,162,39,.65);margin-bottom:1.5rem;display:flex;align-items:center;gap:.5rem;
}
.hero-portal::before{
  content:'';display:block;width:18px;height:1px;background:rgba(201,162,39,.4);
}
.hero-inner{
  display:flex;flex-direction:column;align-items:center;gap:1.5rem;
  position:relative;z-index:1;
}
.hero-ring-wrap{position:relative}
.gpa-ring{width:min(200px,55vw);height:min(200px,55vw)}

/* GPA Ring SVG text */
.ring-val{
  font-family:var(--serif);font-size:36px;font-weight:700;
  fill:var(--champagne);text-anchor:middle;dominant-baseline:auto;
}
.ring-scale{
  font-family:var(--sans);font-size:13px;font-weight:400;
  fill:rgba(240,230,200,.5);text-anchor:middle;
}
.ring-lbl{
  font-family:var(--sans);font-size:10px;font-weight:500;letter-spacing:.08em;
  text-transform:uppercase;fill:rgba(240,230,200,.35);text-anchor:middle;
}
.ring-rank{
  font-family:var(--serif);font-size:15px;font-weight:600;font-style:italic;
  fill:var(--gold-ll);text-anchor:middle;
}
.ring-thr-label{
  font-family:var(--sans);font-size:9px;
  fill:rgba(201,162,39,.55);text-anchor:middle;
}
@@keyframes glow-pulse{0%,100%{opacity:.8;r:6}50%{opacity:1;r:8}}
.ring-glow-dot{animation:glow-pulse 2.6s ease-in-out infinite}

.hero-info{text-align:center}
.hero-student{
  font-family:var(--serif);font-size:1.4rem;font-weight:600;
  color:var(--champagne);line-height:1.2;
}
.hero-meta-pills{
  display:flex;flex-wrap:wrap;justify-content:center;
  gap:.5rem;margin-top:.75rem;
}
.hero-pill{
  font-size:.68rem;font-weight:500;letter-spacing:.04em;
  padding:.25rem .7rem;border-radius:20px;
  background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.12);
  color:rgba(240,230,200,.7);
}
.hero-pill.gold{background:rgba(201,162,39,.14);border-color:rgba(201,162,39,.3);color:var(--gold-l)}

.hero-stat-row{
  display:flex;gap:1.5rem;margin-top:1.25rem;justify-content:center;
}
.hero-stat{text-align:center}
.hero-stat-val{
  font-family:var(--serif);font-size:1.4rem;font-weight:700;
  color:var(--champagne);line-height:1;
}
.hero-stat-lbl{
  font-size:.65rem;font-weight:500;letter-spacing:.07em;text-transform:uppercase;
  color:rgba(240,230,200,.4);margin-top:.3rem;
}
.hero-sep{width:1px;background:rgba(255,255,255,.12);align-self:stretch;margin:2px 0}

/* ── FILTER BAR ──────────────────────────────────────────────── */
.filter-bar{
  padding:.9rem 1.25rem;
  background:var(--card);
  border-bottom:1px solid var(--bd);
  position:sticky;top:0;z-index:50;
  display:flex;align-items:center;gap:.5rem;overflow-x:auto;
  scrollbar-width:none;
}
.filter-bar::-webkit-scrollbar{display:none}
.filter-lbl{
  font-size:.72rem;font-weight:600;letter-spacing:.06em;text-transform:uppercase;
  color:var(--stone);white-space:nowrap;flex-shrink:0;margin-right:.25rem;
}
.pill{
  display:flex;align-items:center;gap:.35rem;
  padding:.35rem .85rem;border-radius:20px;
  font-size:.78rem;font-weight:500;white-space:nowrap;
  background:transparent;border:1px solid var(--bd2);
  color:var(--text2);
  transition:background .2s,border-color .2s,color .2s;flex-shrink:0;
}
.pill:hover{background:var(--page);border-color:rgba(0,0,0,.18)}
.pill.active{background:var(--navy);border-color:transparent;color:var(--champagne)}
.pill-count{
  font-size:.65rem;font-weight:700;
  width:18px;height:18px;border-radius:50%;
  display:flex;align-items:center;justify-content:center;
  background:rgba(0,0,0,.08);
}
.pill.active .pill-count{background:rgba(255,255,255,.18)}

/* ── TRANSCRIPT BODY ─────────────────────────────────────────── */
.transcript-body{
  padding:.75rem 1rem 1rem;
  display:flex;flex-direction:column;gap:.65rem;
  max-width:1100px;margin:0 auto;
}

/* ── ACCORDION ───────────────────────────────────────────────── */
.acc-item{
  background:var(--card);border-radius:var(--r);
  border:1px solid var(--bd);box-shadow:var(--sh);
  overflow:hidden;
  transition:box-shadow .25s var(--expo);
}
.acc-item:hover{box-shadow:var(--sh-h)}
.acc-header{
  width:100%;display:flex;align-items:center;gap:.75rem;
  padding:1rem 1.1rem;cursor:pointer;
  background:transparent;text-align:left;
}
.acc-item.open .acc-header{
  background:var(--navy);
}
.acc-sem-name{
  flex:1;font-family:var(--serif);font-size:.95rem;font-weight:600;
  color:var(--text);letter-spacing:.01em;
}
.acc-item.open .acc-sem-name{color:var(--champagne)}
.acc-badges{display:flex;align-items:center;gap:.5rem;flex-shrink:0;margin-left:auto}
.acc-gpa-badge{
  font-size:.72rem;font-weight:600;
  padding:.22rem .6rem;border-radius:6px;
  background:var(--gold-dim);color:var(--gold);
  border:1px solid rgba(201,162,39,.22);
}
.acc-item.open .acc-gpa-badge{background:rgba(201,162,39,.2);border-color:rgba(201,162,39,.4)}
.acc-cr-badge{
  font-size:.7rem;font-weight:500;color:var(--stone);
}
.acc-item.open .acc-cr-badge{color:rgba(240,230,200,.55)}
.acc-icon{
  width:22px;height:22px;border-radius:5px;
  display:flex;align-items:center;justify-content:center;
  background:rgba(0,0,0,.05);flex-shrink:0;
  transition:background .2s,transform .3s var(--expo);
}
.acc-item.open .acc-icon{background:rgba(255,255,255,.12);transform:rotate(180deg)}
.acc-icon svg{width:13px;height:13px;stroke:var(--stone)}
.acc-item.open .acc-icon svg{stroke:rgba(240,230,200,.65)}
.acc-body{height:0;overflow:hidden;transition:height .35s var(--expo)}

/* ── COURSE TABLE ────────────────────────────────────────────── */
.course-table{width:100%;border-collapse:collapse}
.course-table thead tr{background:var(--page)}
.course-table th{
  font-size:.66rem;font-weight:600;letter-spacing:.07em;text-transform:uppercase;
  color:var(--stone);padding:.55rem .85rem;text-align:left;
  border-bottom:1px solid var(--bd);white-space:nowrap;
}
.course-table th:first-child{padding-left:1.1rem}
.course-table th:last-child {padding-right:1.1rem}
.course-table td{
  padding:.75rem .85rem;font-size:.83rem;
  border-bottom:1px solid rgba(0,0,0,.04);
  color:var(--text);vertical-align:middle;
}
.course-table td:first-child{padding-left:1.1rem}
.course-table td:last-child {padding-right:1.1rem}
.course-table tbody tr:last-child td{border-bottom:none}
.course-table tbody tr:hover td{background:rgba(0,0,0,.02)}
.course-table tbody tr.row-fail td{background:rgba(220,38,38,.025)}
.course-table tbody tr.row-fail:hover td{background:rgba(220,38,38,.04)}
.course-row[style*="display: none"]{display:none!important}
.course-name{font-weight:500;color:var(--text)}
.course-code{font-size:.72rem;color:var(--stone);margin-top:.15rem;font-variant-numeric:tabular-nums}
.score-val{font-variant-numeric:tabular-nums;font-size:.83rem;color:var(--text2)}
.score-total{font-weight:600;color:var(--text)}

/* Grade badges */
.gb{
  display:inline-flex;align-items:center;justify-content:center;
  min-width:32px;height:24px;padding:0 6px;border-radius:5px;
  font-size:.75rem;font-weight:700;border:1px solid;
}
.gb-a  {background:#fefce8;color:#92400e;border-color:#fde68a}
.gb-ap {background:#fffbeb;color:#78350f;border-color:#fcd34d}
.gb-bp {background:#f0f9ff;color:#0369a1;border-color:#bae6fd}
.gb-b  {background:#eff6ff;color:#1d4ed8;border-color:#bfdbfe}
.gb-cp {background:#f8fafc;color:#475569;border-color:#cbd5e1}
.gb-c  {background:#f8fafc;color:#64748b;border-color:#e2e8f0}
.gb-dp {background:#fff7ed;color:#c2410c;border-color:#fed7aa}
.gb-d  {background:#fff7ed;color:#b45309;border-color:#fecaca}
.gb-f  {background:#fef2f2;color:#dc2626;border-color:#fecaca;font-size:.8rem}

.pass-dot{width:18px;height:18px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;font-size:.75rem}
.pass-dot.ok  {background:#f0fdf4;color:#16a34a}
.pass-dot.fail{background:#fef2f2;color:#dc2626}

/* Semester summary row */
.sem-summary-row td{
  font-size:.75rem;font-weight:600;color:var(--stone);
  background:var(--page)!important;border-top:1px solid var(--bd)!important;
  padding-top:.6rem!important;padding-bottom:.6rem!important;
}
.sem-gpa-inline{color:var(--gold);font-weight:700}

/* ── EXPORT SECTION ──────────────────────────────────────────── */
.export-section{
  max-width:1100px;margin:0 auto;
  padding:.5rem 1rem 2rem;
}
/* Notice block — hiện với học sinh / phụ huynh thay vì nút PDF */
.export-notice{
  display:flex;align-items:flex-start;gap:1rem;
  padding:1.1rem 1.4rem;border-radius:var(--r);
  background:rgba(255,255,255,.6);
  border:1px dashed rgba(0,0,0,.15);
  color:var(--text2);
}
.export-notice-icon{
  width:36px;height:36px;border-radius:9px;flex-shrink:0;
  background:rgba(0,0,0,.05);border:1px solid rgba(0,0,0,.08);
  display:flex;align-items:center;justify-content:center;
  color:var(--stone);
}
.export-notice-icon svg{width:18px;height:18px;stroke:currentColor}
.export-notice-title{
  font-size:.85rem;font-weight:600;color:var(--text);margin-bottom:.3rem;
}
.export-notice-sub{
  font-size:.79rem;line-height:1.55;color:var(--text2);
}
.export-notice-sub strong{color:var(--text);font-weight:600}
.export-btn{
  position:relative;
  display:flex;align-items:center;gap:1.1rem;
  width:100%;padding:1.25rem 1.5rem;
  background:var(--navy);
  border:1px solid rgba(201,162,39,.22);
  border-radius:var(--r);
  cursor:pointer;overflow:hidden;
  transition:background .28s,border-color .28s,box-shadow .28s;
  text-decoration:none;
}
.export-btn::before{
  content:'';position:absolute;top:0;left:-100%;width:55%;height:100%;
  background:linear-gradient(90deg,transparent,rgba(201,162,39,.1),transparent);
  transform:skewX(-18deg);transition:left .6s ease;
}
.export-btn:hover::before{left:140%}
.export-btn:hover{
  background:var(--navy2);border-color:rgba(201,162,39,.45);
  box-shadow:0 0 30px rgba(201,162,39,.1);
}
.export-icon{
  width:44px;height:44px;border-radius:10px;flex-shrink:0;
  background:rgba(201,162,39,.12);border:1px solid rgba(201,162,39,.2);
  display:flex;align-items:center;justify-content:center;
  color:var(--gold-l);
  transition:background .2s;
}
.export-btn:hover .export-icon{background:rgba(201,162,39,.2)}
.export-icon svg{width:22px;height:22px;stroke:currentColor}
.export-text{flex:1}
.export-title{
  font-family:var(--serif);font-size:1rem;font-weight:600;
  color:var(--champagne);letter-spacing:.02em;
  display:flex;align-items:center;gap:.5rem;
}
.export-seal{
  font-size:.65rem;font-weight:600;letter-spacing:.06em;text-transform:uppercase;
  padding:.15rem .45rem;border-radius:4px;
  background:rgba(201,162,39,.18);color:var(--gold-l);
  border:1px solid rgba(201,162,39,.3);
}
.export-sub{
  font-size:.73rem;color:rgba(240,230,200,.4);margin-top:.25rem;
  font-style:italic;letter-spacing:.01em;
}
.export-arrow{color:rgba(201,162,39,.45);flex-shrink:0}
.export-arrow svg{width:20px;height:20px;stroke:currentColor}

/* Loading state */
.export-btn .btn-default{transition:opacity .2s}
.export-btn .btn-loading{
  position:absolute;inset:0;display:none;align-items:center;justify-content:center;gap:.75rem;
  background:inherit;border-radius:inherit;
  color:rgba(240,230,200,.7);font-size:.85rem;
}
.export-btn.loading .btn-default{opacity:0;pointer-events:none}
.export-btn.loading .btn-loading{display:flex}
.btn-spinner{
  width:20px;height:20px;border:2px solid rgba(201,162,39,.2);
  border-top-color:var(--gold-l);border-radius:50%;
  animation:spin .75s linear infinite;flex-shrink:0;
}
@@keyframes spin{to{transform:rotate(360deg)}}

/* ── RESPONSIVE ──────────────────────────────────────────────── */
.hide-sm{display:none}
@@media (min-width:680px){
  .hero-inner{flex-direction:row;gap:2.5rem;padding:0 1rem}
  .hero-info{text-align:left}
  .hero-meta-pills{justify-content:flex-start}
  .hero-stat-row{justify-content:flex-start}
  .gpa-ring{width:180px;height:180px}
  .transcript-body{padding:1.25rem 1.5rem 1.5rem}
  .export-section{padding:.75rem 1.5rem 2.5rem}
  .hide-sm{display:table-cell}
  .hide-sm-flex{display:flex}
}
@@media (min-width:900px){
  .hero{padding:2.5rem 2rem 3rem}
  .gpa-ring{width:200px;height:200px}
  .transcript-body{padding:1.5rem 2rem 2rem}
  .export-section{padding:1rem 2rem 3rem}
}

/* ─────────────────────────────────────────────────────────────── */
/* ██  PRINT MEDIA — OFFICIAL TRANSCRIPT LAYOUT                 ██ */
/* ─────────────────────────────────────────────────────────────── */
@@media print {
  @@page {
    size:A4 portrait;
    margin:18mm 22mm 22mm 22mm;
  }
  *, *::before, *::after{
    -webkit-print-color-adjust:exact;
    print-color-adjust:exact;
  }
  html,body{
    background:#fff!important;
    color:#000!important;
    font-family:'Times New Roman',Times,serif;
    font-size:10pt;
    line-height:1.5;
  }
  /* Hide all screen-only elements */
  .no-print,
  .screen-nav,
  .filter-bar,
  .export-section,
  .acc-icon,
  .hero-ring-wrap{display:none!important}
  /* Show print-only elements */
  .print-only{display:block!important}
  .print-header-grid{display:grid!important}
  .print-sigs{display:grid!important}
  /* Collapse hero to just student info */
  .hero{
    background:#fff!important;color:#000!important;
    padding:0 0 12pt 0;border:none;
  }
  .hero::after{display:none}
  .hero-portal{display:none}
  .hero-inner{display:block}
  .hero-info{text-align:left}
  .hero-student{font-size:11pt;font-weight:700;color:#000;font-family:'Times New Roman',serif}
  .hero-meta-pills,.hero-stat-row{display:none!important}
  /* Expand all accordions */
  .acc-item{
    border:none!important;border-radius:0!important;
    box-shadow:none!important;background:#fff!important;
    break-inside:avoid;page-break-inside:avoid;
  }
  .acc-body{height:auto!important;overflow:visible!important}
  .acc-header{
    background:#fff!important;padding:.5rem 0!important;
    border-bottom:1.5pt solid #000!important;cursor:auto;
  }
  .acc-sem-name{color:#000!important;font-size:11pt;font-weight:700}
  .acc-gpa-badge{
    background:#f5f5f5!important;color:#000!important;
    border:1pt solid #ccc!important;
  }
  .acc-cr-badge{color:#555!important}
  .acc-icon{display:none!important}
  /* Course table for print */
  .course-table{border:1pt solid #333;font-size:9pt;width:100%}
  .course-table thead tr{background:#f0f0f0!important}
  .course-table th{
    font-size:8pt;border:1pt solid #555;padding:4pt 6pt;color:#000;
    text-transform:uppercase;font-weight:700;
  }
  .course-table td{
    border:1pt solid #bbb;padding:4pt 6pt;color:#000;font-size:9pt;
  }
  .course-table tbody tr.row-fail td{background:#fff5f5!important}
  .gb{border:1pt solid #999!important;background:#f9f9f9!important;color:#000!important;font-size:8pt}
  .pass-dot.ok  {background:none!important;color:#006400}
  .pass-dot.fail{background:none!important;color:#cc0000}
  .hide-sm{display:table-cell!important}
  .course-name{font-weight:700}
  .course-code{font-size:8pt}
  /* Show semester summary */
  .sem-summary-row td{background:#f8f8f8!important;border-top:1.5pt solid #333!important;font-size:8.5pt}
  .transcript-body{padding:0;gap:12pt}
  .filter-bar{display:none!important}
}

/* ── PRINT-ONLY ELEMENTS (hidden on screen) ──────────────────── */
.print-only{display:none}
</style>
</head>
