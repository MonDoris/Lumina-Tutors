<!-- ╔════════════════════════════════════════════════════════════╗ -->
<!-- ║  HERO — GPA RING + STUDENT IDENTITY                       ║ -->
<!-- ╚════════════════════════════════════════════════════════════╝ -->
<section class="hero">
  <div class="hero-portal no-print">Lumina Tutors Academic Portal</div>
  <div class="hero-inner">

    <!-- GPA PROGRESS RING -->
    <div class="hero-ring-wrap no-print" aria-label="GPA @cumGpa / 4.0">
      <svg class="gpa-ring" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="arcGrad" gradientUnits="userSpaceOnUse" x1="60" y1="28" x2="140" y2="172">
            <stop offset="0%" stop-color="#e8c84a"/>
            <stop offset="60%" stop-color="#c9a227"/>
            <stop offset="100%" stop-color="#a07818"/>
          </linearGradient>
          <filter id="arcGlow" x="-25%" y="-25%" width="150%" height="150%">
            <feGaussianBlur in="SourceGraphic" stdDeviation="3.5" result="blur"/>
            <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
          </filter>
          <filter id="dotGlow" x="-80%" y="-80%" width="260%" height="260%">
            <feGaussianBlur in="SourceGraphic" stdDeviation="4" result="blur"/>
            <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
          </filter>
        </defs>

        <!-- Outer track -->
        <circle r="72" cx="100" cy="100"
          fill="none" stroke="rgba(255,255,255,.06)" stroke-width="10"
          stroke-dasharray="339.29 113.1" stroke-linecap="round"
          transform="rotate(135,100,100)"/>

        <!-- Track fill (dim) -->
        <circle r="72" cx="100" cy="100"
          fill="none" stroke="rgba(201,162,39,.1)" stroke-width="9"
          stroke-dasharray="339.29 113.1" stroke-linecap="round"
          transform="rotate(135,100,100)"/>

        <!-- "Giỏi" threshold marker at GPA 3.2/4.0 -->
        <circle r="4.5" cx="@thrX.ToString("F1")" cy="@thrY.ToString("F1")"
          fill="none" stroke="rgba(201,162,39,.55)" stroke-width="1.8"/>
        <text class="ring-thr-label"
          x="@((thrX + (thrX > 100 ? 12 : -12)).ToString("F0"))"
          y="@(thrY.ToString("F0"))">3.2</text>

        <!-- Progress arc (animated from 0 via JS) -->
        <circle r="72" cx="100" cy="100"
          id="ringProgress"
          fill="none" stroke="url(#arcGrad)" stroke-width="9"
          stroke-dasharray="0 452.39" stroke-linecap="round"
          transform="rotate(135,100,100)"
          filter="url(#arcGlow)"
          data-fill="@fillArc.ToString("F2")"
          data-gap="@gapArc.ToString("F2")"/>

        <!-- Glow dot at arc tip -->
        <circle class="ring-glow-dot" id="ringTipDot"
          cx="@tipX.ToString("F1")" cy="@tipY.ToString("F1")"
          r="6" fill="#e8c84a" opacity="0"
          filter="url(#dotGlow)"/>

        <!-- Center text -->
        <text class="ring-val" x="100" y="93">@cumGpa.ToString("F2")</text>
        <text class="ring-scale" x="100" y="111">/ 4.0 GPA</text>
        <text class="ring-lbl" x="100" y="127">Tích lũy</text>
        <text class="ring-rank" x="100" y="150">@gpaClass</text>
      </svg>
    </div>

    <!-- STUDENT INFO -->
    <div class="hero-info">
      <p class="hero-portal no-print" style="text-align:left;margin-bottom:.6rem;display:none" id="heroPortalInline">Lumina Tutors Academic Portal</p>
      <h1 class="hero-student">@studentName</h1>
      <div class="hero-meta-pills">
        <span class="hero-pill gold">@studentId</span>
        <span class="hero-pill">@program</span>
        <span class="hero-pill">@faculty</span>
        <span class="hero-pill">@academicYear</span>
      </div>
      <div class="hero-stat-row">
        <div class="hero-stat">
          <div class="hero-stat-val">@cumCredits<span style="font-size:.8rem;opacity:.6">/@totalCredits</span></div>
          <div class="hero-stat-lbl">Tín chỉ</div>
        </div>
        <div class="hero-sep"></div>
        <div class="hero-stat">
          <div class="hero-stat-val">20</div>
          <div class="hero-stat-lbl">Môn học</div>
        </div>
        <div class="hero-sep"></div>
        <div class="hero-stat">
          <div class="hero-stat-val">1</div>
          <div class="hero-stat-lbl">Chưa qua</div>
        </div>
        <div class="hero-sep"></div>
        <div class="hero-stat">
          <div class="hero-stat-val">@gpaClass</div>
          <div class="hero-stat-lbl">Xếp loại</div>
        </div>
      </div>
    </div>

  </div>
</section>


