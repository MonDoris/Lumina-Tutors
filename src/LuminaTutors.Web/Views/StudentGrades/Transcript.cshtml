<script>
(function () {
  'use strict';

  /* ── GPA RING ANIMATION ─────────────────────────────────────── */
  const ringEl = document.getElementById('ringProgress');
  const dotEl  = document.getElementById('ringTipDot');

  if (ringEl) {
    const fill = parseFloat(ringEl.dataset.fill || '0');
    const gap  = parseFloat(ringEl.dataset.gap  || '452');

    // Delay slightly, then animate
    setTimeout(() => {
      ringEl.style.transition = 'stroke-dasharray 1.5s cubic-bezier(.16,1,.3,1)';
      ringEl.style.strokeDasharray = fill + ' ' + gap;
    }, 400);

    // Reveal glow dot after ring finishes
    setTimeout(() => {
      if (dotEl) dotEl.style.opacity = '1';
    }, 2100);
  }

  /* ── ACCORDION ──────────────────────────────────────────────── */
  const accItems = document.querySelectorAll('.acc-item');

  function openItem(item) {
    const body   = item.querySelector('.acc-body');
    const btn    = item.querySelector('.acc-header');
    const height = body.scrollHeight;

    item.classList.add('open');
    btn.setAttribute('aria-expanded', 'true');
    body.style.height = height + 'px';

    body.addEventListener('transitionend', () => {
      // Allow natural reflow after open
      if (item.classList.contains('open')) body.style.height = 'auto';
    }, { once: true });
  }

  function closeItem(item) {
    const body = item.querySelector('.acc-body');
    const btn  = item.querySelector('.acc-header');

    // Pin height before transition
    body.style.height = body.scrollHeight + 'px';
    requestAnimationFrame(() => {
      body.style.transition = 'height .32s cubic-bezier(.16,1,.3,1)';
      body.style.height = '0';
    });

    item.classList.remove('open');
    btn.setAttribute('aria-expanded', 'false');
  }

  accItems.forEach(item => {
    const btn = item.querySelector('.acc-header');
    btn.addEventListener('click', () => {
      if (item.classList.contains('open')) {
        closeItem(item);
      } else {
        openItem(item);
      }
    });
  });

  // Open first accordion by default
  if (accItems.length > 0) openItem(accItems[0]);

  /* ── FILTER PILLS ───────────────────────────────────────────── */
  const pills   = document.querySelectorAll('.pill');
  const rows    = document.querySelectorAll('.course-row');

  function applyFilter(filter) {
    rows.forEach(row => {
      const pass = row.dataset.pass === 'true';
      const show = filter === 'all' ||
                   (filter === 'pass' && pass) ||
                   (filter === 'fail' && !pass);
      row.style.display = show ? '' : 'none';
    });

    // Auto-open semesters that contain visible matching courses
    // Auto-close semesters that are entirely hidden (unless filter=all)
    accItems.forEach(item => {
      const visibleRows = item.querySelectorAll('.course-row:not([style*="display: none"])');
      if (filter !== 'all' && visibleRows.length === 0) {
        if (item.classList.contains('open')) closeItem(item);
      } else if (filter !== 'all' && visibleRows.length > 0) {
        if (!item.classList.contains('open')) openItem(item);
      }
    });
  }

  pills.forEach(pill => {
    pill.addEventListener('click', () => {
      pills.forEach(p => p.classList.remove('active'));
      pill.classList.add('active');
      applyFilter(pill.dataset.filter);
    });
  });

  /* ── EXPORT BUTTON LOADING ──────────────────────────────────── */
  const exportBtn = document.getElementById('exportBtn');

  if (exportBtn) {
    exportBtn.addEventListener('click', function (e) {
      if (this.classList.contains('loading')) {
        e.preventDefault();
        return;
      }
      this.classList.add('loading');
      this.setAttribute('aria-disabled', 'true');

      // Reset after 6 seconds (allows time for download to initiate)
      setTimeout(() => {
        this.classList.remove('loading');
        this.removeAttribute('aria-disabled');
      }, 6000);
    });
  }

})();
</script>
