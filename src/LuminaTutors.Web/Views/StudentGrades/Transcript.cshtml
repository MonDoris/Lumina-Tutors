      <svg viewBox="0 0 80 92" width="56" style="display:inline-block">
        <polygon points="40,4 72,22 72,70 40,88 8,70 8,22" fill="none" stroke="#000" stroke-width="2"/>
        <polygon points="40,14 63,28 63,63 40,78 17,63 17,28" fill="none" stroke="#000" stroke-width="1.2"/>
        <line x1="40" y1="28" x2="40" y2="60" stroke="#000" stroke-width="2.5" stroke-linecap="round"/>
        <path d="M40,16 Q52,24 50,30 Q44,24 40,30 Q36,24 30,30 Q28,24 40,16Z" fill="none" stroke="#000" stroke-width="1.5"/>
        <rect x="14" y="63" width="22" height="14" fill="none" stroke="#000" stroke-width="1.5"/>
        <rect x="44" y="63" width="22" height="14" fill="none" stroke="#000" stroke-width="1.5"/>
        <line x1="40" y1="64" x2="40" y2="76" stroke="#000" stroke-width="1.8"/>
      </svg>
    </div>
    <!-- School info -->
    <div>
      <div style="font-size:8pt;letter-spacing:.08em;text-transform:uppercase;color:#333">LUMINA TUTORS EDUCATION SYSTEM</div>
      <div style="font-size:7.5pt;color:#555;margin-top:1pt">@faculty</div>
    </div>
  </div>
  <div style="text-align:center;margin-top:10pt">
    <div style="font-size:9pt;font-weight:700;letter-spacing:.06em">CỘNG HÒA XÃ HỘI CHỦ NGHĨA VIỆT NAM</div>
    <div style="font-size:8.5pt;margin-top:2pt">Độc lập &mdash; Tự do &mdash; Hạnh phúc</div>
    <div style="border-bottom:1pt solid #000;width:140pt;margin:4pt auto"></div>
  </div>
  <div style="text-align:center;margin-top:10pt">
    <div style="font-family:'Times New Roman',serif;font-size:16pt;font-weight:700;letter-spacing:.04em">BẢNG ĐIỂM SINH VIÊN CHÍNH THỨC</div>
    <div style="font-size:9pt;font-style:italic;color:#444;margin-top:3pt">(Official Academic Transcript)</div>
  </div>
  <!-- Student info grid -->
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:6pt 24pt;margin-top:14pt;font-size:9.5pt">
    <div><b>Họ và tên:</b> @studentName</div>
    <div><b>Mã sinh viên:</b> @studentId</div>
    <div><b>Chương trình:</b> @program</div>
    <div><b>Khoá:</b> @academicYear</div>
    <div><b>Khoa:</b> @faculty</div>
    <div><b>Ngày in:</b> @now.ToString("dd/MM/yyyy")</div>
    <div><b>GPA Tích lũy:</b> @cumGpa.ToString("F2") / 4.0</div>
    <div><b>Xếp loại:</b> @gpaClass</div>
    <div><b>Tín chỉ tích lũy:</b> @cumCredits / @totalCredits</div>
  </div>
</header>


