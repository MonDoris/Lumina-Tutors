@model LuminaTutors.Application.DTOs.Subscription.PlanEditRequest
@{ var m = Model; }

<div style="display:grid;grid-template-columns:1fr 90px;gap:10px">
    <div>
        <label class="lt-label">Mã gói</label>
        <input name="PlanCode" class="lt-input" value="@m?.PlanCode" placeholder="VD: PREMIUM" required maxlength="30" />
    </div>
    <div>
        <label class="lt-label">Bậc</label>
        <input name="Tier" type="number" min="0" max="99" class="lt-input" value="@(m?.Tier ?? 1)" />
    </div>
</div>

<div style="margin-top:8px">
    <label class="lt-label">Tên gói</label>
    <input name="Name" class="lt-input" value="@m?.Name" required maxlength="100" />
</div>

<div style="margin-top:8px">
    <label class="lt-label">Mô tả</label>
    <textarea name="Description" class="lt-input" rows="2" maxlength="500">@m?.Description</textarea>
</div>

<div class="price-linker" style="margin-top:8px">
    <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px">
        <div>
            <label class="lt-label">Giá/tháng</label>
            <input name="MonthlyPrice" type="number" step="1000" min="0" class="lt-input price-m" value="@((m?.MonthlyPrice ?? 0m).ToString("0"))" />
        </div>
        <div>
            <label class="lt-label">Giá/quý</label>
            <input name="QuarterlyPrice" type="number" step="1000" min="0" class="lt-input price-q" value="@((m?.QuarterlyPrice ?? 0m).ToString("0"))" />
        </div>
        <div>
            <label class="lt-label">Giá/năm</label>
            <input name="YearlyPrice" type="number" step="1000" min="0" class="lt-input price-y" value="@((m?.YearlyPrice ?? 0m).ToString("0"))" />
        </div>
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;margin-top:6px;align-items:end">
        <div style="font-size:.72rem;color:#94a3b8;padding-bottom:9px">Giá tháng là gốc — quý/năm tự tính theo % giảm</div>
        <div>
            <label class="lt-label" style="font-size:.74rem">% giảm quý</label>
            <input type="number" step="0.5" min="0" max="100" class="lt-input disc-q" />
        </div>
        <div>
            <label class="lt-label" style="font-size:.74rem">% giảm năm</label>
            <input type="number" step="0.5" min="0" max="100" class="lt-input disc-y" />
        </div>
    </div>
</div>

<div style="display:flex;gap:18px;margin-top:12px">
    <label style="display:flex;align-items:center;gap:6px;font-size:.85rem;color:#475569">
        <input type="checkbox" name="IncludesAiTutor" value="true" checked="@(m?.IncludesAiTutor == true)" /> Gồm Gia Sư AI
    </label>
    <label style="display:flex;align-items:center;gap:6px;font-size:.85rem;color:#475569">
        <input type="checkbox" name="IncludesVirtualLab" value="true" checked="@(m?.IncludesVirtualLab == true)" /> Gồm Phòng 3D
    </label>
</div>

@* ── Giới hạn tài khoản theo vai trò & lớp học ─────────────────────── *@
<div style="margin-top:14px;padding-top:12px;border-top:1px dashed #e2e8f0">
    <label class="lt-label" style="display:block;margin-bottom:2px">Giới hạn tài khoản &amp; lớp học</label>
    <div style="font-size:.72rem;color:#94a3b8;margin-bottom:8px">Nhập <b>-1</b> = không giới hạn. 0 = không cho phép tạo.</div>
    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:10px 12px;align-items:end">
        <div>
            <label class="lt-label" style="font-size:.74rem">Giáo viên</label>
            <input name="MaxTeachers" type="number" min="-1" class="lt-input" value="@(m?.MaxTeachers ?? -1)" />
        </div>
        <div>
            <label class="lt-label" style="font-size:.74rem">Học sinh</label>
            <input name="MaxStudents" type="number" min="-1" class="lt-input" value="@(m?.MaxStudents ?? -1)" />
        </div>
        <div>
            <label class="lt-label" style="font-size:.74rem">Phụ huynh</label>
            <input name="MaxParents" type="number" min="-1" class="lt-input" value="@(m?.MaxParents ?? -1)" />
        </div>
        <div>
            <label class="lt-label" style="font-size:.74rem">Quản trị trường</label>
            <input name="MaxAdmins" type="number" min="-1" class="lt-input" value="@(m?.MaxAdmins ?? -1)" />
        </div>
        <div>
            <label class="lt-label" style="font-size:.74rem">Kế toán</label>
            <input name="MaxAccountants" type="number" min="-1" class="lt-input" value="@(m?.MaxAccountants ?? -1)" />
        </div>
        <div>
            <label class="lt-label" style="font-size:.74rem">Giám thị</label>
            <input name="MaxSupervisors" type="number" min="-1" class="lt-input" value="@(m?.MaxSupervisors ?? -1)" />
        </div>
        <div>
            <label class="lt-label" style="font-size:.74rem">Số lớp học</label>
            <input name="MaxClasses" type="number" min="-1" class="lt-input" value="@(m?.MaxClasses ?? -1)" />
        </div>
    </div>
</div>

<script>
if (!window.__planPriceLinker) {
    window.__planPriceLinker = true;
    var num   = function (el) { return parseFloat(el.value) || 0; };
    var r1000 = function (v)  { return Math.round(v / 1000) * 1000; };
    var pct1  = function (v)  { return Math.round(v * 10) / 10; };
    var pick  = function (b, sel) { return b.querySelector(sel); };

    function recalcFromMonthly(b) {
        var m = num(pick(b, '.price-m'));
        pick(b, '.price-q').value = r1000(m * 3  * (1 - num(pick(b, '.disc-q')) / 100));
        pick(b, '.price-y').value = r1000(m * 12 * (1 - num(pick(b, '.disc-y')) / 100));
    }
    function discFromQuarter(b) {
        var m = num(pick(b, '.price-m')), q = num(pick(b, '.price-q'));
        pick(b, '.disc-q').value = m > 0 ? pct1((1 - q / (m * 3)) * 100) : 0;
    }
    function discFromYear(b) {
        var m = num(pick(b, '.price-m')), y = num(pick(b, '.price-y'));
        pick(b, '.disc-y').value = m > 0 ? pct1((1 - y / (m * 12)) * 100) : 0;
    }

    document.addEventListener('input', function (e) {
        var b = e.target.closest && e.target.closest('.price-linker');
        if (!b) return;
        var cl = e.target.classList;
        if      (cl.contains('price-m')) recalcFromMonthly(b);
        else if (cl.contains('disc-q'))  pick(b, '.price-q').value = r1000(num(pick(b, '.price-m')) * 3  * (1 - num(e.target) / 100));
        else if (cl.contains('disc-y'))  pick(b, '.price-y').value = r1000(num(pick(b, '.price-m')) * 12 * (1 - num(e.target) / 100));
        else if (cl.contains('price-q')) discFromQuarter(b);
        else if (cl.contains('price-y')) discFromYear(b);
    });

    function initAll() {
        document.querySelectorAll('.price-linker').forEach(function (b) { discFromQuarter(b); discFromYear(b); });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initAll);
    else initAll();
}
</script>
