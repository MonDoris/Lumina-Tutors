@using LuminaTutors.Application.DTOs.Subscription
@model IReadOnlyList<SchoolAccountDto>
@{
    ViewData["Title"] = "Quản lý trường";
    var ownSchoolId = (int)(ViewBag.OwnSchoolId ?? 0);

    // ID hiển thị (không phải khóa chính): trường hệ thống (Demo = trường của Sysadmin) = 0,
    // các trường khác đánh 1, 2, 3… theo thứ tự SchoolId. Lỗ hổng do xóa trường không ảnh hưởng.
    var displayNo = new Dictionary<int, int>();
    var seq = 0;
    foreach (var sc in Model.OrderBy(x => x.SchoolId))
        displayNo[sc.SchoolId] = sc.SchoolId == ownSchoolId ? 0 : ++seq;

    string Initials(string name)
    {
        var parts = (name ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "?";
        if (parts.Length == 1) return parts[0].Substring(0, 1).ToUpperInvariant();
        return (parts[0].Substring(0,1) + parts[^1].Substring(0,1)).ToUpperInvariant();
    }
}

@section Styles {
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&family=Fraunces:ital,opsz,wght@0,9..144,500..900;1,9..144,500..700&family=JetBrains+Mono:wght@500;700&display=swap">
    <link rel="stylesheet" href="~/css/esell.css" asp-append-version="true" />
}

<div class="sx">

    <!-- ══ HERO ══ -->
    <section class="sx-hero" data-rise>
        <div class="sx-hero__inner">
            <div class="sx-hero__top">
                <div>
                    <span class="sx-eyebrow"><span class="dot"></span> Lumina Command · Quản trị tenant</span>
                    <h1>Quản lý <span class="accent">tài khoản trường</span></h1>
                    <p>Tạo, cập nhật, tạm khóa và xoá tài khoản Nhà trường trên nền tảng.</p>
                </div>
                <div style="display:flex;gap:10px;flex-wrap:wrap">
                    <button type="button" class="sx-btn sx-btn--gold"
                            onclick="document.getElementById('onboardCard').style.display='block';this.style.display='none';document.getElementById('obSchoolName').focus()">
                        <i class="bi bi-building-add"></i> Thêm trường
                    </button>
                    <a asp-action="Subscriptions" class="sx-btn sx-btn--ghost"><i class="bi bi-grid-1x2"></i> Bảng điều khiển</a>
                </div>
            </div>
        </div>
    </section>

    <!-- ══ ONBOARD ══ -->
    <div class="sx-panel" id="onboardCard" style="display:none" data-rise>
        <div class="sx-panel__b">
            <div class="sx-sec-head" style="margin-top:0">
                <h2 class="sx-sec-title"><span class="bar"></span> Tạo trường mới &amp; tài khoản Nhà trường</h2>
            </div>
            <form asp-action="OnboardSchool" method="post">
                @Html.AntiForgeryToken()
                <div class="sx-grid2">
                    <div class="sx-field"><label>Tên trường</label>
                        <input id="obSchoolName" name="SchoolName" class="sx-input" required maxlength="150" placeholder="VD: THPT Nguyễn Du" /></div>
                    <div class="sx-field"><label>Người quản trị (Nhà trường)</label>
                        <input name="AdminFullName" class="sx-input" required maxlength="150" placeholder="VD: Nguyễn Văn A" /></div>
                    <div class="sx-field"><label>Email đăng nhập</label>
                        <input name="AdminEmail" type="email" class="sx-input" required maxlength="150" placeholder="admin@truong.edu.vn" /></div>
                    <div class="sx-field"><label>Mật khẩu tạm (≥ 6 ký tự)</label>
                        <input name="AdminPassword" type="text" class="sx-input" required minlength="6" maxlength="100" placeholder="Cấp cho Nhà trường" /></div>
                </div>
                <div style="display:flex;gap:10px;margin-top:16px">
                    <button type="submit" class="sx-btn sx-btn--gold"><i class="bi bi-check-lg"></i> Tạo trường</button>
                    <button type="button" class="sx-btn sx-btn--light" onclick="document.getElementById('onboardCard').style.display='none'">Hủy</button>
                </div>
            </form>
        </div>
    </div>

    <div class="sx-sec-head">
        <h2 class="sx-sec-title"><span class="bar"></span> Danh sách trường</h2>
        <span class="sx-pill sx-pill--info">@Model.Count trường</span>
    </div>

    <!-- ══ SCHOOL CARDS ══ -->
    <div class="sx-grid-cards">
        @foreach (var s in Model.OrderBy(x => displayNo[x.SchoolId]))
        {
            var isOwn = s.SchoolId == ownSchoolId;
            <div class="sx-card @(s.IsActive ? "" : "is-off")" data-rise style="@(s.IsActive ? "" : "opacity:.7")">
                <div class="sx-card__b">
                    <div class="sx-plan__head">
                        <div class="sx-school">
                            <div class="sx-ava">@Initials(s.SchoolName)</div>
                            <div>
                                <div class="nm">@s.SchoolName</div>
                                <div class="sub mono">ID: @displayNo[s.SchoolId].ToString("D3")</div>
                            </div>
                        </div>
                        <div style="display:flex;align-items:center;gap:6px">
                            @if (isOwn) { <span class="sx-pill sx-pill--gold">Của bạn</span> }
                            @if (s.IsActive) { <span class="sx-pill sx-pill--ok">Hoạt động</span> }
                            else { <span class="sx-pill sx-pill--off">Tạm khóa</span> }
                        </div>
                    </div>

                    <div class="sx-divider"></div>

                    <div style="font-size:.88rem;display:flex;align-items:center;gap:8px">
                        <i class="bi bi-person-badge" style="color:var(--indigo)"></i>
                        <b>@(s.AdminFullName ?? "— chưa có quản trị —")</b>
                        @if (s.AdminUserId > 0)
                        {
                            @if (s.AdminActive) { <span class="sx-pill sx-pill--ok" style="margin-left:auto">Mở</span> }
                            else { <span class="sx-pill sx-pill--off" style="margin-left:auto">Khóa</span> }
                        }
                    </div>
                    <div class="mono" style="font-size:.8rem;color:var(--muted);margin-top:4px">
                        <i class="bi bi-envelope"></i> @(s.AdminEmail ?? "—")
                    </div>

                    <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-top:12px">
                        @if (!string.IsNullOrEmpty(s.PlanName))
                        {
                            <span class="sx-pill @(s.SubscriptionActive ? "sx-pill--gold" : "sx-pill--off")">@s.PlanName</span>
                        }
                        else
                        {
                            <span class="sx-pill sx-pill--off">Chưa đăng ký</span>
                        }
                        <span class="sub mono" style="font-size:.78rem;color:var(--muted)">
                            <i class="bi bi-people"></i> @s.UserCount · <i class="bi bi-mortarboard"></i> @s.StudentCount · <i class="bi bi-building"></i> @s.ClassCount
                        </span>
                    </div>

                    <!-- actions -->
                    <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:16px">
                        <a asp-action="SchoolDetail" asp-route-id="@s.SchoolId" class="sx-btn sx-btn--gold sx-btn--sm">
                            <i class="bi bi-eye"></i> Chi tiết
                        </a>
                        <button type="button" class="sx-btn sx-btn--light sx-btn--sm"
                                onclick="var e=document.getElementById('se-@s.SchoolId');e.style.display=e.style.display==='block'?'none':'block'">
                            <i class="bi bi-pencil-square"></i> Chỉnh sửa
                        </button>
                        <button type="button" class="sx-btn sx-btn--light sx-btn--sm"
                                onclick="var e=document.getElementById('sr-@s.SchoolId');e.style.display=e.style.display==='block'?'none':'block'">
                            <i class="bi bi-key"></i> Đặt lại MK
                        </button>
                        @if (!isOwn)
                        {
                            <form asp-action="ToggleSchoolActive" method="post" style="display:inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@s.SchoolId" />
                                <button type="submit" class="sx-btn sx-btn--light sx-btn--sm">
                                    <i class="bi @(s.IsActive ? "bi-pause-circle" : "bi-play-circle")"></i> @(s.IsActive ? "Tạm khóa" : "Mở khóa")
                                </button>
                            </form>
                            <form asp-action="DeleteSchool" method="post" style="display:inline"
                                  data-name="@s.SchoolName"
                                  data-hasdata="@((s.StudentCount > 0 || s.ClassCount > 0 || s.UserCount > 1).ToString().ToLowerInvariant())"
                                  onsubmit="return confirmDeleteSchool(this);">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@s.SchoolId" />
                                <button type="submit" class="sx-btn sx-btn--danger sx-btn--sm"><i class="bi bi-trash3"></i> Xóa</button>
                            </form>
                        }
                    </div>

                    <!-- edit form -->
                    <div id="se-@s.SchoolId" class="sx-edit" style="display:none">
                        <form asp-action="UpdateSchool" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="SchoolId" value="@s.SchoolId" />
                            <div class="sx-field" style="margin-bottom:10px">
                                <label>Tên trường</label>
                                <input name="SchoolName" class="sx-input" value="@s.SchoolName" required maxlength="150" />
                            </div>
                            <div class="sx-grid2">
                                <div class="sx-field"><label>Tên quản trị</label>
                                    <input name="AdminFullName" class="sx-input" value="@s.AdminFullName" required maxlength="150" /></div>
                                <div class="sx-field"><label>Email đăng nhập</label>
                                    <input name="AdminEmail" type="email" class="sx-input" value="@s.AdminEmail" required maxlength="150" /></div>
                            </div>
                            <label class="sx-check" style="margin-top:12px">
                                <input type="checkbox" name="AdminActive" value="true" checked="@(s.AdminActive)" /> Cho phép tài khoản đăng nhập
                            </label>
                            <button type="submit" class="sx-btn sx-btn--primary sx-btn--block" style="margin-top:14px">
                                <i class="bi bi-save"></i> Lưu thay đổi
                            </button>
                        </form>
                    </div>

                    <!-- reset password form -->
                    <div id="sr-@s.SchoolId" class="sx-edit" style="display:none">
                        <form asp-action="ResetSchoolPassword" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@s.SchoolId" />
                            <div class="sx-field">
                                <label>Mật khẩu mới cho Nhà trường (≥ 6 ký tự)</label>
                                <input name="newPassword" type="text" class="sx-input" required minlength="6" maxlength="100" placeholder="Nhập mật khẩu mới" />
                            </div>
                            <button type="submit" class="sx-btn sx-btn--primary sx-btn--block" style="margin-top:12px">
                                <i class="bi bi-key"></i> Đặt lại mật khẩu
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>

</div>

<!-- ══ MODAL XÁC NHẬN XÓA TRƯỜNG ══ -->
<div id="delSchoolModal" class="dsm" aria-hidden="true">
    <div class="dsm__backdrop" data-dsm-close></div>
    <div class="dsm__card" role="dialog" aria-modal="true" aria-labelledby="dsmTitle">
        <div class="dsm__icon"><i class="bi bi-trash3-fill"></i></div>
        <h3 class="dsm__title" id="dsmTitle">Xóa trường vĩnh viễn?</h3>
        <p class="dsm__text">
            Bạn sắp xóa trường <b id="dsmName" class="dsm__name">—</b> cùng <b>toàn bộ</b> dữ liệu liên quan
            (tài khoản, lớp, điểm, điểm danh, gói đăng ký…).
        </p>

        <div class="dsm__warn" id="dsmWarn">
            <i class="bi bi-exclamation-octagon-fill"></i>
            <div>Trường này <b>đang có dữ liệu</b>. Sau khi xóa sẽ <b>không thể khôi phục</b>.</div>
        </div>

        <label class="dsm__label" for="dsmInput">Gõ <b>XÓA</b> để xác nhận</label>
        <input id="dsmInput" class="dsm__input" type="text" autocomplete="off" spellcheck="false" placeholder="XÓA" />

        <div class="dsm__actions">
            <button type="button" class="dsm__btn dsm__btn--ghost" data-dsm-close>Hủy</button>
            <button type="button" class="dsm__btn dsm__btn--danger" id="dsmConfirm" disabled>
                <i class="bi bi-trash3"></i> Xóa vĩnh viễn
            </button>
        </div>
    </div>
</div>

<style>
    .dsm { position:fixed; inset:0; z-index:1080; display:none; align-items:center; justify-content:center; padding:20px; }
    .dsm.is-open { display:flex; }
    .dsm__backdrop { position:absolute; inset:0; background:rgba(8,15,30,.55); backdrop-filter:blur(4px); animation:dsmFade .18s ease; }
    .dsm__card {
        position:relative; width:100%; max-width:440px; background:#fff; border-radius:20px;
        padding:26px 26px 22px; box-shadow:0 24px 60px rgba(8,15,30,.32); text-align:center;
        animation:dsmPop .2s cubic-bezier(.2,.9,.3,1.2);
    }
    .dsm__icon {
        width:62px; height:62px; margin:0 auto 14px; border-radius:50%;
        display:grid; place-items:center; font-size:1.7rem; color:#dc2626;
        background:radial-gradient(circle at 50% 40%, #fee2e2, #fecaca);
    }
    .dsm__title { margin:0 0 8px; font-size:1.2rem; font-weight:800; color:var(--lt-navy,#0f2440); }
    .dsm__text { margin:0 0 14px; font-size:.9rem; line-height:1.5; color:#475569; }
    .dsm__name { color:#0f2440; }
    .dsm__warn {
        display:none; gap:10px; text-align:left; align-items:flex-start;
        background:#fff7ed; border:1px solid #fed7aa; color:#9a3412;
        border-radius:12px; padding:11px 13px; font-size:.82rem; line-height:1.45; margin-bottom:16px;
    }
    .dsm__warn.is-on { display:flex; }
    .dsm__warn i { font-size:1.05rem; color:#ea580c; margin-top:1px; flex:none; }
    .dsm__label { display:block; text-align:left; font-size:.82rem; color:#64748b; margin-bottom:6px; }
    .dsm__label b { color:#dc2626; letter-spacing:.04em; }
    .dsm__input {
        width:100%; box-sizing:border-box; padding:11px 14px; font-size:1rem; font-weight:700; letter-spacing:.1em;
        text-align:center; border:1.5px solid #e2e8f0; border-radius:12px; outline:none; transition:.15s;
    }
    .dsm__input:focus { border-color:#dc2626; box-shadow:0 0 0 3px rgba(220,38,38,.14); }
    .dsm__actions { display:flex; gap:10px; margin-top:18px; }
    .dsm__btn {
        flex:1; padding:12px 16px; border-radius:12px; font-size:.9rem; font-weight:700; cursor:pointer;
        border:1px solid transparent; transition:.15s; display:inline-flex; align-items:center; justify-content:center; gap:7px;
    }
    .dsm__btn--ghost { background:#f1f5f9; color:#334155; }
    .dsm__btn--ghost:hover { background:#e2e8f0; }
    .dsm__btn--danger { background:#dc2626; color:#fff; }
    .dsm__btn--danger:hover:not(:disabled) { background:#b91c1c; }
    .dsm__btn--danger:disabled { opacity:.45; cursor:not-allowed; }
    @@keyframes dsmFade { from { opacity:0 } to { opacity:1 } }
    @@keyframes dsmPop  { from { opacity:0; transform:translateY(12px) scale(.96) } to { opacity:1; transform:none } }
</style>

<script>
    (function () {
        var modal   = document.getElementById('delSchoolModal');
        if (!modal) return;
        var nameEl  = document.getElementById('dsmName');
        var warnEl  = document.getElementById('dsmWarn');
        var input   = document.getElementById('dsmInput');
        var confirm = document.getElementById('dsmConfirm');
        var pending = null;            // form đang chờ xóa

        function open(form) {
            pending = form;
            nameEl.textContent = form.dataset.name || 'trường này';
            warnEl.classList.toggle('is-on', form.dataset.hasdata === 'true');
            input.value = '';
            confirm.disabled = true;
            modal.classList.add('is-open');
            modal.setAttribute('aria-hidden', 'false');
            setTimeout(function () { input.focus(); }, 50);
        }
        function close() {
            modal.classList.remove('is-open');
            modal.setAttribute('aria-hidden', 'true');
            pending = null;
        }
        // Chấp nhận mọi cách gõ "xóa": có/không dấu, hoa/thường, dấu thanh đặt ở vị trí nào
        // (XÓA, XOÁ, xoa, Xoá… đều hợp lệ) bằng cách bỏ dấu rồi so khớp.
        function valid() {
            var t = (input.value || '').normalize('NFD').toUpperCase().replace(/[^A-Z]/g, '');
            return t === 'XOA';
        }

        input.addEventListener('input', function () { confirm.disabled = !valid(); });
        input.addEventListener('keydown', function (e) {
            if (e.key === 'Enter' && valid()) { e.preventDefault(); confirm.click(); }
        });
        confirm.addEventListener('click', function () {
            if (valid() && pending) { var f = pending; pending = null; f.submit(); }
        });
        modal.querySelectorAll('[data-dsm-close]').forEach(function (el) {
            el.addEventListener('click', close);
        });
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && modal.classList.contains('is-open')) close();
        });

        // Hàm gọi từ onsubmit của form xóa — mở modal, chặn submit mặc định.
        window.confirmDeleteSchool = function (form) { open(form); return false; };
    })();
</script>
