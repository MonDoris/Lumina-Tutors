@using LuminaTutors.Application.DTOs.Subscription
@using LuminaTutors.Domain.Enums
@model CatalogDto
@{
    ViewData["Title"] = "Quản lý gói E-Selling";
    var maxTier = Model.Plans.Count > 0 ? Model.Plans.Max(p => p.Tier) : 0;
    string QRoleLabel(RoleCode? r) => r switch
    {
        RoleCode.Teacher    => "Giáo viên",
        RoleCode.Student    => "Học sinh",
        RoleCode.Parent     => "Phụ huynh",
        RoleCode.Admin      => "Quản trị trường",
        RoleCode.Accountant => "Kế toán",
        RoleCode.Supervisor => "Giám thị",
        _                   => "Lớp học"
    };
    string QLim(int v) => v < 0 ? "∞" : v.ToString("N0");
}

@section Styles {
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&family=Fraunces:ital,opsz,wght@0,9..144,500..900;1,9..144,500..700&family=JetBrains+Mono:wght@500;700&display=swap">
    <link rel="stylesheet" href="~/css/esell.css" asp-append-version="true" />
}

<div class="sx">

    <!-- ══ HERO ══ -->
    <section class="sx-hero" data-rise>
        <div class="sx-hero__inner">
            <div class="sx-hero__top">
                <div>
                    <span class="sx-eyebrow"><span class="dot"></span> Lumina Command · Danh mục sản phẩm</span>
                    <h1>Quản lý <span class="accent">gói &amp; tính năng</span></h1>
                    <p>Thiết kế gói dịch vụ, định giá và bật/tắt các tính năng số bán cho nhà trường.</p>
                </div>
                <div style="display:flex;gap:10px;flex-wrap:wrap">
                    <a asp-action="Subscriptions" class="sx-btn sx-btn--ghost"><i class="bi bi-grid-1x2"></i> Bảng điều khiển</a>
                </div>
            </div>
        </div>
    </section>

    <!-- ══ PLANS ══ -->
    <div class="sx-sec-head">
        <h2 class="sx-sec-title"><span class="bar"></span> Gói dịch vụ</h2>
        <button class="sx-btn sx-btn--gold sx-btn--sm" type="button"
                onclick="document.getElementById('newPlan').style.display='flex';this.style.display='none'">
            <i class="bi bi-plus-lg"></i> Thêm gói
        </button>
    </div>

    <div class="sx-grid-cards" style="margin-bottom:32px">

        <!-- form thêm gói mới -->
        <div class="sx-card sx-plan" id="newPlan" style="display:none" data-rise>
            <div class="sx-card__b">
                <h3 class="sx-plan__name">Gói mới</h3>
                <form asp-action="SavePlan" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="IsActive" value="true" />
                    <div class="sx-edit" style="border-top:none;margin-top:10px;padding-top:0">
                        @await Html.PartialAsync("_PlanFields", (PlanEditRequest?)null)
                    </div>
                    <button type="submit" class="sx-btn sx-btn--gold sx-btn--block" style="margin-top:14px">
                        <i class="bi bi-check-lg"></i> Tạo gói
                    </button>
                </form>
            </div>
        </div>

        @foreach (var p in Model.Plans)
        {
            var featured = p.IsActive && p.Tier == maxTier;
            <div class="sx-card sx-plan @(featured ? "is-featured" : "") @(p.IsActive ? "" : "is-off")" data-rise>
                <div class="sx-card__b" style="display:flex;flex-direction:column;height:100%">
                    <div class="sx-plan__head">
                        <div>
                            <h3 class="sx-plan__name">@p.Name</h3>
                            <span class="sx-plan__code mono">@p.PlanCode · bậc @p.Tier</span>
                        </div>
                        <div style="display:flex;align-items:center;gap:8px">
                            @if (p.IsActive)
                            {
                                <span class="sx-pill sx-pill--ok">Đang bán</span>
                            }
                            else
                            {
                                <span class="sx-pill sx-pill--off">Đã ẩn</span>
                            }
                            <form asp-action="TogglePlan" method="post" style="display:inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@p.PlanId" />
                                <button type="submit" class="sx-btn sx-btn--light sx-btn--icon sx-btn--sm" title="@(p.IsActive ? "Ẩn khỏi bảng giá" : "Hiện lại")">
                                    <i class="bi @(p.IsActive ? "bi-eye-slash" : "bi-eye")"></i>
                                </button>
                            </form>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(p.Description))
                    {
                        <p style="color:var(--muted);font-size:.84rem;margin:10px 0 0;min-height:34px">@p.Description</p>
                    }

                    <div class="sx-price">
                        <span class="amt mono">@p.MonthlyPrice.ToString("N0")</span>
                        <span class="per">đ / tháng</span>
                    </div>
                    <div class="sx-price-alt mono">@p.QuarterlyPrice.ToString("N0")đ/quý · @p.YearlyPrice.ToString("N0")đ/năm</div>

                    <ul class="sx-feats">
                        <li><i class="bi @(p.IncludesAiTutor ? "bi-check-circle-fill yes" : "bi-x-circle no")"></i> Gia Sư AI</li>
                        <li><i class="bi @(p.IncludesVirtualLab ? "bi-check-circle-fill yes" : "bi-x-circle no")"></i> Phòng học 3D</li>
                    </ul>

                    @* Ghi chú giới hạn tài khoản tối đa nhà trường được tạo (∞ = không giới hạn) *@
                    <div class="sx-quota">
                        <div class="sx-quota__title"><i class="bi bi-people-fill"></i> Số tài khoản tối đa / trường</div>
                        <div class="sx-quota__grid">
                            <span>👨‍🏫 Giáo viên <b>@QLim(p.MaxTeachers)</b></span>
                            <span>🎓 Học sinh <b>@QLim(p.MaxStudents)</b></span>
                            <span>👪 Phụ huynh <b>@QLim(p.MaxParents)</b></span>
                            <span>🛡️ Quản trị <b>@QLim(p.MaxAdmins)</b></span>
                            <span>💼 Kế toán <b>@QLim(p.MaxAccountants)</b></span>
                            <span>🔎 Giám thị <b>@QLim(p.MaxSupervisors)</b></span>
                            <span>🏫 Lớp học <b>@QLim(p.MaxClasses)</b></span>
                        </div>
                    </div>

                    <div style="margin-top:auto;padding-top:14px">
                        <button type="button" class="sx-btn sx-btn--light sx-btn--block"
                                onclick="var e=document.getElementById('pe-@p.PlanId');e.style.display=e.style.display==='block'?'none':'block'">
                            <i class="bi bi-sliders"></i> Chỉnh sửa
                        </button>
                        <div id="pe-@p.PlanId" class="sx-edit" style="display:none">
                            <form asp-action="SavePlan" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="PlanId" value="@p.PlanId" />
                                <input type="hidden" name="IsActive" value="@(p.IsActive ? "true" : "false")" />
                                @{
                                    var planReq = new PlanEditRequest(p.PlanId, p.PlanCode, p.Name, p.Description, p.Tier,
                                        p.MonthlyPrice, p.QuarterlyPrice, p.YearlyPrice, p.IncludesAiTutor, p.IncludesVirtualLab, p.IsActive,
                                        p.MaxTeachers, p.MaxStudents, p.MaxParents, p.MaxAdmins, p.MaxAccountants, p.MaxSupervisors, p.MaxClasses);
                                }
                                @await Html.PartialAsync("_PlanFields", planReq)
                                <button type="submit" class="sx-btn sx-btn--primary sx-btn--block" style="margin-top:14px">
                                    <i class="bi bi-save"></i> Lưu thay đổi
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- ══ ADD-ONS ══ -->
    <div class="sx-sec-head">
        <h2 class="sx-sec-title"><span class="bar"></span> Tính năng bán thêm</h2>
        <button class="sx-btn sx-btn--gold sx-btn--sm" type="button"
                onclick="document.getElementById('newAddOn').style.display='flex';this.style.display='none'">
            <i class="bi bi-plus-lg"></i> Thêm add-on
        </button>
    </div>

    <div class="sx-grid-cards">

        <div class="sx-card sx-plan" id="newAddOn" style="display:none" data-rise>
            <div class="sx-card__b">
                <h3 class="sx-plan__name">Add-on mới</h3>
                <form asp-action="SaveAddOn" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="IsActive" value="true" />
                    <div class="sx-edit" style="border-top:none;margin-top:10px;padding-top:0">
                        @await Html.PartialAsync("_AddOnFields", (AddOnEditRequest?)null)
                    </div>
                    <button type="submit" class="sx-btn sx-btn--gold sx-btn--block" style="margin-top:14px">
                        <i class="bi bi-check-lg"></i> Tạo add-on
                    </button>
                </form>
            </div>
        </div>

        @foreach (var a in Model.AddOns)
        {
            <div class="sx-card sx-plan @(a.IsActive ? "" : "is-off")" data-rise>
                <div class="sx-card__b" style="display:flex;flex-direction:column;height:100%">
                    <div class="sx-plan__head">
                        <div>
                            <h3 class="sx-plan__name">
                                <i class="bi @(a.Feature == "AiTutor" ? "bi-robot" : "bi-badge-vr-fill")" style="color:var(--indigo)"></i>
                                @a.Name
                            </h3>
                            <span class="sx-plan__code mono">@a.AddOnCode</span>
                        </div>
                        <div style="display:flex;align-items:center;gap:8px">
                            @if (a.IsActive)
                            {
                                <span class="sx-pill sx-pill--ok">Đang bán</span>
                            }
                            else
                            {
                                <span class="sx-pill sx-pill--off">Đã ẩn</span>
                            }
                            <form asp-action="ToggleAddOn" method="post" style="display:inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@a.AddOnId" />
                                <button type="submit" class="sx-btn sx-btn--light sx-btn--icon sx-btn--sm" title="@(a.IsActive ? "Ẩn" : "Hiện lại")">
                                    <i class="bi @(a.IsActive ? "bi-eye-slash" : "bi-eye")"></i>
                                </button>
                            </form>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(a.Description))
                    {
                        <p style="color:var(--muted);font-size:.84rem;margin:10px 0 0;min-height:34px">@a.Description</p>
                    }

                    <div class="sx-price">
                        <span class="amt mono">@a.MonthlyPrice.ToString("N0")</span>
                        <span class="per">đ / tháng</span>
                    </div>
                    <div class="sx-price-alt mono">@a.QuarterlyPrice.ToString("N0")đ/quý · @a.YearlyPrice.ToString("N0")đ/năm</div>

                    <div style="margin-top:auto;padding-top:14px">
                        <button type="button" class="sx-btn sx-btn--light sx-btn--block"
                                onclick="var e=document.getElementById('ae-@a.AddOnId');e.style.display=e.style.display==='block'?'none':'block'">
                            <i class="bi bi-sliders"></i> Chỉnh sửa
                        </button>
                        <div id="ae-@a.AddOnId" class="sx-edit" style="display:none">
                            <form asp-action="SaveAddOn" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="AddOnId" value="@a.AddOnId" />
                                <input type="hidden" name="IsActive" value="@(a.IsActive ? "true" : "false")" />
                                @{
                                    var feat = Enum.Parse<LuminaTutors.Domain.Enums.PremiumFeature>(a.Feature);
                                    var addReq = new AddOnEditRequest(a.AddOnId, a.AddOnCode, a.Name, a.Description, feat,
                                        a.MonthlyPrice, a.QuarterlyPrice, a.YearlyPrice, a.IsActive);
                                }
                                @await Html.PartialAsync("_AddOnFields", addReq)
                                <button type="submit" class="sx-btn sx-btn--primary sx-btn--block" style="margin-top:14px">
                                    <i class="bi bi-save"></i> Lưu thay đổi
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- ══ QUOTA ADD-ONS (gói mở rộng slot tài khoản / lớp học) ══ -->
    <div class="sx-sec-head">
        <h2 class="sx-sec-title"><span class="bar"></span> Gói mở rộng tài khoản &amp; lớp học</h2>
        <button class="sx-btn sx-btn--gold sx-btn--sm" type="button"
                onclick="document.getElementById('newQuotaAddOn').style.display='flex';this.style.display='none'">
            <i class="bi bi-plus-lg"></i> Thêm gói mở rộng
        </button>
    </div>

    <div class="sx-grid-cards">

        <div class="sx-card sx-plan" id="newQuotaAddOn" style="display:none" data-rise>
            <div class="sx-card__b">
                <h3 class="sx-plan__name">Gói mở rộng mới</h3>
                <form asp-action="SaveQuotaAddOn" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="IsActive" value="true" />
                    <div class="sx-edit" style="border-top:none;margin-top:10px;padding-top:0">
                        @await Html.PartialAsync("_QuotaAddOnFields", (QuotaAddOnEditRequest?)null)
                    </div>
                    <button type="submit" class="sx-btn sx-btn--gold sx-btn--block" style="margin-top:14px">
                        <i class="bi bi-check-lg"></i> Tạo gói mở rộng
                    </button>
                </form>
            </div>
        </div>

        @foreach (var q in Model.QuotaAddOns)
        {
            var isClass = q.TargetRole is null;
            var qty     = isClass ? $"+{q.ExtraClasses} lớp học" : $"+{q.ExtraQuota} {QRoleLabel(q.TargetRole)}";
            <div class="sx-card sx-plan @(q.IsActive ? "" : "is-off")" data-rise>
                <div class="sx-card__b" style="display:flex;flex-direction:column;height:100%">
                    <div class="sx-plan__head">
                        <div>
                            <h3 class="sx-plan__name">
                                <i class="bi @(isClass ? "bi-easel" : "bi-person-plus-fill")" style="color:var(--indigo)"></i>
                                @q.Name
                            </h3>
                            <span class="sx-plan__code mono">@q.AddOnCode</span>
                        </div>
                        <div style="display:flex;align-items:center;gap:8px">
                            @if (q.IsActive)
                            {
                                <span class="sx-pill sx-pill--ok">Đang bán</span>
                            }
                            else
                            {
                                <span class="sx-pill sx-pill--off">Đã ẩn</span>
                            }
                            <form asp-action="ToggleQuotaAddOn" method="post" style="display:inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@q.AddOnId" />
                                <button type="submit" class="sx-btn sx-btn--light sx-btn--icon sx-btn--sm" title="@(q.IsActive ? "Ẩn" : "Hiện lại")">
                                    <i class="bi @(q.IsActive ? "bi-eye-slash" : "bi-eye")"></i>
                                </button>
                            </form>
                        </div>
                    </div>

                    <p style="color:var(--muted);font-size:.84rem;margin:10px 0 0">
                        <span class="sx-pill sx-pill--ok">@qty</span>
                    </p>
                    @if (!string.IsNullOrEmpty(q.Description))
                    {
                        <p style="color:var(--muted);font-size:.84rem;margin:8px 0 0;min-height:24px">@q.Description</p>
                    }

                    <div class="sx-price">
                        <span class="amt mono">@q.MonthlyPrice.ToString("N0")</span>
                        <span class="per">đ / tháng</span>
                    </div>
                    <div class="sx-price-alt mono">@q.QuarterlyPrice.ToString("N0")đ/quý · @q.YearlyPrice.ToString("N0")đ/năm</div>

                    <div style="margin-top:auto;padding-top:14px">
                        <button type="button" class="sx-btn sx-btn--light sx-btn--block"
                                onclick="var e=document.getElementById('qe-@q.AddOnId');e.style.display=e.style.display==='block'?'none':'block'">
                            <i class="bi bi-sliders"></i> Chỉnh sửa
                        </button>
                        <div id="qe-@q.AddOnId" class="sx-edit" style="display:none">
                            <form asp-action="SaveQuotaAddOn" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="AddOnId" value="@q.AddOnId" />
                                <input type="hidden" name="IsActive" value="@(q.IsActive ? "true" : "false")" />
                                @{
                                    var qReq = new QuotaAddOnEditRequest(q.AddOnId, q.AddOnCode, q.Name, q.Description,
                                        q.TargetRole, q.ExtraQuota, q.ExtraClasses,
                                        q.MonthlyPrice, q.QuarterlyPrice, q.YearlyPrice, q.IsActive);
                                }
                                @await Html.PartialAsync("_QuotaAddOnFields", qReq)
                                <button type="submit" class="sx-btn sx-btn--primary sx-btn--block" style="margin-top:14px">
                                    <i class="bi bi-save"></i> Lưu thay đổi
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

</div>
