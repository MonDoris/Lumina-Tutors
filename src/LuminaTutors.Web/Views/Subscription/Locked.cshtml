@{
    ViewData["Title"] = "Tính năng chưa mở khóa";
    var feature = (string)(ViewBag.Feature ?? "tính năng cao cấp");
    var isAdmin = (bool)(ViewBag.IsAdmin ?? false);
}

<div style="max-width:560px;margin:48px auto;text-align:center">
    <div class="lt-card">
        <div class="lt-card__body" style="padding:40px 32px">
            <div style="font-size:3rem;line-height:1">🔒</div>
            <h1 style="font-size:1.35rem;font-weight:800;color:var(--lt-navy);margin:14px 0 8px">
                @feature chưa được mở khóa
            </h1>
            <p style="color:#64748b;line-height:1.6;margin:0 0 22px">
                Tính năng <b>@feature</b> thuộc gói cao cấp. Trường của bạn cần nâng cấp gói
                hoặc mua thêm tính năng này để sử dụng.
            </p>

            @if (isAdmin)
            {
                <a asp-controller="Subscription" asp-action="Index" class="lt-btn lt-btn--primary lt-btn--lg">
                    <i class="bi bi-stars"></i> Nâng cấp / Mua thêm
                </a>
            }
            else
            {
                <div style="background:#f1f5f9;border-radius:10px;padding:14px;color:#475569;font-size:.9rem">
                    <i class="bi bi-info-circle"></i> Vui lòng liên hệ <b>quản trị viên nhà trường</b> để mở khóa tính năng này.
                </div>
            }
            <div style="margin-top:18px">
                <a asp-controller="Dashboard" asp-action="Index" style="color:#64748b;text-decoration:none;font-size:.88rem">
                    <i class="bi bi-arrow-left"></i> Về trang chủ
                </a>
            </div>
        </div>
    </div>
</div>
