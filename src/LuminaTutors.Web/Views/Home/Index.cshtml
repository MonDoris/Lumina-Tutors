        </article>
        <!-- 02 -->
        <article class="mod reveal d1" style="--bar:var(--purple);--bar-a:var(--purple-a)">
            <div class="mod-top">
                <span class="mod-num mono">MOD_02</span>
                <span class="mod-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="4" y="4" width="6" height="6" rx="1"/><rect x="14" y="4" width="6" height="6" rx="1"/><rect x="4" y="14" width="6" height="6" rx="1"/><path d="M17 14v6M14 17h6"/></svg></span>
            </div>
            <h3 class="mod-title">Điểm danh QR &amp; Face ID</h3>
            <p class="mod-body">Ghi nhận chuyên cần bằng mã QR động (hết hạn 10 phút) hoặc nhận diện khuôn mặt, đồng bộ tức thì tới phụ huynh.</p>
            <div class="mod-viz" data-bars="90,30,70,85,40,75"></div>
            <div class="mod-tags"><span class="mod-chip mono">QR</span><span class="mod-chip mono">FACE_ID</span><span class="mod-chip mono">SYNC</span></div>
        </article>
        <!-- 03 -->
        <article class="mod reveal d2" style="--bar:var(--green);--bar-a:var(--green-a)">
            <div class="mod-top">
                <span class="mod-num mono">MOD_03</span>
                <span class="mod-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 2v4M12 18v4M2 12h4M18 12h4"/><circle cx="12" cy="12" r="5"/></svg></span>
            </div>
