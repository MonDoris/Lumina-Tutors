@{
    Layout = null;
    /*
     * LUMINA TUTORS — LANDING PAGE v3 (Light)
     * Concept: "The Illumination of Knowledge" — Light Edition
     * Warm parchment base. Cursor casts a golden bloom on the surface,
     * like sunlight moving across aged paper.
     */
}
<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<meta name="description" content="Lumina Tutors — Nền tảng quản lý giáo dục thế hệ mới."/>
<title>Lumina Tutors — Chạm vào ánh sáng</title>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=EB+Garamond:ital,wght@0,400;0,500;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet"/>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>

<style>
/* ═══════════════════════════════════════════════════
   RESET
═══════════════════════════════════════════════════ */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }

/* ═══════════════════════════════════════════════════
   DESIGN TOKENS  (hex / rgba — no oklch)
═══════════════════════════════════════════════════ */
:root {
    --parch:      #f8f4ed;   /* page background — warm parchment    */
    --parch2:     #f2ede3;   /* section tint                        */
    --parch3:     #ece5d8;   /* card / divider                      */
    --ink:        #1c160e;   /* primary text                        */
    --ink2:       #3d3220;   /* body text                           */
    --ink3:       #7a6a52;   /* subdued / captions                  */
    --gold:       #a07828;   /* primary accent                      */
    --gold-l:     #c49430;   /* lighter gold — hover                */
    --gold-bg:    rgba(160,120,40,.08);   /* gold tint bg            */
    --gold-bd:    rgba(160,120,40,.22);   /* gold border             */
    --rule:       rgba(160,120,40,.18);   /* horizontal rules        */
    --thread:     #b08830;   /* scrollytelling thread               */
    --ease-expo: cubic-bezier(0.16, 1, 0.3, 1);
    /* Cursor-bloom position (updated by JS) */
    --bx: 50%;
    --by: 50%;
}

/* ═══════════════════════════════════════════════════
   BASE
═══════════════════════════════════════════════════ */
body {
    font-family: 'Inter', sans-serif;
    background: var(--parch);
    color: var(--ink2);
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
    cursor: none;
}
a { cursor: none; }

/* ═══════════════════════════════════════════════════
   CUSTOM CURSOR
═══════════════════════════════════════════════════ */
.c-dot {
    position: fixed; z-index: 9000;
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--gold);
    pointer-events: none;
    transform: translate(-50%,-50%);
    will-change: left, top;
}
.c-ring {
    position: fixed; z-index: 8999;
    width: 30px; height: 30px; border-radius: 50%;
    border: 1.5px solid rgba(160,120,40,.5);
    pointer-events: none;
    transform: translate(-50%,-50%);
    will-change: left, top;
    transition: width .22s var(--ease-expo),
                height .22s var(--ease-expo),
                border-color .2s, opacity .2s;
}
.c-ring.hov { width: 46px; height: 46px; border-color: var(--gold); }
.c-ring.portal { width: 72px; height: 72px; border-color: rgba(160,120,40,.55); }

/* ═══════════════════════════════════════════════════
   CURSOR BLOOM — warm golden glow following cursor
   Sits below content so it colours the background
   without obscuring text.
═══════════════════════════════════════════════════ */
.bloom {
    position: fixed;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: radial-gradient(
        circle 320px at var(--bx) var(--by),
        rgba(200,165,60, 0.13) 0%,
        rgba(200,165,60, 0.05) 40%,
        transparent 70%
    );
    transition: background .05s linear;
}

/* ═══════════════════════════════════════════════════
   CONTENT LAYER (z-2 so it sits above bloom)
═══════════════════════════════════════════════════ */
.page-wrap { position: relative; z-index: 2; }

/* ═══════════════════════════════════════════════════
   NAVBAR
═══════════════════════════════════════════════════ */
.nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 500;
    height: 68px; padding: 0 56px;
    display: flex; align-items: center; justify-content: space-between;
    transition: background .35s, box-shadow .35s, border-color .35s;
    border-bottom: 1px solid transparent;
}
.nav.scrolled {
    background: rgba(248,244,237,.92);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow: 0 1px 0 var(--rule);
    border-color: var(--rule);
}
.nav__logo {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.4rem; font-weight: 600;
    color: var(--gold); text-decoration: none;
    letter-spacing: .04em;
    display: flex; align-items: center; gap: 9px;
}
.nav__links { display: flex; gap: 0; }
.nav__link {
    font-size: .78rem; letter-spacing: .09em; text-transform: uppercase;
    color: var(--ink3); text-decoration: none;
    padding: 7px 15px; border-radius: 5px;
    transition: color .18s, background .18s;
}
.nav__link:hover { color: var(--ink); background: var(--gold-bg); }
.nav__actions { display: flex; gap: 9px; align-items: center; }
.nav-ghost {
    font-size: .78rem; font-weight: 500; letter-spacing: .05em;
    color: var(--ink3); text-decoration: none;
    padding: 7px 18px; border-radius: 5px;
    border: 1px solid var(--gold-bd);
    transition: color .18s, border-color .18s, background .18s;
}
.nav-ghost:hover { color: var(--gold); border-color: var(--gold); background: var(--gold-bg); }
.nav-solid {
    font-size: .78rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase;
    color: #fff; background: var(--gold);
    text-decoration: none; padding: 8px 20px; border-radius: 5px;
    transition: background .18s, box-shadow .2s, transform .15s;
    box-shadow: 0 2px 14px rgba(160,120,40,.3);
}
.nav-solid:hover {
    background: var(--gold-l);
    box-shadow: 0 4px 22px rgba(160,120,40,.4);
    transform: translateY(-1px);
}

/* ═══════════════════════════════════════════════════
   HERO
═══════════════════════════════════════════════════ */
.hero {
    min-height: 100vh;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    padding: 130px 48px 100px;
    text-align: center;
    position: relative;
    /* Subtle radial — slightly lighter in centre */
    background: radial-gradient(ellipse 70% 60% at 50% 42%,
        #fdfbf6 0%, var(--parch) 100%);
}

/* Fine ornamental rule above crest */
.hero-rule {
    display: flex; align-items: center; gap: 14px;
    margin-bottom: 44px;
    opacity: 0; transform: translateY(12px);
    transition: opacity .9s var(--ease-expo) .2s,
                transform .9s var(--ease-expo) .2s;
}
.hero-rule-line {
    flex: 1; max-width: 80px; height: 1px;
    background: linear-gradient(to right, transparent, var(--rule));
}
.hero-rule-line.r { background: linear-gradient(to left, transparent, var(--rule)); }
.hero-rule-diamond {
    width: 5px; height: 5px;
    background: var(--gold);
    transform: rotate(45deg);
    opacity: .6;
}

/* Eyebrow */
.hero-eyebrow {
    font-size: .68rem; letter-spacing: .22em; text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 30px;
    opacity: 0; transform: translateY(12px);
    transition: opacity .9s var(--ease-expo) .35s,
                transform .9s var(--ease-expo) .35s;
}

/* Crest */
.hero-crest {
    margin-bottom: 34px;
    opacity: 0; transform: translateY(12px);
    transition: opacity 1s var(--ease-expo) .52s,
                transform 1s var(--ease-expo) .52s;
}
.hero-crest svg {
    width: 74px; height: 74px;
    filter: drop-shadow(0 2px 16px rgba(160,120,40,.2));
    animation: crest-pulse 4s ease-in-out 1.6s infinite;
}
@@keyframes crest-pulse {
    0%,100% { filter: drop-shadow(0 2px 12px rgba(160,120,40,.18)); }
    50%      { filter: drop-shadow(0 2px 28px rgba(160,120,40,.38)); }
}

/* Title */
.hero-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(2.8rem, 6.5vw, 5.6rem);
    font-weight: 300; line-height: 1.1;
    letter-spacing: -.01em;
    color: var(--ink);
    margin-bottom: 20px;
    opacity: 0; transform: translateY(12px);
    transition: opacity 1s var(--ease-expo) .68s,
                transform 1s var(--ease-expo) .68s;
}
.hero-title em { font-style: italic; color: var(--gold); }

/* Subtitle */
.hero-motto {
    font-family: 'EB Garamond', serif;
    font-size: clamp(.95rem, 1.6vw, 1.175rem);
    font-style: italic; line-height: 1.9; letter-spacing: .03em;
    color: var(--ink3);
    margin-bottom: 0;
    opacity: 0; transform: translateY(12px);
    transition: opacity 1s var(--ease-expo) .84s,
                transform 1s var(--ease-expo) .84s;
}
.hero-motto strong { font-style: normal; font-weight: 400; color: var(--ink2); }

/* Scroll indicator */
.hero-scroll {
    position: absolute; bottom: 36px; left: 50%; transform: translateX(-50%);
    display: flex; flex-direction: column; align-items: center; gap: 8px;
    opacity: 0; transition: opacity 1s .2s;
}
.hero-scroll.visible { opacity: 1; }
.hero-scroll-lbl {
    font-size: .6rem; letter-spacing: .2em; text-transform: uppercase;
    color: var(--ink3);
}
.hero-scroll-line {
    width: 1px; height: 40px;
    background: linear-gradient(to bottom, var(--gold), transparent);
    animation: scroll-breathe 2s ease-in-out infinite;
}
@@keyframes scroll-breathe {
    0%,100% { opacity: .35; }
    50%      { opacity: .85; }
}

/* JS trigger: body.in → hero elements visible */
body.in .hero-rule,
body.in .hero-eyebrow,
body.in .hero-crest,
body.in .hero-title,
body.in .hero-motto { opacity: 1; transform: translateY(0); }

/* ═══════════════════════════════════════════════════
   DIVIDER — ornamental section separator
═══════════════════════════════════════════════════ */
.ornament-rule {
    display: flex; align-items: center; gap: 16px;
    max-width: 320px; margin: 0 auto;
    padding: 8px 0;
}
.or-line {
    flex: 1; height: 1px;
    background: var(--rule);
}
.or-mark {
    font-family: 'Cormorant Garamond', serif;
    font-size: .7rem; letter-spacing: .18em; text-transform: uppercase;
    color: var(--gold); opacity: .7;
    white-space: nowrap;
}

/* ═══════════════════════════════════════════════════
   SCROLLYTELLING STORY
═══════════════════════════════════════════════════ */
.story {
    position: relative;
    padding: 60px 48px 80px;
    background: var(--parch);
}

/* Golden thread */
.s-thread {
    position: absolute; left: 50%; top: 0; bottom: 0;
    width: 1px; transform: translateX(-50%);
    pointer-events: none; z-index: 0; overflow: hidden;
}
.s-thread-fill {
    width: 1px; height: 0;
    background: linear-gradient(
        to bottom,
        transparent,
        var(--thread) 8%,
        var(--thread) 92%,
        transparent
    );
    box-shadow: 0 0 8px rgba(176,136,48,.25);
    transition: height .16s linear;
}
.s-thread-node {
    position: absolute; left: 50%; transform: translateX(-50%);
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--thread);
    box-shadow: 0 0 10px rgba(176,136,48,.55);
    opacity: 0; transition: opacity .5s;
}
.s-thread-node.lit { opacity: 1; }

/* Value panels */
.v-panel {
    position: relative; z-index: 1;
    max-width: 520px;
    padding: 100px 48px;
    opacity: 0; transform: translateY(24px);
    transition: opacity .85s var(--ease-expo),
                transform .85s var(--ease-expo);
}
.v-panel.lit { opacity: 1; transform: translateY(0); }

/* Odd: right side of thread */
.v-panel:nth-child(odd) {
    margin-left: auto; margin-right: 0;
    padding-left: calc(50% - 260px + 40px);
    text-align: left;
}
/* Even: left side */
.v-panel:nth-child(even) {
    margin-left: 0; margin-right: auto;
    padding-right: calc(50% - 260px + 40px);
    text-align: right;
}

.v-num {
    display: block;
    font-family: 'Cormorant Garamond', serif;
    font-size: .72rem; font-weight: 300;
    letter-spacing: .24em; text-transform: uppercase;
    color: var(--gold); margin-bottom: 12px;
}
.v-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(1.9rem, 3.6vw, 3rem);
    font-weight: 300; line-height: 1.15;
    color: var(--ink); margin-bottom: 16px;
}
.v-title em { font-style: italic; color: var(--gold); }
.v-body {
    font-family: 'EB Garamond', serif;
    font-size: 1.05rem; line-height: 1.9;
    color: var(--ink2);
}
.v-tags {
    display: flex; flex-wrap: wrap; gap: 7px;
    margin-top: 20px;
}
.v-panel:nth-child(even) .v-tags { justify-content: flex-end; }
.v-tag {
    font-size: .66rem; font-weight: 500; letter-spacing: .1em; text-transform: uppercase;
    color: var(--ink3);
    border: 1px solid var(--gold-bd);
    padding: 3px 11px; border-radius: 2px;
    background: var(--gold-bg);
    transition: color .35s, border-color .35s, background .35s;
}
.v-panel.lit .v-tag { color: var(--gold); border-color: rgba(160,120,40,.38); }
.v-mark {
    position: absolute; top: 50%; transform: translateY(-50%);
    font-family: 'Cormorant Garamond', serif;
    font-size: 7rem; font-weight: 300; line-height: 1;
    color: rgba(160,120,40,.06);
    pointer-events: none; user-select: none;
}
.v-panel:nth-child(odd)  .v-mark { right: 8px; }
.v-panel:nth-child(even) .v-mark { left: 8px; }

/* ═══════════════════════════════════════════════════
   STATS BAR — light edition
═══════════════════════════════════════════════════ */
.stats-bar {
    background: var(--parch2);
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    padding: 48px;
}
.stats-inner {
    max-width: 860px; margin: 0 auto;
    display: grid; grid-template-columns: repeat(4,1fr);
    gap: 0;
}
.stat-item {
    text-align: center; padding: 0 24px;
    border-right: 1px solid var(--rule);
}
.stat-item:last-child { border-right: none; }
.stat-num {
    font-family: 'Cormorant Garamond', serif;
    font-size: 2.6rem; font-weight: 300;
    color: var(--ink); line-height: 1; letter-spacing: -.02em;
}
.stat-num span { color: var(--gold); }
.stat-lbl {
    font-size: .75rem; letter-spacing: .05em;
    color: var(--ink3); margin-top: 6px;
}

/* ═══════════════════════════════════════════════════
   THE GATEWAY — light edition
═══════════════════════════════════════════════════ */
.gateway-section {
    min-height: 100vh;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    padding: 100px 48px;
    text-align: center;
    background: var(--parch2);
    position: relative; overflow: hidden;
}
/* Faint ornamental watermark behind portal */
.gateway-section::before {
    content: 'L';
    position: absolute; left: 50%; top: 50%;
    transform: translate(-50%,-50%);
    font-family: 'Cormorant Garamond', serif;
    font-size: 52vw; font-weight: 300;
    color: rgba(160,120,40,.028);
    line-height: 1;
    pointer-events: none; user-select: none;
    letter-spacing: -.05em;
}

.gw-eyebrow {
    font-size: .68rem; letter-spacing: .22em; text-transform: uppercase;
    color: var(--gold); margin-bottom: 32px;
    opacity: 0; transform: translateY(12px);
    transition: opacity .8s var(--ease-expo),
                transform .8s var(--ease-expo);
}
.gw-eyebrow.in { opacity: 1; transform: none; }

.gw-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(1.7rem, 3vw, 2.6rem);
    font-weight: 300; line-height: 1.4;
    color: var(--ink2); max-width: 400px; margin-bottom: 68px;
    opacity: 0; transform: translateY(12px);
    transition: opacity .9s var(--ease-expo) .1s,
                transform .9s var(--ease-expo) .1s;
}
.gw-title.in { opacity: 1; transform: none; }
.gw-title em { color: var(--ink); font-style: italic; }

/* Portal */
.gateway {
    position: relative;
    display: inline-flex; align-items: center; justify-content: center;
    text-decoration: none; cursor: none;
    opacity: 0; transform: scale(.92);
    transition: opacity .9s var(--ease-expo) .22s,
                transform .9s var(--ease-expo) .22s;
}
.gateway.in { opacity: 1; transform: scale(1); }

/* Rings */
.gw-ring {
    position: absolute; border-radius: 50%;
    border: 1px solid var(--gold-bd);
    transition: transform .6s var(--ease-expo), border-color .45s;
}
.gw-r1 { width: 188px; height: 188px; }
.gw-r2 { width: 248px; height: 248px; animation: rring 20s linear infinite; }
.gw-r3 { width: 310px; height: 310px; animation: rring 30s linear infinite reverse; }
@@keyframes rring { to { transform: rotate(360deg); } }

/* Orbital dot on ring 2 */
.gw-r2::before {
    content: '';
    position: absolute; top: 50%; left: -3px; transform: translateY(-50%);
    width: 5px; height: 5px; border-radius: 50%;
    background: var(--gold); box-shadow: 0 0 8px rgba(160,120,40,.5);
}
/* Orbital dot on ring 3 */
.gw-r3::after {
    content: '';
    position: absolute; bottom: -2px; left: 50%; transform: translateX(-50%);
    width: 4px; height: 4px; border-radius: 50%;
    background: var(--gold-bd);
}

/* Core button */
.gw-core {
    position: relative; z-index: 1;
    width: 132px; height: 132px; border-radius: 50%;
    background: var(--parch);
    border: 1px solid var(--gold-bd);
    box-shadow: 0 4px 24px rgba(160,120,40,.1),
                inset 0 1px 0 rgba(255,255,255,.6);
    display: flex; flex-direction: column;
    align-items: center; justify-content: center; gap: 5px;
    transition: background .45s, border-color .45s, box-shadow .45s, transform .5s;
}
.gw-icon {
    font-size: 1.65rem; color: var(--gold);
    transition: transform .45s, color .35s;
}
.gw-lbl {
    font-size: .6rem; font-weight: 600;
    letter-spacing: .2em; text-transform: uppercase;
    color: var(--ink3); transition: color .35s;
}

/* Hover */
.gateway:hover .gw-core {
    background: #fffdf7;
    border-color: var(--gold);
    box-shadow: 0 8px 48px rgba(160,120,40,.22),
                0 2px 10px rgba(160,120,40,.12),
                inset 0 1px 0 rgba(255,255,255,.8);
    transform: scale(1.07);
}
.gateway:hover .gw-icon  { transform: scale(1.1) rotate(-8deg); }
.gateway:hover .gw-lbl   { color: var(--gold); }
.gateway:hover .gw-r1 { transform: scale(1.12); border-color: rgba(160,120,40,.4); }
.gateway:hover .gw-r2 { border-color: rgba(160,120,40,.28); }

/* Ripple */
.gw-ripple {
    position: absolute; border-radius: 50%;
    width: 132px; height: 132px;
    border: 1px solid var(--gold);
    pointer-events: none; opacity: 0;
}
.gateway:hover .gw-ripple {
    animation: gwrip 1.4s var(--ease-expo) infinite;
}
@@keyframes gwrip {
    from { transform: scale(1); opacity: .4; }
    to   { transform: scale(2.3); opacity: 0; }
}

.gw-sub {
    margin-top: 72px;
    font-family: 'EB Garamond', serif;
    font-size: .95rem; font-style: italic; letter-spacing: .04em;
    color: var(--ink3);
    opacity: 0; transition: opacity .8s var(--ease-expo) .3s;
}
.gw-sub.in { opacity: 1; }
.gw-sub a {
    color: var(--gold); text-decoration: none;
    border-bottom: 1px solid rgba(160,120,40,.3);
    transition: border-color .2s;
}
.gw-sub a:hover { border-color: var(--gold); }

/* ═══════════════════════════════════════════════════
   FOOTER
═══════════════════════════════════════════════════ */
.footer {
    background: var(--parch);
    border-top: 1px solid var(--rule);
    padding: 44px 56px 32px;
    display: flex; justify-content: space-between; align-items: center;
    flex-wrap: wrap; gap: 14px;
}
.footer-brand {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.1rem; font-weight: 600;
    color: var(--gold); text-decoration: none;
}
.footer-links { display: flex; gap: 22px; }
.footer-lnk {
    font-size: .74rem; letter-spacing: .05em;
    color: var(--ink3); text-decoration: none;
    transition: color .18s;
}
.footer-lnk:hover { color: var(--gold); }
.footer-copy { font-size: .72rem; letter-spacing: .04em; color: var(--ink3); }

/* ═══════════════════════════════════════════════════
   GENERAL SCROLL REVEAL
═══════════════════════════════════════════════════ */
.reveal {
    opacity: 0; transform: translateY(18px);
    transition: opacity .75s var(--ease-expo),
                transform .75s var(--ease-expo);
}
.reveal.d1 { transition-delay: .1s; }
.reveal.d2 { transition-delay: .2s; }
.reveal.d3 { transition-delay: .3s; }
.reveal.visible { opacity: 1; transform: none; }

/* ═══════════════════════════════════════════════════
   RESPONSIVE
═══════════════════════════════════════════════════ */
@@media (max-width: 1024px) {
    .nav { padding: 0 28px; }
    .nav__links { display: none; }
    .story { padding: 40px 28px 60px; }
    .v-panel:nth-child(odd),
    .v-panel:nth-child(even) {
        max-width: 100%; margin: 0 auto;
        padding: 72px 24px; text-align: center;
    }
    .v-panel:nth-child(odd)  { padding-left:  24px; }
    .v-panel:nth-child(even) { padding-right: 24px; }
    .v-tags, .v-panel:nth-child(even) .v-tags { justify-content: center; }
    .v-mark { display: none; }
    .s-thread { display: none; }
    .stats-inner { grid-template-columns: repeat(2,1fr); gap: 28px; }
    .stat-item { border-right: none; }
}
@@media (max-width: 640px) {
    body { cursor: auto; }
    .c-dot, .c-ring { display: none; }
    .hero { padding: 120px 24px 80px; }
    .stats-bar { padding: 40px 24px; }
    .gateway-section { padding: 80px 24px; }
    .gw-title { margin-bottom: 52px; }
    .footer { padding: 36px 24px 24px; flex-direction: column; text-align: center; }
    .footer-links { flex-wrap: wrap; justify-content: center; }
}
@@media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
        animation-duration: .01ms !important;
        transition-duration: .01ms !important;
    }
}
</style>
</head>
<body>

<!-- Custom cursor -->
<div class="c-dot"  id="cDot"  aria-hidden="true"></div>
<div class="c-ring" id="cRing" aria-hidden="true"></div>

<!-- Cursor bloom — warm golden glow on parchment -->
<div class="bloom" id="bloom" aria-hidden="true"></div>

<!-- ════════ PAGE CONTENT ════════ -->
<div class="page-wrap">

<!-- NAV -->
<nav class="nav" id="mainNav" aria-label="Điều hướng chính" data-testid="landing-nav">
    <a href="/" class="nav__logo" aria-label="Lumina Tutors">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <circle cx="12" cy="12" r="10.5" stroke="rgba(160,120,40,.4)" stroke-width=".75"/>
            <circle cx="12" cy="12" r="7"    stroke="rgba(160,120,40,.22)" stroke-width=".75"/>
            <line x1="12" y1="5"  x2="12" y2="19" stroke="#a07828" stroke-width="1.4" stroke-linecap="round"/>
            <path d="M12 5 C12 5 15.8 9 14 12.5 C13 10.5 11 10.5 10 12.5 C8.2 9 12 5 12 5Z" fill="#a07828"/>
            <path d="M7 10 C5 8 4.5 5.5 6 4"   stroke="rgba(160,120,40,.4)" stroke-width=".9" fill="none" stroke-linecap="round"/>
            <path d="M17 10 C19 8 19.5 5.5 18 4" stroke="rgba(160,120,40,.4)" stroke-width=".9" fill="none" stroke-linecap="round"/>
        </svg>
        Lumina Tutors
    </a>
    <div class="nav__links">
        <a href="#story"   class="nav__link">Giá trị</a>
        <a href="#gateway" class="nav__link">Vào hệ thống</a>
    </div>
    <div class="nav__actions">
        <a asp-controller="Auth" asp-action="Login"      class="nav-ghost" data-testid="nav-login">Đăng nhập</a>
        <a asp-controller="Auth" asp-action="SelectRole" class="nav-solid" data-testid="nav-start">Khám phá</a>
    </div>
</nav>

<!-- HERO -->
<section class="hero" id="hero" aria-labelledby="heroTitle" data-testid="hero-section">

    <!-- Ornamental rule -->
    <div class="hero-rule" aria-hidden="true">
        <div class="hero-rule-line"></div>
        <div class="hero-rule-diamond"></div>
        <div class="hero-rule-line r"></div>
    </div>

    <p class="hero-eyebrow">Lumina Tutors &nbsp;&middot;&nbsp; Education Excellence</p>

    <!-- Crest mark -->
    <div class="hero-crest" id="heroCrest" aria-hidden="true">
        <svg width="76" height="76" viewBox="0 0 76 76" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="38" cy="38" r="34" stroke="rgba(160,120,40,.28)" stroke-width=".75"/>
            <circle cx="38" cy="38" r="26" stroke="rgba(160,120,40,.18)" stroke-width=".75"/>
            <line x1="38" y1="16" x2="38" y2="56" stroke="#a07828" stroke-width="1.5" stroke-linecap="round"/>
            <path d="M38 16 C38 16 45 24 42.5 30.5 C40.5 27 35.5 27 33.5 30.5 C31 24 38 16 38 16Z" fill="#a07828"/>
            <path d="M26 40 C21 35 20 29 23 25" stroke="rgba(160,120,40,.45)" stroke-width="1" fill="none" stroke-linecap="round"/>
            <path d="M23 36 C20 34 19 29 21 26" stroke="rgba(160,120,40,.28)" stroke-width="1" fill="none" stroke-linecap="round"/>
            <path d="M50 40 C55 35 56 29 53 25" stroke="rgba(160,120,40,.45)" stroke-width="1" fill="none" stroke-linecap="round"/>
            <path d="M53 36 C56 34 57 29 55 26" stroke="rgba(160,120,40,.28)" stroke-width="1" fill="none" stroke-linecap="round"/>
            <path d="M31 52 Q38 56 45 52" stroke="rgba(160,120,40,.38)" stroke-width="1" fill="none"/>
            <line x1="38" y1="2"  x2="38" y2="7"  stroke="rgba(160,120,40,.3)" stroke-width=".75"/>
            <line x1="38" y1="69" x2="38" y2="74" stroke="rgba(160,120,40,.3)" stroke-width=".75"/>
            <line x1="2"  y1="38" x2="7"  y2="38" stroke="rgba(160,120,40,.3)" stroke-width=".75"/>
            <line x1="69" y1="38" x2="74" y2="38" stroke="rgba(160,120,40,.3)" stroke-width=".75"/>
        </svg>
    </div>

    <h1 class="hero-title" id="heroTitle">
        Chạm vào <em>ánh sáng.</em><br/>Đánh thức tri thức.
    </h1>

    <p class="hero-motto">
        <strong>Touch the light. Awaken the mind.</strong><br/>
        Nền tảng quản lý giáo dục cho những học viện tinh hoa.
    </p>

    <div class="hero-scroll" id="heroScroll" aria-hidden="true">
        <span class="hero-scroll-lbl">Cuộn để khám phá</span>
        <div class="hero-scroll-line"></div>
    </div>
</section>

<!-- STATS -->
<div class="stats-bar" data-testid="stats">
    <div class="stats-inner">
        <div class="stat-item reveal">
            <div class="stat-num">500<span>+</span></div>
            <div class="stat-lbl">Trường học đang dùng</div>
        </div>
        <div class="stat-item reveal d1">
            <div class="stat-num">120<span>K</span></div>
            <div class="stat-lbl">Học sinh được quản lý</div>
        </div>
        <div class="stat-item reveal d2">
            <div class="stat-num">99.9<span>%</span></div>
            <div class="stat-lbl">Uptime đảm bảo</div>
        </div>
        <div class="stat-item reveal d3">
            <div class="stat-num">4.9<span>★</span></div>
            <div class="stat-lbl">Điểm đánh giá trung bình</div>
        </div>
    </div>
</div>

<!-- SCROLLYTELLING -->
<section class="story" id="story" aria-label="Giá trị cốt lõi" data-testid="story-section">
    <div class="s-thread" aria-hidden="true">
        <div class="s-thread-fill" id="threadFill"></div>
        <div class="s-thread-node" id="tn0" style="top:17%"></div>
        <div class="s-thread-node" id="tn1" style="top:33%"></div>
        <div class="s-thread-node" id="tn2" style="top:50%"></div>
        <div class="s-thread-node" id="tn3" style="top:66%"></div>
        <div class="s-thread-node" id="tn4" style="top:83%"></div>
    </div>

    <article class="v-panel" id="vp0">
        <div class="v-mark" aria-hidden="true">I</div>
        <span class="v-num">Giá trị thứ nhất</span>
        <h2 class="v-title">Khai sáng <em>tri thức</em></h2>
        <p class="v-body">Lumina không chỉ là phần mềm — đây là ngọn đuốc dẫn đường. Mỗi dữ liệu điểm số, mỗi báo cáo chuyên cần đều là một tia sáng giúp giáo viên nhìn thấy rõ hơn, hiểu sâu hơn về từng học sinh.</p>
        <div class="v-tags"><span class="v-tag">Phân tích học tập</span><span class="v-tag">AI Insights</span><span class="v-tag">Báo cáo TT22</span></div>
    </article>

    <article class="v-panel" id="vp1">
        <div class="v-mark" aria-hidden="true">II</div>
        <span class="v-num">Giá trị thứ hai</span>
        <h2 class="v-title">Kết nối <em>tâm huyết</em></h2>
        <p class="v-body">Ba góc nhìn — nhà trường, giáo viên, phụ huynh — hội tụ trên một nền tảng duy nhất. Thông tin chảy minh bạch, niềm tin được xây dựng qua từng thông báo tức thời.</p>
        <div class="v-tags"><span class="v-tag">6 vai trò</span><span class="v-tag">Nhắn tin nội bộ</span><span class="v-tag">Push Notification</span></div>
    </article>

    <article class="v-panel" id="vp2">
        <div class="v-mark" aria-hidden="true">III</div>
        <span class="v-num">Giá trị thứ ba</span>
        <h2 class="v-title">Minh bạch <em>tuyệt đối</em></h2>
        <p class="v-body">Điểm danh QR theo thời gian thực, học phí minh bạch từng đồng, audit log toàn bộ thao tác. Không có gì khuất trong bóng tối khi Lumina soi rọi.</p>
        <div class="v-tags"><span class="v-tag">QR &amp; Face ID</span><span class="v-tag">Quản lý học phí</span><span class="v-tag">Audit Log</span></div>
    </article>

    <article class="v-panel" id="vp3">
        <div class="v-mark" aria-hidden="true">IV</div>
        <span class="v-num">Giá trị thứ tư</span>
        <h2 class="v-title">Công nghệ <em>tiên phong</em></h2>
        <p class="v-body">Kiến trúc multi-tenant cách ly dữ liệu giữa các trường. ASP.NET Core 8 trên nền Clean Architecture, bảo mật AES-256, uptime 99.9%. Hạ tầng của tương lai, xây dựng cho hôm nay.</p>
        <div class="v-tags"><span class="v-tag">Multi-tenant</span><span class="v-tag">Clean Architecture</span><span class="v-tag">99.9% Uptime</span></div>
    </article>

    <article class="v-panel" id="vp4">
        <div class="v-mark" aria-hidden="true">V</div>
        <span class="v-num">Giá trị thứ năm</span>
        <h2 class="v-title">Di sản <em>bền vững</em></h2>
        <p class="v-body">Mỗi thế hệ học sinh đều để lại dấu vết trong hệ thống. Học bạ điện tử, bảng điểm toàn khoá, lịch sử chuyên cần — di sản học thuật được lưu giữ mãi mãi.</p>
        <div class="v-tags"><span class="v-tag">Học bạ điện tử</span><span class="v-tag">Lưu trữ lâu dài</span><span class="v-tag">Xuất PDF chính thức</span></div>
    </article>
</section>

<!-- GATEWAY -->
<section class="gateway-section" id="gateway" aria-labelledby="gwTitle" data-testid="gateway-section">
    <p class="gw-eyebrow" id="gwEyebrow">Cánh cổng tri thức</p>
    <h2 class="gw-title" id="gwTitle">Bạn đã sẵn sàng bước<br/>vào <em>ánh sáng</em>?</h2>

    <a asp-controller="Auth" asp-action="SelectRole"
       class="gateway" id="gatewayPortal"
       aria-label="Bước vào hệ thống Lumina Tutors"
       data-testid="gateway-portal">
        <div class="gw-ring gw-r1" aria-hidden="true"></div>
        <div class="gw-ring gw-r2" aria-hidden="true"></div>
        <div class="gw-ring gw-r3" aria-hidden="true"></div>
        <div class="gw-ripple"     aria-hidden="true"></div>
        <div class="gw-core" aria-hidden="true">
            <i class="bi bi-brightness-high gw-icon"></i>
            <span class="gw-lbl">Bước vào</span>
        </div>
    </a>

    <p class="gw-sub" id="gwSub">
        Đã có tài khoản?
        <a asp-controller="Auth" asp-action="Login" data-testid="gw-login">Đăng nhập tại đây</a>
    </p>
</section>

<!-- FOOTER -->
<footer class="footer" data-testid="landing-footer">
    <a href="/" class="footer-brand">Lumina Tutors</a>
    <nav class="footer-links" aria-label="Footer links">
        <a href="#story"   class="footer-lnk">Giá trị</a>
        <a href="#gateway" class="footer-lnk">Đăng nhập</a>
        <a href="mailto:contact@luminatutors.vn" class="footer-lnk">Liên hệ</a>
    </nav>
    <p class="footer-copy">© @DateTime.Now.Year Lumina Tutors</p>
</footer>

</div><!-- /page-wrap -->

<script>
(function () {
'use strict';

/* ─ Shared mouse position ─────────────────────────── */
var mx = window.innerWidth / 2, my = window.innerHeight / 2;
var rx = mx, ry = my;   /* ring lerp position */

document.addEventListener('mousemove', function (e) {
    mx = e.clientX; my = e.clientY;
}, { passive: true });

/* ─ One rAF loop: cursor + bloom + stars ─────────── */
var dotEl  = document.getElementById('cDot');
var ringEl = document.getElementById('cRing');
var bloom  = document.getElementById('bloom');
var root   = document.documentElement;
var bRad = 320, bRadTarget = 320; /* bloom radius */

(function loop() {
    /* Dot — snap */
    if (dotEl)  { dotEl.style.left  = mx + 'px'; dotEl.style.top  = my + 'px'; }
    /* Ring — lerp */
    rx += (mx - rx) * 0.14; ry += (my - ry) * 0.14;
    if (ringEl) { ringEl.style.left = rx + 'px'; ringEl.style.top = ry + 'px'; }
    /* Bloom radius lerp */
    bRad += (bRadTarget - bRad) * 0.08;
    /* Bloom position via CSS vars */
    root.style.setProperty('--bx', Math.round(mx) + 'px');
    root.style.setProperty('--by', Math.round(my) + 'px');
    /* Update bloom radial size inline (can't put var inside gradient radius easily in all browsers) */
    if (bloom) {
        bloom.style.background =
            'radial-gradient(circle ' + Math.round(bRad) + 'px at ' + Math.round(mx) + 'px ' + Math.round(my) + 'px,' +
            'rgba(200,165,60,0.12) 0%,rgba(200,165,60,0.05) 40%,transparent 70%)';
    }
    requestAnimationFrame(loop);
}());

/* ─ Cursor ring states ─────────────────────────────── */
document.addEventListener('mouseover', function (e) {
    var t = e.target.closest('a,button');
    if (!t || !ringEl) return;
    if (t.id === 'gatewayPortal' || t.closest('#gatewayPortal')) {
        ringEl.className = 'c-ring portal';
        bRadTarget = 440;
    } else {
        ringEl.className = 'c-ring hov';
    }
}, { passive: true });
document.addEventListener('mouseout', function (e) {
    var t = e.target.closest('a,button');
    if (!t || !ringEl) return;
    ringEl.className = 'c-ring';
    bRadTarget = 320;
}, { passive: true });

/* ─ Touch: restore default cursor ──────────────────── */
window.addEventListener('touchstart', function () {
    document.body.style.cursor = 'auto';
    ['cDot','cRing','bloom'].forEach(function (id) {
        var el = document.getElementById(id);
        if (el) el.style.display = 'none';
    });
}, { once: true, passive: true });

/* ─ Hero entrance (waits for paint) ────────────────── */
window.addEventListener('DOMContentLoaded', function () {
    setTimeout(function () { document.body.classList.add('in'); }, 60);
    setTimeout(function () {
        var s = document.getElementById('heroScroll');
        if (s) s.classList.add('visible');
    }, 2000);
});

/* ─ Navbar scroll ───────────────────────────────────── */
var nav = document.getElementById('mainNav');
window.addEventListener('scroll', function () {
    if (nav) nav.classList.toggle('scrolled', window.scrollY > 55);
}, { passive: true });

/* ─ Stats + generic reveal ─────────────────────────── */
var revObs = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) {
        if (e.isIntersecting) { e.target.classList.add('visible'); revObs.unobserve(e.target); }
    });
}, { threshold: 0.15 });
document.querySelectorAll('.reveal').forEach(function (el) { revObs.observe(el); });

/* ─ Value panels + golden thread ───────────────────── */
var panels = document.querySelectorAll('.v-panel');
var fill   = document.getElementById('threadFill');
var nodes  = [0,1,2,3,4].map(function (i) { return document.getElementById('tn'+i); });

var pObs = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) {
        if (!e.isIntersecting) return;
        var idx = [].indexOf.call(panels, e.target);
        e.target.classList.add('lit');
        if (fill) fill.style.height = Math.min(95, (idx+1)*20+3) + '%';
        if (nodes[idx]) nodes[idx].classList.add('lit');
        pObs.unobserve(e.target);
    });
}, { threshold: 0.25, rootMargin: '0px 0px -50px 0px' });
panels.forEach(function (p) { pObs.observe(p); });

/* ─ Gateway reveals ─────────────────────────────────── */
var gwObs = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) {
        if (e.isIntersecting) { e.target.classList.add('in'); gwObs.unobserve(e.target); }
    });
}, { threshold: 0.18 });
['gwEyebrow','gwTitle','gatewayPortal','gwSub'].forEach(function (id) {
    var el = document.getElementById(id); if (el) gwObs.observe(el);
});

}());
</script>
</body>
</html>
