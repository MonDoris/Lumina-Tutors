<!-- ═══════════════════════════════════════════════════════════════════
     JAVASCRIPT
═══════════════════════════════════════════════════════════════════ -->
<script>
(function () {
'use strict';
var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

/* ─────────────────────────────────────────────────────────────────
   1. SYSTEM SCAN BOOT — typed readout, then reveal
───────────────────────────────────────────────────────────────── */
(function boot() {
    var lines = [
        'INITIALIZING KNOWLEDGE GRAPH ........ <span class="ok">OK</span>',
        'MOUNTING DATA MODULES [6/6] ......... <span class="ok">OK</span>',
        'ESTABLISHING SECURE LINK ............ <span class="ok">OK</span>',
        'SYNCING 120K NODES .................. <span class="ok">OK</span>'
    ];
    var el = document.getElementById('bootLines');
    var boot = document.getElementById('boot');
    var i = 0;
    function step() {
        if (!el) return;
        if (i < lines.length) {
            el.innerHTML += lines[i] + '<br/>';
            i++;
            setTimeout(step, reduced ? 10 : 300);
        }
    }
    step();
    var delay = reduced ? 200 : 1650;
    setTimeout(function () {
        if (boot) boot.classList.add('done');
        document.body.classList.add('ready');
        startReveals();
    }, delay);
}());

/* ─────────────────────────────────────────────────────────────────
   2. INTERACTIVE NODE NETWORK  (HTML5 Canvas)
   ─────────────────────────────────────────────────────────────────
   • Nodes drift in "field space" (rotation-invariant) and bounce.
   • The whole field rotates slowly around its center each frame.
   • Edges connect nodes within a distance threshold; opacity scales
     with proximity. Edges near the cursor brighten + take an accent
     color (concept=cyber / skill=purple / mastery=green).
   • DPR-aware sizing; pauses when reduced-motion is set.
───────────────────────────────────────────────────────────────── */
(function nodeNetwork() {
    var canvas = document.getElementById('netCanvas');
    var host   = document.getElementById('viewport');
    if (!canvas || !host) return;
    var ctx = canvas.getContext('2d');

    var W = 0, H = 0, DPR = Math.min(window.devicePixelRatio || 1, 2);
    var nodes = [], EDGE_DIST = 132, angle = 0;
    var mouse = { x: -9999, y: -9999, on: false };
    var accents = ['#1763ff', '#7b3fe4', '#06bf86'];
    var edgeCount = 0;

    function size() {
        var r = host.getBoundingClientRect();
        W = r.width; H = r.height;
        canvas.width  = Math.round(W * DPR);
        canvas.height = Math.round(H * DPR);
        ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
        build();
    }

    function build() {
        // node density scales with area, clamped
        var n = Math.max(22, Math.min(46, Math.round((W * H) / 13000)));
        nodes = [];
        for (var i = 0; i < n; i++) {
            var a = Math.random() * Math.PI * 2;
            var rad = Math.pow(Math.random(), 0.7) * (Math.min(W, H) * 0.46);
            nodes.push({
                // field-space coords centered at 0,0
                fx: Math.cos(a) * rad,
                fy: Math.sin(a) * rad,
                vx: (Math.random() - 0.5) * 0.18,
                vy: (Math.random() - 0.5) * 0.18,
                r: 1.6 + Math.random() * 2.2,
                tier: Math.floor(Math.random() * 3),
                pulse: Math.random() * Math.PI * 2
            });
        }
    }

    function tick() {
        ctx.clearRect(0, 0, W, H);
        var cx = W / 2, cy = H / 2;
        if (!reduced) angle += 0.0013;
        var cos = Math.cos(angle), sin = Math.sin(angle);
        var bound = Math.min(W, H) * 0.48;

        // update + compute display coords
        for (var i = 0; i < nodes.length; i++) {
            var p = nodes[i];
            if (!reduced) { p.fx += p.vx; p.fy += p.vy; p.pulse += 0.03; }
            // soft circular bound
            var d = Math.sqrt(p.fx * p.fx + p.fy * p.fy);
            if (d > bound) { p.vx *= -1; p.vy *= -1; p.fx += p.vx * 2; p.fy += p.vy * 2; }
            // rotate field-space -> display
            p.dx = cx + (p.fx * cos - p.fy * sin);
            p.dy = cy + (p.fx * sin + p.fy * cos);
        }

        // edges
        edgeCount = 0;
        for (var a2 = 0; a2 < nodes.length; a2++) {
            for (var b = a2 + 1; b < nodes.length; b++) {
                var p1 = nodes[a2], p2 = nodes[b];
                var ddx = p1.dx - p2.dx, ddy = p1.dy - p2.dy;
                var dist = Math.sqrt(ddx * ddx + ddy * ddy);
                if (dist > EDGE_DIST) continue;
                edgeCount++;
                var t = 1 - dist / EDGE_DIST;
                // cursor proximity to either endpoint
                var near = false, accent = null;
                if (mouse.on) {
                    var m1 = Math.hypot(p1.dx - mouse.x, p1.dy - mouse.y);
                    var m2 = Math.hypot(p2.dx - mouse.x, p2.dy - mouse.y);
                    var mm = Math.min(m1, m2);
                    if (mm < 110) { near = true; accent = accents[(p1.tier + p2.tier) % 3]; }
                }
                ctx.beginPath();
                ctx.moveTo(p1.dx, p1.dy);
                ctx.lineTo(p2.dx, p2.dy);
                if (near) {
                    ctx.strokeStyle = accent;
                    ctx.globalAlpha = 0.25 + t * 0.6;
                    ctx.lineWidth = 1.3;
                } else {
                    ctx.strokeStyle = '#5e6b80';
                    ctx.globalAlpha = t * 0.28;
                    ctx.lineWidth = 1;
                }
                ctx.stroke();
            }
        }
        ctx.globalAlpha = 1;

        // nodes
        for (var k = 0; k < nodes.length; k++) {
            var pn = nodes[k];
            var md = mouse.on ? Math.hypot(pn.dx - mouse.x, pn.dy - mouse.y) : 9999;
            var lit = md < 110;
            var col = lit ? accents[pn.tier] : '#2f3c50';
            var pr = pn.r + (reduced ? 0 : Math.sin(pn.pulse) * 0.5);
            if (lit) {
                ctx.beginPath();
                ctx.arc(pn.dx, pn.dy, pr + 5, 0, Math.PI * 2);
                ctx.fillStyle = accents[pn.tier];
                ctx.globalAlpha = 0.14;
                ctx.fill();
                ctx.globalAlpha = 1;
            }
            ctx.beginPath();
            ctx.arc(pn.dx, pn.dy, pr, 0, Math.PI * 2);
            ctx.fillStyle = col;
            ctx.fill();
            // ring for tier-0 (concept) nodes
            if (pn.tier === 0) {
                ctx.beginPath();
                ctx.arc(pn.dx, pn.dy, pr + 2.5, 0, Math.PI * 2);
                ctx.strokeStyle = lit ? accents[0] : '#b9c4d4';
                ctx.globalAlpha = lit ? 0.8 : 0.5;
                ctx.lineWidth = 1;
                ctx.stroke();
                ctx.globalAlpha = 1;
            }
        }

        // HUD readout
        if (roNodes) roNodes.textContent = String(nodes.length).padStart(3, '0');
        if (roEdges) roEdges.textContent = String(edgeCount).padStart(3, '0');
        if (roCoh)   roCoh.textContent = (0.82 + Math.sin(angle * 6) * 0.04).toFixed(3);

        requestAnimationFrame(tick);
    }

    var roNodes = document.getElementById('roNodes');
    var roEdges = document.getElementById('roEdges');
    var roCoh   = document.getElementById('roCoh');

    host.addEventListener('mousemove', function (e) {
        var r = host.getBoundingClientRect();
        mouse.x = e.clientX - r.left; mouse.y = e.clientY - r.top; mouse.on = true;
    });
    host.addEventListener('mouseleave', function () { mouse.on = false; mouse.x = mouse.y = -9999; });

    var rt;
    window.addEventListener('resize', function () { clearTimeout(rt); rt = setTimeout(size, 160); });

    size();
    requestAnimationFrame(tick);
}());

/* ─────────────────────────────────────────────────────────────────
   3. COUNTER ANIMATIONS (count-up with easing)
───────────────────────────────────────────────────────────────── */
function animateCount(el) {
    var target = parseFloat(el.getAttribute('data-count'));
    var dec    = parseInt(el.getAttribute('data-decimals') || '0', 10);
    var suffix = el.getAttribute('data-suffix') || '';
    var dur    = reduced ? 0 : 1400;
    var start  = performance.now();
    // keep any leading <span> placeholder, replace trailing text node
    function fmt(v) { return v.toFixed(dec) + suffix; }
    function frame(now) {
        var t = dur === 0 ? 1 : Math.min((now - start) / dur, 1);
        var eased = 1 - Math.pow(1 - t, 3);
        var val = target * eased;
        // write into the element's last text node (preserve child spans/units)
        var unit = el.querySelector('.u');
        var unitHTML = unit ? unit.outerHTML : '';
        el.firstChild && el.firstChild.nodeType === 1 && el.firstChild.classList && el.firstChild.classList.contains('u');
        el.childNodes.forEach ? null : null;
        // Simplest robust approach: set text before unit
        if (unit) {
            // remove existing text nodes, keep unit
            var nodes = Array.prototype.slice.call(el.childNodes);
            nodes.forEach(function (n) { if (n.nodeType === 3) el.removeChild(n); });
            el.insertBefore(document.createTextNode(fmt(val)), unit);
        } else {
            el.textContent = fmt(val);
        }
        if (t < 1) requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);
}

/* ─────────────────────────────────────────────────────────────────
   4. SPARKLINES (build polylines from data-spark)
───────────────────────────────────────────────────────────────── */
function buildSparks() {
    document.querySelectorAll('.metric-spark').forEach(function (svg) {
        var pts = (svg.getAttribute('data-spark') || '').split(',').map(Number);
        var color = svg.getAttribute('data-color') || '#1763ff';
        if (!pts.length) return;
        var max = Math.max.apply(null, pts), min = Math.min.apply(null, pts);
        var range = (max - min) || 1;
        var w = 100, h = 30, pad = 3;
        var coords = pts.map(function (v, i) {
            var x = (i / (pts.length - 1)) * w;
            var y = pad + (1 - (v - min) / range) * (h - pad * 2);
            return x.toFixed(1) + ',' + y.toFixed(1);
        });
        var poly = coords.join(' ');
        var area = '0,' + h + ' ' + poly + ' ' + w + ',' + h;
        svg.innerHTML =
            '<polygon points="' + area + '" fill="' + color + '" opacity="0.08"/>' +
            '<polyline points="' + poly + '" fill="none" stroke="' + color + '" stroke-width="1.6" ' +
            'stroke-linejoin="round" stroke-linecap="round" ' +
            'style="stroke-dasharray:200;stroke-dashoffset:200;transition:stroke-dashoffset 1.4s cubic-bezier(0.16,1,0.3,1)"/>' +
            '<circle cx="' + w + '" cy="' + coords[coords.length-1].split(',')[1] + '" r="2.4" fill="' + color + '"/>';
    });
}
function runSparks() {
    document.querySelectorAll('.metric-spark polyline').forEach(function (pl) { pl.style.strokeDashoffset = '0'; });
}

/* ─────────────────────────────────────────────────────────────────
   5. MODULE MINI-BARS (height from data-bars)
───────────────────────────────────────────────────────────────── */
function buildModBars() {
    document.querySelectorAll('.mod-viz').forEach(function (viz) {
        var vals = (viz.getAttribute('data-bars') || '').split(',').map(Number);
        viz.innerHTML = vals.map(function () { return '<span class="b" style="height:0"></span>'; }).join('');
        viz._vals = vals;
    });
}
function runModBars(viz) {
    if (!viz._vals) return;
    var bars = viz.querySelectorAll('.b');
    viz._vals.forEach(function (v, i) {
        setTimeout(function () { if (bars[i]) bars[i].style.height = v + '%'; }, i * 40);
    });
}

/* ─────────────────────────────────────────────────────────────────
   6. REVEAL + trigger viz when sections enter
───────────────────────────────────────────────────────────────── */
function startReveals() {
    buildSparks(); buildModBars();

    var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
            if (!e.isIntersecting) return;
            var el = e.target;
            el.classList.add('in');

            // counters
            el.querySelectorAll && el.querySelectorAll('[data-count]').forEach(function (c) {
                if (!c._done) { c._done = true; animateCount(c); }
            });
            if (el.hasAttribute('data-count') && !el._done) { el._done = true; animateCount(el); }

            io.unobserve(el);
        });
    }, { threshold: 0.18 });

    document.querySelectorAll('.reveal, [data-count]').forEach(function (el) { io.observe(el); });

    // metrics bar — counters + sparks
    var metricsIO = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
            if (!e.isIntersecting) return;
            e.target.querySelectorAll('[data-count]').forEach(function (c) { if (!c._done) { c._done = true; animateCount(c); } });
            runSparks();
            metricsIO.unobserve(e.target);
        });
    }, { threshold: 0.3 });
    var mb = document.querySelector('.metrics'); if (mb) metricsIO.observe(mb);

    // hero mini counters fire on ready
    document.querySelectorAll('.hero-mini [data-count]').forEach(function (c) {
        if (!c._done) { c._done = true; setTimeout(function(){ animateCount(c); }, 900); }
    });

    // modules — mini bars
    var modIO = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
            if (e.isIntersecting) { var v = e.target.querySelector('.mod-viz'); if (v) runModBars(v); modIO.unobserve(e.target); }
        });
    }, { threshold: 0.3 });
    document.querySelectorAll('.mod').forEach(function (m) { modIO.observe(m); });

    // console — bars / gauge / progress / line
    var conIO = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
            if (!e.isIntersecting) return;
            // bar chart
            e.target.querySelectorAll('.bc-bar').forEach(function (b, i) {
                setTimeout(function () { b.style.height = b.getAttribute('data-h') + '%'; }, i * 30);
            });
            // gauge
            e.target.querySelectorAll('.gauge-ring').forEach(function (g) {
                var v = g.getAttribute('data-val');
                // animate conic via requestAnimationFrame fallback (custom prop may not transition everywhere)
                var start = performance.now(), dur = reduced ? 0 : 1400, target = parseFloat(v);
                (function fr(now){
                    var t = dur === 0 ? 1 : Math.min((now-start)/dur,1);
                    var eased = 1 - Math.pow(1-t,3);
                    g.style.setProperty('--val', (target*eased).toFixed(1));
                    if (t<1) requestAnimationFrame(fr);
                })(performance.now());
            });
            // progress
            e.target.querySelectorAll('.prog-fill').forEach(function (p, i) {
                setTimeout(function () { p.style.width = p.getAttribute('data-w') + '%'; }, 150 + i * 80);
            });
            // line
            var lc = e.target.querySelector('.linechart'); if (lc) lc.classList.add('in');
            conIO.unobserve(e.target);
        });
    }, { threshold: 0.2 });
    var cf = document.querySelector('.console-frame'); if (cf) conIO.observe(cf);
}

/* ─────────────────────────────────────────────────────────────────
   7. NAV border on scroll
───────────────────────────────────────────────────────────────── */
var nav = document.querySelector('.nav');
window.addEventListener('scroll', function () {
    if (nav) nav.style.borderColor = window.scrollY > 20 ? 'var(--line-2)' : 'var(--line)';
}, { passive: true });

}());
</script>
</body>
</html>
