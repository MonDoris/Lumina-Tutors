@{
    Layout = null;
    /*
     * ╔══════════════════════════════════════════════════════════════╗
     * ║  LUMINA TUTORS — LANDING PAGE                                 ║
     * ║  Concept: "The Architecture of Knowledge"                    ║
     * ║  Futuristic Data Canvas · Technical Blueprint · Live Data     ║
     * ║  ASP.NET Core MVC — Layout = null (standalone)                ║
     * ║  Palette: Tech White · Cyber Blue · Quantum Purple · Optical  ║
     * ╚══════════════════════════════════════════════════════════════╝
     */
}
<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<meta name="description" content="Lumina Tutors — Kiến trúc của Tri thức. Nền tảng giáo dục vận hành bằng dữ liệu."/>
<title>Lumina Tutors — Kiến trúc của Tri thức</title>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet"/>

<style>
/* ═══════════════════════════════════════════════════════════════════
   RESET & DESIGN TOKENS
   Palette uses hex/rgba (verified reliable in this runtime) but every
   neutral is tinted toward the cool blueprint hue — no pure #000/#fff.
═══════════════════════════════════════════════════════════════════ */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; font-size: 16px; -webkit-text-size-adjust: 100%; }

:root {
    /* Surfaces — cool tech white / grey */
    --bg:        #eef1f6;   /* page                        */
    --paper:     #f7f9fc;   /* raised panel                */
    --paper-2:   #ffffff;   /* card (tinted via overlay)   */
    --ink:       #0d1626;   /* near-black, blue-tinted     */
    --ink-2:     #2f3c50;   /* secondary text              */
    --muted:     #6a7589;   /* captions / labels           */
    --line:      #d3dae5;   /* grid lines (solid)          */
    --line-2:    #c0cad9;   /* stronger grid               */
    --dash:      #b9c4d4;   /* dashed border color         */

    /* Scientific accents */
    --cyber:     #1763ff;   /* Cyber Blue — primary        */
    --cyber-2:   #4f8bff;
    --purple:    #7b3fe4;   /* Quantum Purple              */
    --purple-2:  #9a6bf0;
    --green:     #06bf86;   /* Optical Green               */
    --green-2:   #2dd6a0;
    --amber:     #f0a020;   /* warning / tertiary metric   */

    --cyber-a:   rgba(23,99,255,.10);
    --purple-a:  rgba(123,63,228,.10);
    --green-a:   rgba(6,191,134,.12);

    --ease:      cubic-bezier(0.16, 1, 0.3, 1);
    --ease-io:   cubic-bezier(0.65, 0, 0.35, 1);

    --fs-mono:   'JetBrains Mono', ui-monospace, monospace;
    --fs-disp:   'Space Grotesk', sans-serif;
    --fs-body:   'Inter', sans-serif;
}

body {
    font-family: var(--fs-body);
    background: var(--bg);
    color: var(--ink-2);
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
    overflow-x: hidden;
}

::selection { background: var(--cyber); color: #fff; }

a { color: inherit; text-decoration: none; }

/* Mono helper */
.mono { font-family: var(--fs-mono); font-feature-settings: "tnum" 1; }

/* ═══════════════════════════════════════════════════════════════════
   FIXED TECHNICAL GRID BACKGROUND + HUD CORNERS
═══════════════════════════════════════════════════════════════════ */
.grid-bg {
    position: fixed; inset: 0; z-index: 0; pointer-events: none;
    background-image:
        linear-gradient(to right,  rgba(120,140,170,.07) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(120,140,170,.07) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse 120% 90% at 50% 0%, #000 40%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 120% 90% at 50% 0%, #000 40%, transparent 100%);
}
.grid-bg::after {
    content: '';
    position: absolute; inset: 0;
    background-image:
        linear-gradient(to right,  rgba(120,140,170,.12) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(120,140,170,.12) 1px, transparent 1px);
    background-size: 256px 256px;
}

/* Page HUD frame (corner ticks + edge coordinates) */
.hud { position: fixed; inset: 0; z-index: 1; pointer-events: none; }
.hud-corner {
    position: absolute; width: 18px; height: 18px;
    border: 1.5px solid var(--cyber);
    opacity: .55;
}
.hud-corner.tl { top: 16px;    left: 16px;    border-right: none; border-bottom: none; }
.hud-corner.tr { top: 16px;    right: 16px;   border-left: none;  border-bottom: none; }
.hud-corner.bl { bottom: 16px; left: 16px;    border-right: none; border-top: none; }
.hud-corner.br { bottom: 16px; right: 16px;   border-left: none;  border-top: none; }
.hud-edge {
    position: fixed;
    font-family: var(--fs-mono); font-size: .58rem; letter-spacing: .12em;
    color: var(--muted); opacity: .6;
}
.hud-edge.left  { left: 24px; top: 50%; transform: rotate(-90deg) translateX(50%); transform-origin: left center; }
.hud-edge.right { right: 24px; top: 50%; transform: rotate(90deg) translateX(-50%); transform-origin: right center; }

@@media (max-width: 1000px) { .hud-edge { display: none; } }

/* ═══════════════════════════════════════════════════════════════════
   SYSTEM SCAN — boot overlay
═══════════════════════════════════════════════════════════════════ */
.boot {
    position: fixed; inset: 0; z-index: 9000;
    background: var(--bg);
    display: flex; align-items: center; justify-content: center;
    transition: opacity .6s var(--ease), visibility .6s;
}
.boot.done { opacity: 0; visibility: hidden; }
.boot-scan {
    position: absolute; left: 0; right: 0; top: 0; height: 2px;
    background: linear-gradient(90deg, transparent, var(--cyber) 25%, var(--purple) 50%, var(--green) 75%, transparent);
    box-shadow: 0 0 24px 4px rgba(23,99,255,.5);
    animation: scan-sweep 1.5s var(--ease-io) forwards;
}
@@keyframes scan-sweep {
    0%   { top: 0;    opacity: 0; }
    8%   { opacity: 1; }
    92%  { opacity: 1; }
    100% { top: 100%; opacity: 0; }
}
.boot-readout {
    text-align: center;
    font-family: var(--fs-mono);
}
.boot-logo {
    font-family: var(--fs-disp); font-weight: 700;
    font-size: 1.4rem; letter-spacing: .04em; color: var(--ink);
    margin-bottom: 20px;
}
.boot-logo b { color: var(--cyber); }
.boot-lines { font-size: .72rem; color: var(--muted); line-height: 2; min-height: 90px; }
.boot-lines .ok { color: var(--green); }
.boot-bar {
    width: 240px; height: 3px; margin: 22px auto 0;
    background: var(--line); border-radius: 99px; overflow: hidden;
}
.boot-bar-fill {
    height: 100%; width: 0; background: linear-gradient(90deg, var(--cyber), var(--purple));
    animation: boot-fill 1.5s var(--ease-io) forwards;
}
@@keyframes boot-fill { to { width: 100%; } }

/* ═══════════════════════════════════════════════════════════════════
   SHELL — constrains content over grid
═══════════════════════════════════════════════════════════════════ */
.shell { position: relative; z-index: 2; }
.wrap { max-width: 1320px; margin: 0 auto; padding: 0 40px; }

/* Section eyebrow / label common */
.tag {
    font-family: var(--fs-mono); font-size: .62rem; font-weight: 500;
    letter-spacing: .2em; text-transform: uppercase; color: var(--cyber);
    display: inline-flex; align-items: center; gap: 8px;
}
.tag::before {
    content: ''; width: 18px; height: 1px; background: var(--cyber);
}
.tag.purple { color: var(--purple); }
.tag.purple::before { background: var(--purple); }
.tag.green { color: var(--green); }
.tag.green::before { background: var(--green); }

.h-section {
    font-family: var(--fs-disp); font-weight: 600;
    font-size: clamp(1.9rem, 3.4vw, 3rem); line-height: 1.08;
    letter-spacing: -.02em; color: var(--ink);
}
.sub-section {
    font-size: .95rem; color: var(--muted); line-height: 1.7; max-width: 56ch;
}

/* ═══════════════════════════════════════════════════════════════════
   NAV
═══════════════════════════════════════════════════════════════════ */
.nav {
    position: sticky; top: 0; z-index: 100;
    height: 64px;
    border-bottom: 1px solid var(--line);
    background: rgba(238,241,246,.8);
    backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
    transition: border-color .3s;
}
.nav-inner { max-width: 1320px; margin: 0 auto; padding: 0 40px; height: 100%;
    display: flex; align-items: center; justify-content: space-between; }
.brand { display: flex; align-items: center; gap: 12px; }
.brand-mark {
    width: 32px; height: 32px; position: relative;
    border: 1.5px solid var(--ink); border-radius: 6px;
    display: grid; place-items: center;
    overflow: hidden;
}
.brand-mark::before {
    content: ''; position: absolute; inset: 0;
    background:
        linear-gradient(135deg, transparent 45%, var(--cyber) 45%, var(--cyber) 55%, transparent 55%),
        linear-gradient(45deg,  transparent 45%, var(--purple) 45%, var(--purple) 55%, transparent 55%);
    opacity: .85;
}
.brand-mark span {
    position: relative; z-index: 1; width: 8px; height: 8px; border-radius: 50%;
    background: var(--ink);
}
.brand-name {
    font-family: var(--fs-disp); font-weight: 600; font-size: 1.05rem;
    letter-spacing: .01em; color: var(--ink);
}
.brand-ver { font-family: var(--fs-mono); font-size: .58rem; color: var(--muted); letter-spacing: .1em; }

.nav-links { display: flex; gap: 4px; }
.nav-link {
    font-family: var(--fs-mono); font-size: .72rem; letter-spacing: .04em;
    color: var(--ink-2); padding: 8px 14px; border-radius: 6px;
    transition: background .18s, color .18s;
}
.nav-link:hover { background: var(--cyber-a); color: var(--cyber); }
.nav-right { display: flex; align-items: center; gap: 16px; }
.status {
    display: inline-flex; align-items: center; gap: 7px;
    font-family: var(--fs-mono); font-size: .62rem; letter-spacing: .08em;
    color: var(--muted);
}
.status-dot {
    width: 7px; height: 7px; border-radius: 50%; background: var(--green);
    box-shadow: 0 0 0 0 rgba(6,191,134,.5);
    animation: pulse-dot 2s infinite;
}
@@keyframes pulse-dot {
    0%   { box-shadow: 0 0 0 0 rgba(6,191,134,.5); }
    70%  { box-shadow: 0 0 0 6px rgba(6,191,134,0); }
    100% { box-shadow: 0 0 0 0 rgba(6,191,134,0); }
}

/* Buttons */
.btn {
    font-family: var(--fs-mono); font-size: .72rem; font-weight: 500;
    letter-spacing: .04em; padding: 10px 18px; border-radius: 7px;
    display: inline-flex; align-items: center; gap: 9px; cursor: pointer;
    border: 1px solid transparent; transition: all .2s var(--ease);
    white-space: nowrap;
}
.btn-primary {
    background: var(--ink); color: #fff;
    box-shadow: 0 1px 0 rgba(255,255,255,.1) inset, 0 6px 18px rgba(13,22,38,.18);
}
.btn-primary:hover { background: var(--cyber); box-shadow: 0 8px 24px rgba(23,99,255,.32); transform: translateY(-1px); }
.btn-ghost { border-color: var(--line-2); color: var(--ink-2); background: var(--paper); }
.btn-ghost:hover { border-color: var(--cyber); color: var(--cyber); }
.btn-arrow { transition: transform .25s var(--ease); }
.btn:hover .btn-arrow { transform: translateX(3px); }

@@media (max-width: 880px) { .nav-links, .status { display: none; } .nav-inner, .wrap { padding: 0 22px; } }

/* ═══════════════════════════════════════════════════════════════════
   HERO
═══════════════════════════════════════════════════════════════════ */
.hero { padding: 72px 0 40px; position: relative; }
.hero-grid {
    display: grid; grid-template-columns: 1.05fr .95fr; gap: 48px; align-items: stretch;
}
.hero-left { display: flex; flex-direction: column; justify-content: center; padding: 12px 0; }

.hero-eyebrow {
    display: flex; align-items: center; gap: 14px; margin-bottom: 28px;
    opacity: 0; transform: translateY(12px);
}
.hero-coord { font-family: var(--fs-mono); font-size: .6rem; color: var(--muted); letter-spacing: .1em; }

.hero-title {
    font-family: var(--fs-disp); font-weight: 700;
    font-size: clamp(2.8rem, 5.6vw, 5rem); line-height: 1.02;
    letter-spacing: -.03em; color: var(--ink); margin-bottom: 26px;
}
.hero-title .accent {
    position: relative; color: var(--cyber);
}
.hero-title .accent::after {
    content: ''; position: absolute; left: 0; bottom: .08em; width: 100%; height: .07em;
    background: linear-gradient(90deg, var(--cyber), var(--purple)); border-radius: 2px;
    transform: scaleX(0); transform-origin: left; transition: transform .9s var(--ease) .9s;
}
body.ready .hero-title .accent::after { transform: scaleX(1); }
.hero-line { display: block; overflow: hidden; }
.hero-line > span { display: block; transform: translateY(105%); }

.hero-desc {
    font-size: 1.02rem; line-height: 1.75; color: var(--ink-2);
    max-width: 50ch; margin-bottom: 36px;
    opacity: 0; transform: translateY(12px);
}
.hero-desc b { color: var(--ink); font-weight: 600; }

.hero-actions {
    display: flex; gap: 14px; align-items: center; margin-bottom: 40px;
    opacity: 0; transform: translateY(12px);
}
.hero-actions .btn { padding: 14px 24px; font-size: .78rem; }

/* Inline mini metrics under hero */
.hero-mini {
    display: grid; grid-template-columns: repeat(3, 1fr);
    border: 1px dashed var(--dash); border-radius: 10px;
    overflow: hidden; background: var(--paper);
    opacity: 0; transform: translateY(12px);
}
.hm-cell { padding: 16px 20px; border-right: 1px dashed var(--dash); }
.hm-cell:last-child { border-right: none; }
.hm-val {
    font-family: var(--fs-disp); font-weight: 600; font-size: 1.5rem; color: var(--ink);
    line-height: 1; letter-spacing: -.01em;
}
.hm-val .u { font-size: .85rem; color: var(--cyber); }
.hm-lbl { font-family: var(--fs-mono); font-size: .58rem; letter-spacing: .06em; color: var(--muted); margin-top: 7px; text-transform: uppercase; }

/* hero entrance */
body.ready .hero-eyebrow { animation: rise .7s var(--ease) .15s forwards; }
body.ready .hero-line > span { animation: rise-line .9s var(--ease) forwards; }
body.ready .hero-line:nth-child(1) > span { animation-delay: .25s; }
body.ready .hero-line:nth-child(2) > span { animation-delay: .35s; }
body.ready .hero-desc    { animation: rise .8s var(--ease) .6s forwards; }
body.ready .hero-actions { animation: rise .8s var(--ease) .72s forwards; }
body.ready .hero-mini    { animation: rise .8s var(--ease) .84s forwards; }
@@keyframes rise { to { opacity: 1; transform: translateY(0); } }
@@keyframes rise-line { to { transform: translateY(0); } }

/* Hero VIEWPORT — the node network canvas module */
.viewport {
    position: relative;
    border: 1px solid var(--line-2);
    border-radius: 14px;
    background:
        radial-gradient(circle at 50% 40%, rgba(255,255,255,.9), rgba(247,249,252,.75));
    overflow: hidden;
    min-height: 480px;
    box-shadow: 0 30px 70px rgba(13,22,38,.10), 0 1px 0 rgba(255,255,255,.7) inset;
    opacity: 0; transform: scale(.97);
}
body.ready .viewport { animation: vp-in 1s var(--ease) .4s forwards; }
@@keyframes vp-in { to { opacity: 1; transform: scale(1); } }

.viewport canvas { display: block; width: 100%; height: 100%; position: absolute; inset: 0; }

/* corner ticks inside viewport */
.vp-tick { position: absolute; width: 12px; height: 12px; border: 1px solid var(--cyber); opacity: .6; z-index: 3; }
.vp-tick.tl { top: 14px; left: 14px; border-right: none; border-bottom: none; }
.vp-tick.tr { top: 14px; right: 14px; border-left: none; border-bottom: none; }
.vp-tick.bl { bottom: 14px; left: 14px; border-right: none; border-top: none; }
.vp-tick.br { bottom: 14px; right: 14px; border-left: none; border-top: none; }

.vp-hud { position: absolute; z-index: 3; font-family: var(--fs-mono); pointer-events: none; }
.vp-hud.top {
    top: 16px; left: 50%; transform: translateX(-50%);
    font-size: .6rem; letter-spacing: .14em; color: var(--muted); text-transform: uppercase;
}
.vp-readout {
    position: absolute; left: 18px; bottom: 16px; z-index: 3;
    font-family: var(--fs-mono); font-size: .62rem; color: var(--ink-2);
    display: flex; flex-direction: column; gap: 3px; pointer-events: none;
}
.vp-readout .k { color: var(--muted); }
.vp-readout .v { color: var(--cyber); }
.vp-readout .v.g { color: var(--green); }
.vp-readout .v.p { color: var(--purple); }
.vp-legend {
    position: absolute; right: 18px; bottom: 16px; z-index: 3;
    display: flex; flex-direction: column; gap: 5px; align-items: flex-end;
    font-family: var(--fs-mono); font-size: .58rem; color: var(--muted); pointer-events: none;
}
.vp-legend i { display: inline-block; width: 8px; height: 8px; border-radius: 2px; margin-left: 6px; vertical-align: middle; }

@@media (max-width: 980px) {
    .hero-grid { grid-template-columns: 1fr; gap: 32px; }
    .viewport { min-height: 380px; order: -1; }
}
@@media (max-width: 560px) {
    .hero-mini { grid-template-columns: 1fr; }
    .hm-cell { border-right: none; border-bottom: 1px dashed var(--dash); }
    .hm-cell:last-child { border-bottom: none; }
    .hero-actions { flex-wrap: wrap; }
}

/* ═══════════════════════════════════════════════════════════════════
   METRICS BAR — counters + sparklines
═══════════════════════════════════════════════════════════════════ */
.metrics {
    margin-top: 48px;
    border-top: 1px dashed var(--dash); border-bottom: 1px dashed var(--dash);
    display: grid; grid-template-columns: repeat(4, 1fr);
}
.metric {
    padding: 34px 28px; border-right: 1px dashed var(--dash);
    position: relative; overflow: hidden;
}
.metric:last-child { border-right: none; }
.metric-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; }
.metric-id { font-family: var(--fs-mono); font-size: .56rem; letter-spacing: .12em; color: var(--muted); }
.metric-trend { font-family: var(--fs-mono); font-size: .6rem; color: var(--green); }
.metric-val {
    font-family: var(--fs-disp); font-weight: 600; font-size: clamp(2rem, 3.4vw, 2.8rem);
    line-height: 1; letter-spacing: -.02em; color: var(--ink);
}
.metric-val .u { font-size: .5em; color: var(--cyber); margin-left: 2px; }
.metric-lbl { font-size: .8rem; color: var(--muted); margin-top: 10px; }
.metric-spark { margin-top: 16px; height: 30px; width: 100%; display: block; }

@@media (max-width: 880px) { .metrics { grid-template-columns: 1fr 1fr; } .metric:nth-child(2){border-right:none;} .metric:nth-child(1),.metric:nth-child(2){border-bottom:1px dashed var(--dash);} }
@@media (max-width: 460px) { .metrics { grid-template-columns: 1fr; } .metric { border-right: none; border-bottom: 1px dashed var(--dash); } }

/* ═══════════════════════════════════════════════════════════════════
   MODULES — technical feature grid
═══════════════════════════════════════════════════════════════════ */
.modules { padding: 110px 0; }
.mod-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 40px; margin-bottom: 48px; }
.mod-head .tag { margin-bottom: 16px; }
.mod-grid {
    display: grid; grid-template-columns: repeat(3, 1fr);
    border: 1px solid var(--line); border-radius: 14px; overflow: hidden;
    background: var(--line);
    gap: 1px;
}
.mod {
    background: var(--paper);
    padding: 30px 28px 28px; position: relative;
    transition: background .25s;
    min-height: 250px;
    display: flex; flex-direction: column;
}
.mod:hover { background: var(--paper-2); }
.mod::before {
    content: ''; position: absolute; top: 0; left: 0; width: 0; height: 2px;
    background: var(--bar, var(--cyber)); transition: width .4s var(--ease);
}
.mod:hover::before { width: 100%; }
.mod-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 22px; }
.mod-num { font-family: var(--fs-mono); font-size: .6rem; letter-spacing: .1em; color: var(--muted); }
.mod-ico {
    width: 38px; height: 38px; border-radius: 9px; display: grid; place-items: center;
    background: var(--bar-a, var(--cyber-a)); color: var(--bar, var(--cyber));
    border: 1px solid color-mix(in srgb, var(--bar, var(--cyber)) 25%, transparent);
}
.mod-ico svg { width: 19px; height: 19px; }
.mod-title { font-family: var(--fs-disp); font-weight: 600; font-size: 1.12rem; color: var(--ink); margin-bottom: 9px; letter-spacing: -.01em; }
.mod-body { font-size: .85rem; color: var(--muted); line-height: 1.65; flex: 1; }
/* tiny viz inside module footer */
.mod-viz { margin-top: 18px; height: 26px; display: flex; align-items: flex-end; gap: 3px; }
.mod-viz .b { flex: 1; background: var(--bar, var(--cyber)); border-radius: 2px 2px 0 0; opacity: .25; transition: opacity .3s, height .5s var(--ease); }
.mod:hover .mod-viz .b { opacity: .85; }
.mod-tags { margin-top: 16px; display: flex; flex-wrap: wrap; gap: 6px; }
.mod-chip {
    font-family: var(--fs-mono); font-size: .56rem; letter-spacing: .05em;
    padding: 3px 8px; border-radius: 5px; background: var(--bg); color: var(--ink-2);
    border: 1px solid var(--line);
}

@@media (max-width: 920px) { .mod-grid { grid-template-columns: 1fr 1fr; } }
@@media (max-width: 600px) { .mod-grid { grid-template-columns: 1fr; } .mod-head { flex-direction: column; align-items: flex-start; } }

/* ═══════════════════════════════════════════════════════════════════
   DATA CONSOLE — live dashboard preview
═══════════════════════════════════════════════════════════════════ */
.console { padding: 0 0 110px; }
.console-frame {
    border: 1px solid var(--line-2); border-radius: 16px; overflow: hidden;
    background: var(--paper);
    box-shadow: 0 40px 90px rgba(13,22,38,.1);
}
.console-bar {
    display: flex; align-items: center; gap: 14px;
    padding: 13px 20px; border-bottom: 1px solid var(--line);
    background: rgba(255,255,255,.55);
}
.console-dots { display: flex; gap: 6px; }
.console-dots i { width: 10px; height: 10px; border-radius: 50%; }
.cd-r { background: #ec6a5e; } .cd-y { background: #f4bf4f; } .cd-g { background: #61c554; }
.console-path { font-family: var(--fs-mono); font-size: .66rem; color: var(--muted); }
.console-path b { color: var(--ink-2); }
.console-live {
    margin-left: auto; font-family: var(--fs-mono); font-size: .6rem; color: var(--green);
    display: inline-flex; align-items: center; gap: 6px;
}
.console-body {
    display: grid; grid-template-columns: 1.4fr 1fr 1fr;
    grid-auto-rows: minmax(0, auto); gap: 1px; background: var(--line);
}
.panel { background: var(--paper); padding: 24px; }
.panel-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18px; }
.panel-title { font-family: var(--fs-mono); font-size: .66rem; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-2); }
.panel-meta { font-family: var(--fs-mono); font-size: .58rem; color: var(--muted); }

/* span helpers */
.panel.col-span-1 { grid-column: span 1; }
.panel.big { grid-column: 1; grid-row: 1 / 3; }

/* Bar chart (cohort performance) */
.barchart { display: flex; align-items: flex-end; gap: 10px; height: 200px; padding-top: 10px; }
.bc-col { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 8px; height: 100%; justify-content: flex-end; }
.bc-bar-wrap { width: 100%; display: flex; align-items: flex-end; justify-content: center; gap: 4px; flex: 1; }
.bc-bar {
    width: 42%; border-radius: 4px 4px 0 0; height: 0;
    transition: height 1.1s var(--ease);
}
.bc-a { background: linear-gradient(to top, var(--cyber), var(--cyber-2)); }
.bc-b { background: linear-gradient(to top, var(--purple), var(--purple-2)); }
.bc-lbl { font-family: var(--fs-mono); font-size: .58rem; color: var(--muted); }
.bc-legend { display: flex; gap: 16px; }
.bc-legend span { font-family: var(--fs-mono); font-size: .58rem; color: var(--muted); display: inline-flex; align-items: center; gap: 6px; }
.bc-legend i { width: 9px; height: 9px; border-radius: 2px; }

/* Radial gauge (attendance) */
.gauge { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14px; height: 100%; }
.gauge-ring {
    --val: 0;
    width: 150px; height: 150px; border-radius: 50%;
    background: conic-gradient(var(--green) calc(var(--val) * 1%), var(--line) 0);
    display: grid; place-items: center; position: relative;
    transition: --val 1.4s var(--ease);
}
.gauge-ring::before { content: ''; position: absolute; inset: 14px; border-radius: 50%; background: var(--paper); }
.gauge-center { position: relative; text-align: center; }
.gauge-num { font-family: var(--fs-disp); font-weight: 600; font-size: 2rem; color: var(--ink); line-height: 1; }
.gauge-num .u { font-size: .9rem; color: var(--green); }
.gauge-cap { font-family: var(--fs-mono); font-size: .56rem; color: var(--muted); letter-spacing: .08em; margin-top: 4px; }

/* Progress list (subjects) */
.prog { display: flex; flex-direction: column; gap: 16px; }
.prog-row {}
.prog-top { display: flex; justify-content: space-between; font-size: .76rem; margin-bottom: 7px; }
.prog-name { color: var(--ink-2); font-weight: 500; }
.prog-pct { font-family: var(--fs-mono); color: var(--muted); }
.prog-track { height: 6px; border-radius: 99px; background: var(--line); overflow: hidden; }
.prog-fill { height: 100%; width: 0; border-radius: 99px; transition: width 1.1s var(--ease); }

/* Line chart (trend) */
.linechart { width: 100%; height: 120px; }
.linechart .area { opacity: .12; }
.linechart .ln { fill: none; stroke-width: 2; stroke-linejoin: round; stroke-linecap: round; stroke-dasharray: 600; stroke-dashoffset: 600; }
.linechart.in .ln { transition: stroke-dashoffset 1.6s var(--ease); stroke-dashoffset: 0; }

@@media (max-width: 920px) {
    .console-body { grid-template-columns: 1fr 1fr; }
    .panel.big { grid-column: 1 / 3; grid-row: auto; }
}
@@media (max-width: 600px) { .console-body { grid-template-columns: 1fr; } .panel.big { grid-column: 1; } }

/* ═══════════════════════════════════════════════════════════════════
   ARCHITECTURE PIPELINE
═══════════════════════════════════════════════════════════════════ */
.pipeline { padding: 0 0 110px; }
.pipe-head { text-align: center; margin-bottom: 56px; display: flex; flex-direction: column; align-items: center; gap: 16px; }
.pipe-flow {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 0;
    position: relative;
}
.pipe-node {
    border: 1px dashed var(--dash); border-radius: 12px; padding: 28px 24px;
    background: var(--paper); margin: 0 14px; position: relative; z-index: 1;
    transition: transform .3s var(--ease), border-color .3s, box-shadow .3s;
}
.pipe-node:hover { transform: translateY(-4px); border-color: var(--cyber); border-style: solid; box-shadow: 0 16px 36px rgba(23,99,255,.12); }
.pipe-node::after {
    content: ''; position: absolute; top: 50%; right: -28px; width: 28px; height: 1px;
    background: repeating-linear-gradient(90deg, var(--line-2) 0 4px, transparent 4px 8px);
    z-index: 0;
}
.pipe-node:last-child::after { display: none; }
.pipe-step { font-family: var(--fs-mono); font-size: .58rem; color: var(--cyber); letter-spacing: .12em; margin-bottom: 14px; }
.pipe-ico { width: 36px; height: 36px; color: var(--ink); margin-bottom: 16px; }
.pipe-ico svg { width: 100%; height: 100%; }
.pipe-title { font-family: var(--fs-disp); font-weight: 600; font-size: 1.05rem; color: var(--ink); margin-bottom: 8px; }
.pipe-desc { font-size: .8rem; color: var(--muted); line-height: 1.6; }

@@media (max-width: 860px) {
    .pipe-flow { grid-template-columns: 1fr 1fr; gap: 24px; }
    .pipe-node { margin: 0; }
    .pipe-node::after { display: none; }
}
@@media (max-width: 480px) { .pipe-flow { grid-template-columns: 1fr; } }

/* ═══════════════════════════════════════════════════════════════════
   CTA TERMINAL
═══════════════════════════════════════════════════════════════════ */
.cta { padding: 0 0 100px; }
.cta-box {
    position: relative; overflow: hidden;
    border-radius: 18px; padding: 72px 56px;
    background: linear-gradient(135deg, #0d1626 0%, #131f36 60%, #1a2748 100%);
    color: #fff;
}
.cta-box::before {
    content: ''; position: absolute; inset: 0;
    background-image:
        linear-gradient(to right,  rgba(255,255,255,.05) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(255,255,255,.05) 1px, transparent 1px);
    background-size: 40px 40px;
    mask-image: radial-gradient(ellipse 80% 100% at 80% 0%, #000, transparent 70%);
    -webkit-mask-image: radial-gradient(ellipse 80% 100% at 80% 0%, #000, transparent 70%);
}
.cta-glow {
    position: absolute; width: 420px; height: 420px; border-radius: 50%;
    background: radial-gradient(circle, rgba(23,99,255,.4), transparent 70%);
    right: -80px; top: -120px; filter: blur(20px); pointer-events: none;
}
.cta-glow.p { background: radial-gradient(circle, rgba(123,63,228,.35), transparent 70%); right: 120px; top: 60px; width: 300px; height: 300px; }
.cta-inner { position: relative; z-index: 1; max-width: 640px; }
.cta-tag { font-family: var(--fs-mono); font-size: .64rem; letter-spacing: .2em; text-transform: uppercase; color: var(--cyber-2); display: inline-flex; align-items: center; gap: 8px; margin-bottom: 24px; }
.cta-tag::before { content: ''; width: 18px; height: 1px; background: var(--cyber-2); }
.cta-title { font-family: var(--fs-disp); font-weight: 700; font-size: clamp(2rem, 4vw, 3.2rem); line-height: 1.06; letter-spacing: -.02em; margin-bottom: 22px; }
.cta-title em { font-style: normal; color: var(--green-2); }
.cta-desc { font-size: 1rem; line-height: 1.7; color: rgba(255,255,255,.65); margin-bottom: 36px; max-width: 52ch; }
.cta-actions { display: flex; gap: 14px; flex-wrap: wrap; align-items: center; }
.cta-actions .btn-primary { background: #fff; color: var(--ink); }
.cta-actions .btn-primary:hover { background: var(--cyber); color: #fff; }
.cta-actions .btn-ghost { background: transparent; border-color: rgba(255,255,255,.25); color: #fff; }
.cta-actions .btn-ghost:hover { border-color: var(--green); color: var(--green-2); }
.cta-note { margin-top: 26px; font-family: var(--fs-mono); font-size: .64rem; color: rgba(255,255,255,.4); letter-spacing: .04em; }

@@media (max-width: 600px) { .cta-box { padding: 48px 28px; } }

/* ═══════════════════════════════════════════════════════════════════
   FOOTER
═══════════════════════════════════════════════════════════════════ */
.footer { border-top: 1px solid var(--line); padding: 48px 0 36px; }
.footer-grid { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 40px; padding-bottom: 36px; border-bottom: 1px dashed var(--dash); }
.footer-brand { font-family: var(--fs-disp); font-weight: 600; font-size: 1.1rem; color: var(--ink); margin-bottom: 14px; }
.footer-desc { font-size: .82rem; color: var(--muted); line-height: 1.7; max-width: 30ch; }
.footer-col h4 { font-family: var(--fs-mono); font-size: .58rem; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); margin-bottom: 16px; }
.footer-col a { display: block; font-size: .84rem; color: var(--ink-2); margin-bottom: 10px; transition: color .18s; }
.footer-col a:hover { color: var(--cyber); }
.footer-bottom { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; padding-top: 26px; }
.footer-copy { font-family: var(--fs-mono); font-size: .62rem; color: var(--muted); letter-spacing: .04em; }
.footer-meta { font-family: var(--fs-mono); font-size: .62rem; color: var(--muted); display: flex; gap: 18px; }
.footer-meta span { display: inline-flex; align-items: center; gap: 6px; }

@@media (max-width: 760px) { .footer-grid { grid-template-columns: 1fr 1fr; } }
@@media (max-width: 460px) { .footer-grid { grid-template-columns: 1fr; } .footer-bottom { flex-direction: column; align-items: flex-start; } }

/* Reveal utility */
.reveal { opacity: 0; transform: translateY(22px); transition: opacity .8s var(--ease), transform .8s var(--ease); }
.reveal.in { opacity: 1; transform: none; }
.reveal.d1 { transition-delay: .08s; } .reveal.d2 { transition-delay: .16s; } .reveal.d3 { transition-delay: .24s; }

@@media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { animation-duration: .01ms !important; transition-duration: .01ms !important; animation-iteration-count: 1 !important; }
    .hero-line > span { transform: none; } .hero-eyebrow,.hero-desc,.hero-actions,.hero-mini,.viewport { opacity: 1 !important; transform: none !important; }
}
</style>
</head>
