@model LuminaTutors.Application.DTOs.HR.CreateTeacherRequest
@{
    ViewData["Title"] = "Thêm giáo viên mới";
    var schoolDomain  = LuminaTutors.Application.Common.RoleEmail.BaseDomain(User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "");
    var teacherPrefix = LuminaTutors.Application.Common.RoleEmail.PrefixFor("TEACHER") ?? "tea";
    var emailSuffix   = $"@{teacherPrefix}.{schoolDomain}";
}

<div class="lt-page-header">
    <div>
        <h1 class="lt-page-title">Thêm giáo viên mới</h1>
        <p class="lt-page-subtitle">Tạo tài khoản và hồ sơ giáo viên</p>
    </div>
    <a asp-action="Teachers" class="lt-btn lt-btn--outline">
        <i class="bi bi-arrow-left"></i> Quay lại
    </a>
</div>

<div class="lt-card" style="max-width:720px">
    <div class="lt-card__body">
        <form asp-action="CreateTeacher" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="FullName" class="form-label">Họ và tên <span class="text-danger">*</span></label>
                    <input asp-for="FullName" class="form-control" placeholder="Nguyễn Văn A" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="TeacherCode" class="form-label">Mã giáo viên <span class="text-danger">*</span></label>
                    <input asp-for="TeacherCode" class="form-control" placeholder="GV001" />
                    <span asp-validation-for="TeacherCode" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Tên đăng nhập <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <input type="text" id="emailLocal" class="form-control" placeholder="vd: covan" autocomplete="off" spellcheck="false" required
                               value="@(Model?.Email != null && Model.Email.Contains('@') ? Model.Email.Split('@')[0] : Model?.Email)"
                               oninput="syncEmail()"/>
                        <span class="input-group-text text-muted">@emailSuffix</span>
                    </div>
                    <input type="hidden" asp-for="Email" id="emailFull"/>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="PhoneNumber" class="form-label">Điện thoại</label>
                    <input asp-for="PhoneNumber" class="form-control" placeholder="0912 345 678" />
                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="DateOfBirth" class="form-label">Ngày sinh</label>
                    <input asp-for="DateOfBirth" class="form-control" type="date" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Gender" class="form-label">Giới tính</label>
                    <select asp-for="Gender" class="form-select">
                        <option value="">-- Chọn --</option>
                        <option value="Male">Nam</option>
                        <option value="Female">Nữ</option>
                        <option value="Other">Khác</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label asp-for="Qualification" class="form-label">Trình độ học vấn</label>
                    <input asp-for="Qualification" class="form-control" placeholder="Thạc sĩ, Cử nhân..." />
                </div>
                <div class="col-md-6">
                    <label asp-for="SpecializationSubject" class="form-label">Chuyên môn</label>
                    <input asp-for="SpecializationSubject" class="form-control" placeholder="Toán, Vật lý..." />
                </div>
                <div class="col-md-6">
                    <label asp-for="HireDate" class="form-label">Ngày vào làm</label>
                    <input asp-for="HireDate" class="form-control" type="date" />
                </div>
                <div class="col-md-6">
                    <label asp-for="ContractType" class="form-label">Loại hợp đồng</label>
                    <select asp-for="ContractType" class="form-select">
                        <option value="FullTime">Toàn thời gian</option>
                        <option value="PartTime">Bán thời gian</option>
                        <option value="Probation">Thử việc</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label asp-for="BankName" class="form-label">Ngân hàng</label>
                    <input asp-for="BankName" class="form-control" placeholder="Vietcombank, BIDV..." />
                </div>
                <div class="col-md-6">
                    <label asp-for="BankAccountNumber" class="form-label">Số tài khoản</label>
                    <input asp-for="BankAccountNumber" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="TaxCode" class="form-label">Mã số thuế</label>
                    <input asp-for="TaxCode" class="form-control" />
                </div>
            </div>

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="lt-btn lt-btn--primary">
                    <i class="bi bi-person-plus-fill"></i> Tạo giáo viên
                </button>
                <a asp-action="Teachers" class="lt-btn lt-btn--outline">Hủy</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
    const EMAIL_SUFFIX = '@emailSuffix';
    function syncEmail() {
        const local = (document.getElementById('emailLocal').value || '').trim().toLowerCase().replace(/\s+/g, '');
        document.getElementById('emailFull').value = local ? (local + EMAIL_SUFFIX) : '';
    }
    document.addEventListener('DOMContentLoaded', syncEmail);
    </script>
}
