@model LuminaTutors.Application.DTOs.HR.TeacherDetailDto
@using LuminaTutors.Domain.Enums
@{
    ViewData["Title"] = Model?.FullName ?? "Chi tiết giáo viên";
}

<div class="lt-page-header">
    <div>
        <h1 class="lt-page-title">@Model?.FullName</h1>
        <p class="lt-page-subtitle">Mã giáo viên: <strong>@Model?.TeacherCode</strong></p>
    </div>
    <div class="d-flex gap-2">
        @if (Model != null)
        {
            <a asp-action="EditTeacher" asp-route-id="@Model.ProfileId" class="lt-btn lt-btn--primary">
                <i class="bi bi-pencil"></i> Sửa
            </a>
        }
        <a asp-action="Teachers" class="lt-btn lt-btn--outline">
            <i class="bi bi-arrow-left"></i> Danh sách giáo viên
        </a>
    </div>
</div>

@* Thông báo Success/Error được render tập trung ở _Layout (tránh trùng 2 lần). *@

@if (Model == null)
{
    <div class="lt-empty-state">
        <i class="bi bi-person-x lt-empty-state__icon"></i>
        <p class="lt-empty-state__text">Không tìm thấy giáo viên.</p>
    </div>
}
else
{
    <div class="row g-4">
        <div class="col-lg-4">
            <div class="lt-card">
                <div class="lt-card__body text-center">
                    @if (!string.IsNullOrEmpty(Model.AvatarUrl))
                    {
                        <img src="@Model.AvatarUrl" class="rounded-circle mb-3"
                             width="96" height="96" style="object-fit:cover" alt="" />
                    }
                    else
                    {
                        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center mx-auto mb-3"
                             style="width:96px;height:96px;font-size:2rem;font-weight:700">
                            @(Model.FullName.Length > 0 ? Model.FullName[0].ToString().ToUpper() : "?")
                        </div>
                    }
                    <h5 class="mb-1 fw-bold">@Model.FullName</h5>
                    <p class="text-muted mb-2">@(Model.SpecializationSubject ?? "Giáo viên")</p>
                    @if (Model.IsActive)
                    {
                        <span class="lt-badge lt-badge--success">Đang dạy</span>
                    }
                    else
                    {
                        <span class="lt-badge lt-badge--danger">Đã nghỉ</span>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="lt-card mb-3">
                <div class="lt-card__header"><h6 class="lt-card__title">Thông tin cá nhân</h6></div>
                <div class="lt-card__body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Email</dt>
                        <dd class="col-sm-8">@Model.Email</dd>
                        <dt class="col-sm-4">Điện thoại</dt>
                        <dd class="col-sm-8">@(Model.PhoneNumber ?? "—")</dd>
                        <dt class="col-sm-4">Ngày sinh</dt>
                        <dd class="col-sm-8">@(Model.DateOfBirth?.ToString("dd/MM/yyyy") ?? "—")</dd>
                        <dt class="col-sm-4">Giới tính</dt>
                        <dd class="col-sm-8">@(Model.Gender ?? "—")</dd>
                        <dt class="col-sm-4">Trình độ</dt>
                        <dd class="col-sm-8">@(Model.Qualification ?? "—")</dd>
                        <dt class="col-sm-4">Chuyên môn</dt>
                        <dd class="col-sm-8">@(Model.SpecializationSubject ?? "—")</dd>
                        <dt class="col-sm-4">Ngày vào làm</dt>
                        <dd class="col-sm-8">@(Model.HireDate?.ToString("dd/MM/yyyy") ?? "—")</dd>
                        <dt class="col-sm-4">Loại hợp đồng</dt>
                        <dd class="col-sm-8">@(Model.ContractType ?? "—")</dd>
                        <dt class="col-sm-4">Ngân hàng</dt>
                        <dd class="col-sm-8">@(Model.BankName ?? "—")</dd>
                    </dl>
                </div>
            </div>

            <div class="lt-card">
                <div class="lt-card__header">
                    <h6 class="lt-card__title">Tạo hợp đồng mới</h6>
                </div>
                <div class="lt-card__body">
                    <form asp-action="CreateContract" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="TeacherId" value="@Model.ProfileId" />
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Mã hợp đồng <span class="text-danger">*</span></label>
                                <input name="ContractCode" class="form-control" required placeholder="HD-2024-001" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Loại hợp đồng <span class="text-danger">*</span></label>
                                <select name="ContractType" class="form-select" required>
                                    <option value="FullTime">Toàn thời gian</option>
                                    <option value="PartTime">Bán thời gian</option>
                                    <option value="Probation">Thử việc</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Ngày bắt đầu <span class="text-danger">*</span></label>
                                <input name="StartDate" type="date" class="form-control" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Ngày kết thúc</label>
                                <input name="EndDate" type="date" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Lương cơ bản (VNĐ) <span class="text-danger">*</span></label>
                                <input name="BaseSalary" type="number" class="form-control" required
                                       min="1000000" max="100000000" placeholder="8000000" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Ngày ký hợp đồng</label>
                                <input name="SignedAt" type="date" class="form-control" />
                            </div>
                        </div>
                        <div class="mt-3">
                            <button type="submit" class="lt-btn lt-btn--primary">
                                <i class="bi bi-file-earmark-check"></i> Tạo hợp đồng
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
}
